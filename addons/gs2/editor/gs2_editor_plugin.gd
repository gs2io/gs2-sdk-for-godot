# Handwritten editor entry point. This file is intentionally not generated by SDK-GEN.
#
# Enable it under Project Settings > Plugins. It only registers the editor tools; runtime
# scripts never reference it, so exported games do not include it. Each tool keeps its logic
# in a plain script (testable headless) and is added and removed here.
@tool
extends EditorPlugin


## The tool menu every GS2 command goes under (Project > Tools > GS2).
const TOOL_MENU_NAME = "GS2"

const SchemaImportPlugin = preload("res://addons/gs2/realtime/editor/gs2_realtime_schema_import_plugin.gd")
const InspectorPlugin = preload("res://addons/gs2/realtime/editor/gs2_realtime_inspector_plugin.gd")

var _tool_menu: PopupMenu = null
var _commands: Array[Callable] = []
var _schema_import: EditorImportPlugin = null
var _inspector: EditorInspectorPlugin = null
var _build_thread: Thread = null


func _enter_tree() -> void:
    _tool_menu = PopupMenu.new()
    _tool_menu.id_pressed.connect(_on_tool_menu_id_pressed)
    add_tool_submenu_item(TOOL_MENU_NAME, _tool_menu)
    # Realtime: room schemas, the object catalog, RPC IDs.
    _schema_import = SchemaImportPlugin.new()
    add_import_plugin(_schema_import)
    _inspector = InspectorPlugin.new()
    add_inspector_plugin(_inspector)
    add_command("Copy Object Catalog JSON (selected Gs2NetworkPrefabCatalog)", _copy_object_catalog)
    add_command("Build Realtime Rules", _build_rules)
    _add_settings()


func _exit_tree() -> void:
    if _build_thread != null:
        _build_thread.wait_to_finish()
        _build_thread = null
    if _schema_import != null:
        remove_import_plugin(_schema_import)
        _schema_import = null
    if _inspector != null:
        remove_inspector_plugin(_inspector)
        _inspector = null
    if _tool_menu != null:
        remove_tool_menu_item(TOOL_MENU_NAME)
        _tool_menu = null
    _commands.clear()


## Adds a command to Project > Tools > GS2. Tools call this from their own registration.
func add_command(label: String, command: Callable) -> void:
    _commands.append(command)
    _tool_menu.add_item(label, _commands.size() - 1)


func _on_tool_menu_id_pressed(id: int) -> void:
    if id >= 0 and id < _commands.size():
        _commands[id].call()


# The selected prefab catalog's player objects for the namespace's syncSetting.objectCatalog,
# copied to the clipboard.
func _copy_object_catalog() -> void:
    var catalog := EditorInterface.get_inspector().get_edited_object() as Gs2NetworkPrefabCatalog
    if catalog == null:
        push_warning("Select a Gs2NetworkPrefabCatalog in the inspector first")
        return
    var json := Gs2ObjectCatalogExport.to_json(catalog)
    if json == "":
        push_error("Object catalog: " + Gs2ObjectCatalogExport.last_error)
        return
    DisplayServer.clipboard_set(json)
    print("Copied the object catalog for the namespace's syncSetting.objectCatalog:\n" + json)


# The compiler's path (an editor setting: it is per machine), the one rule set's directories
# and the list of rule sets (project settings).
func _add_settings() -> void:
    var editor := EditorInterface.get_editor_settings()
    if not editor.has_setting(Gs2RealtimeRulesBuild.COMPILER_SETTING):
        editor.set_setting(Gs2RealtimeRulesBuild.COMPILER_SETTING, "")
    editor.set_initial_value(Gs2RealtimeRulesBuild.COMPILER_SETTING, "", false)
    editor.add_property_info({name = Gs2RealtimeRulesBuild.COMPILER_SETTING, type = TYPE_STRING, hint = PROPERTY_HINT_GLOBAL_FILE})
    for setting in [
        [Gs2RealtimeRulesBuild.RULES_SETTING, Gs2RealtimeRulesBuild.DEFAULT_RULES, TYPE_STRING, PROPERTY_HINT_DIR, ""],
        [Gs2RealtimeRulesBuild.GENERATED_SETTING, Gs2RealtimeRulesBuild.DEFAULT_GENERATED, TYPE_STRING, PROPERTY_HINT_DIR, ""],
        [Gs2RealtimeRulesBuild.PACKAGE_SETTING, Gs2RealtimeRulesBuild.DEFAULT_PACKAGE, TYPE_STRING, PROPERTY_HINT_NONE, ""],
        [Gs2RealtimeRulesBuild.RULE_SETS_SETTING, [], TYPE_ARRAY, PROPERTY_HINT_TYPE_STRING, "%d:" % TYPE_DICTIONARY],
    ]:
        if not ProjectSettings.has_setting(setting[0]):
            ProjectSettings.set_setting(setting[0], setting[1])
        ProjectSettings.set_initial_value(setting[0], setting[1])
        ProjectSettings.add_property_info({name = setting[0], type = setting[2], hint = setting[3], hint_string = setting[4]})


# Builds the rule sets on a thread (the compiler takes a moment; the editor stays responsive).
func _build_rules() -> void:
    if _build_thread != null:
        push_warning("GS2: a realtime rules build is already running")
        return
    var compiler: String = EditorInterface.get_editor_settings().get_setting(Gs2RealtimeRulesBuild.COMPILER_SETTING)
    var sets := Gs2RealtimeRulesBuild.rule_sets()
    var known := ProjectSettings.get_global_class_list()
    print("GS2: building %d realtime rule set(s) ..." % sets.size())
    _build_thread = Thread.new()
    _build_thread.start(func() -> void:
        var result := Gs2RealtimeRulesBuild.build(compiler, sets, known)
        _built.call_deferred(result))


func _built(result: Gs2RealtimeRulesBuild.Result) -> void:
    _build_thread.wait_to_finish()
    _build_thread = null
    for error in result.errors:
        push_error("GS2 realtime rules: " + error)
    for file in result.written:
        print("GS2: wrote " + file)
    for file in result.removed:
        print("GS2: removed " + file)
    for package in result.packages:
        print("GS2: realtime rules built; register %s with GS2-StateMachine" % package)
    if result.written.is_empty() and result.removed.is_empty():
        return
    EditorInterface.get_resource_filesystem().scan()
