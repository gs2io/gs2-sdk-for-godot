func namespaces(
    name_prefix = null
) -> Gs2AccountDescribeNamespacesIterator:
    return Gs2AccountDescribeNamespacesIterator.new(
        _gs2,
        _client,
        name_prefix
    )


func subscribe_namespaces(
    callback: Callable,
    name_prefix = null
) -> int:
    return _gs2.cache.list_subscribe(
        "Gs2AccountNamespace",
        Gs2AccountNamespaceCache.cache_parent_key(
            null
        ),
        callback
    )


func unsubscribe_namespaces(
    callback_id: int,
    name_prefix = null
) -> void:
    _gs2.cache.list_unsubscribe(
        "Gs2AccountNamespace",
        Gs2AccountNamespaceCache.cache_parent_key(
            null
        ),
        callback_id
    )


func invalidate_namespaces(
    name_prefix = null
) -> void:
    _gs2.cache.clear_list_cache(
        "Gs2AccountNamespace",
        Gs2AccountNamespaceCache.cache_parent_key(
            null
        )
    )
func namespace_(
    namespace_name
) -> Gs2AccountNamespaceDomain:
    return Gs2AccountNamespaceDomain.new(
        _gs2,
        namespace_name
    )


