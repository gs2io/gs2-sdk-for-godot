class_name Gs2Auth
extends RefCounted



var _gs2: Gs2DomainCore
var _client: Gs2AuthRestClient


func _init(
    gs2: Gs2DomainCore
):
    _gs2 = gs2
    _client = Gs2AuthRestClient.new(gs2.rest_session)
func access_token(
) -> Gs2AuthAccessTokenDomain:
    return Gs2AuthAccessTokenDomain.new(
