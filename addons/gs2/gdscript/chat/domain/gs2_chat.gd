func handle_notification(
    action: String,
    payload
) -> void:
    var data = JSON.parse_string(payload) if payload is String else payload
    if action == "Post":
        var notification: Gs2ChatPostNotification = Gs2ChatPostNotification.from_dict(data)
        if notification == null:
            return
        var n = notification
        _gs2.cache.require_list_cache_update(
            "Gs2ChatMessage",
            Gs2ChatMessageCache.cache_parent_key(
                n.namespace_name,
                "Singleton",
                n.room_name,
                null
            )
        )
        post_notification.emit(notification)
        return
    pass