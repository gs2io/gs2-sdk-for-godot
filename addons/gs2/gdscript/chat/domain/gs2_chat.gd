class_name Gs2Chat
extends RefCounted

signal post_notification(
    notification: Gs2ChatPostNotification
)



var _gs2: Gs2DomainCore
var _client: Gs2ChatRestClient
var url: Variant = null
var upload_token: Variant = null
var upload_url: Variant = null


func _init(
    gs2: Gs2DomainCore
):
    _gs2 = gs2
    _client = Gs2ChatRestClient.new(gs2.rest_session)


func create_namespace(
    request: Gs2ChatCreateNamespaceRequest
) -> Gs2AsyncResult:
    var async_result = await Gs2ChatCreateNamespaceMethodCache.invoke(
        _gs2.cache,
        null,
        null,
        request,
        func(): return await _client.create_namespace(request)
    )
    if async_result.error != null:
        return async_result
    var result = async_result.result
    var ref = null if result == null else result.item
    var domain = Gs2ChatNamespaceDomain.new(
        _gs2,
        (null if ref == null else ref.name)
    )
    return Gs2AsyncResult.new(domain, null)


