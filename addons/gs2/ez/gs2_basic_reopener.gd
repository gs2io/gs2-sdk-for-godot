# Handwritten connection utility corresponding to Unity Gs2BasicReopener.
# This file is intentionally not generated by SDK-GEN.
class_name Gs2BasicReopener
extends RefCounted


signal reopened


func reopen(web_socket_session, rest_session) -> Gs2AsyncResult:
    var web_socket_result = await web_socket_session.open()
    if web_socket_result.error != null:
        return web_socket_result
    var rest_result = await rest_session.open()
    if rest_result.error != null:
        return rest_result
    reopened.emit()
    return rest_result


func reopen_with_callback(web_socket_session, rest_session, callback: Callable) -> void:
    callback.call(await reopen(web_socket_session, rest_session))
