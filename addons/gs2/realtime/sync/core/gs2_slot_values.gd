# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Values of up to 32 slots (object fields or input slots, 0..31) and which slots are set, for
# Gs2SyncClient.spawn and send_input (Unity's SlotValues). Reuse one instance to avoid
# allocating per call. A slot outside 0..31 is a programmer error: the call changes nothing,
# reports it with push_error and records it in last_error (Unity throws
# ArgumentOutOfRangeException).
class_name Gs2SlotValues
extends RefCounted


const _SLOT_ERROR = "Slots are 0..31"

## Bit mask of the slots that are set (read it; change it with the methods).
var mask := 0
## Why the last call failed, or "".
var last_error := ""

var _values := PackedInt32Array()


func _init() -> void:
    _values.resize(32)


## The slot's value (0 when not set, or for a slot outside 0..31).
func get_slot(slot: int) -> int:
    if not _slot(slot):
        return 0
    return _values[slot]


## Whether the slot is set.
func has(slot: int) -> bool:
    if not _slot(slot):
        return false
    return (mask & (1 << slot)) != 0


## Sets a slot (an int32 value); returns this instance for chaining.
func set_slot(slot: int, value: int) -> Gs2SlotValues:
    if _slot(slot):
        _values[slot] = value
        mask |= 1 << slot
    return self


## Unsets a slot; returns this instance for chaining.
func remove(slot: int) -> Gs2SlotValues:
    if _slot(slot):
        mask &= ~(1 << slot)
        _values[slot] = 0
    return self


## Unsets every slot; returns this instance for chaining.
func clear() -> Gs2SlotValues:
    mask = 0
    _values.fill(0)
    return self


## Makes this instance a copy of other.
func copy_from(other: Gs2SlotValues) -> void:
    mask = other.mask
    _values = other._values.duplicate() # packed arrays assigned in GDScript share storage


## The 32 values (a copy).
func to_array() -> PackedInt32Array:
    return _values.duplicate()


## Writes mask and values into the record (for the client's spawn and input records).
func copy_to_record(r: Gs2SyncRecord) -> void:
    r.mask = mask
    r.values = _values.duplicate() # packed arrays assigned in GDScript share storage


func _slot(slot: int) -> bool:
    last_error = ""
    if slot >= 0 and slot < 32:
        return true
    last_error = _SLOT_ERROR
    push_error(_SLOT_ERROR)
    return false
