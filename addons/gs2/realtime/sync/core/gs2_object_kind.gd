# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# What an object mode allows (Unity's ObjectKind); test these instead of naming modes. An
# object's holder is its owner_id: the member owning a player or simulated object, or holding a
# leased one's lease. Mirrors the room's table (kind.go): keep the two in step.
class_name Gs2ObjectKind
extends RefCounted


## A member owns it for its life (RPC target, ownership transfer).
var owned := false
## Its owner can hand it to another member (transfer, takeover, keepOnLeave).
var transferable := false
## Members borrow it for a time (acquire / renew / release).
var leased := false
## The holder sends its field values.
var holder_writes := false
## The holder may despawn it; the room rules despawn the other kinds.
var holder_despawns := false
## Members call the room rules' Interact on it.
var interactive := false
## The room rules move it from its owner's inputs (ticking rooms; predicted).
var simulated := false

# One shared instance per mode: of() allocates nothing. Treat them as read-only.
static var _kinds: Array[Gs2ObjectKind] = []


## It has a holder (owned or leased): authority messages describe it.
func has_holder() -> bool:
    return owned or leased


## The properties of a mode (Gs2SyncTypes.ObjectMode); null for a value outside the enum.
static func of(mode: int) -> Gs2ObjectKind:
    if _kinds.is_empty():
        _kinds = [
            _make(true, true, false, true, true, false, false),    # PLAYER
            _make(false, false, true, true, false, false, false),  # LEASE
            _make(false, false, false, false, false, true, false), # SERVER
            _make(true, false, false, false, false, false, true),  # SIMULATED
        ]
    if mode < 0 or mode >= _kinds.size():
        return null
    return _kinds[mode]


static func _make(is_owned: bool, is_transferable: bool, is_leased: bool, writes: bool, despawns: bool, is_interactive: bool, is_simulated: bool) -> Gs2ObjectKind:
    var kind := Gs2ObjectKind.new()
    kind.owned = is_owned
    kind.transferable = is_transferable
    kind.leased = is_leased
    kind.holder_writes = writes
    kind.holder_despawns = despawns
    kind.interactive = is_interactive
    kind.simulated = is_simulated
    return kind
