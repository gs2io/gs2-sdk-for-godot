# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# A room object as this client sees it (Unity's NetworkObject). Read-only for the game: the
# client (Gs2SyncClient) updates it from the room's messages. Members documented as "for the
# client" or "for the world" are Unity's internal members: Gs2SyncClient and Gs2NetworkWorld
# call them, games do not.
#
# The 32 field values are int32; read them with value / shown_value, or as copies with
# get_values / get_shown_values (packed arrays assigned in GDScript share storage, so the
# object never hands out its own arrays).
class_name Gs2NetworkObject
extends RefCounted


## Raised when the holder or the authority period (epoch) changes.
signal authority_changed
## The result of this client's lease request or interaction on the object (request ID, result).
signal command_completed(request: int, result: int)
## Raised when a room update changes field values; the argument is their bit mask.
signal changed(mask: int)
## Raised every frame while predicted, after the prediction ran; the argument is the progress
## (0..1) from the previous predicted tick to the newest one.
signal predicted(alpha: float)
## Raised after a correction of the prediction; the argument is the bit mask of the fields whose
## prediction error is nonzero.
signal prediction_corrected(mask: int)

const _READ_ONLY = "Gs2NetworkObject is read-only: the sync client updates it"
const _FIELD_ERROR = "Fields are 0..31"

## The room's object ID.
var id: int:
    get: return _id
    set(_v): push_error(_READ_ONLY)
## The prefab the object was spawned from.
var prefab: int:
    get: return _prefab
    set(_v): push_error(_READ_ONLY)
## The holder's connection ID: owner of a player or simulated object (changes with ownership
## transfers), or the member holding a leased object's lease (0 while free). Unity's Owner.
var owner_id: int:
    get: return _owner_id
    set(_v): push_error(_READ_ONLY)
## This client's spawn request that created it (0 for other objects).
var request: int:
    get: return _request
    set(_v): push_error(_READ_ONLY)
## Bit mask of the fields (0..31) the object's schema has.
var fields: int:
    get: return _fields
    set(_v): push_error(_READ_ONLY)
## How the object is synchronized (Gs2SyncTypes.ObjectMode).
var mode: int:
    get: return _mode
    set(_v): push_error(_READ_ONLY)
## Interest group (0 reaches everyone); updates and calls go to its subscribers.
var group: int:
    get: return _group
    set(_v): push_error(_READ_ONLY)
## The current authority period, as the room numbers it (see authority_changed).
var epoch: int:
    get: return _epoch
    set(_v): push_error(_READ_ONLY)
## Remaining server lease time at the last notification; not a client clock.
var lease_milliseconds: int:
    get: return _lease_milliseconds
    set(_v): push_error(_READ_ONLY)

## True while this client predicts the object: a simulated object it owns whose prefab has a
## registered prediction. Values stay the room's latest state. Set by the world.
var is_predicted := false
## The prediction despawned this object (Room.despawn in a @predict method); the world hides it
## until the room agrees or the prediction changes. Set by the world.
var predicted_removed := false
## Why the last call failed (a field outside 0..31), or "".
var last_error := ""

# This client's connection ID: the object answers what this client may do with it.
var _me := 0
var _id := 0
var _prefab := 0
var _owner_id := 0
var _request := 0
var _fields := 0
var _mode := 0
var _group := 0
var _epoch := 0
var _lease_milliseconds := 0

# ---- Room state ----
var _values := PackedInt32Array()
# Updates travel over UDP and WebSocket, so one may arrive after a newer one. Per field: the
# newest state version received (_received_mask: fields that got one), which rejects older
# updates; the version from which the current value holds (_versioned_mask), which places it
# before or after a clock; and the value it replaced (_prior_mask), so a clock that a newer
# update overtook finds its value.
var _received := PackedInt64Array()
var _versions := PackedInt64Array()
var _prior_values := PackedInt32Array()
var _prior_versions := PackedInt64Array()
var _received_mask := 0
var _versioned_mask := 0
var _prior_mask := 0
var _prior_versioned_mask := 0

# ---- This client's writes (owner or lease holder) ----
var _pending := Gs2SyncRecord.new() # staged writes (mask) over the last sent values
var _sent := PackedInt32Array()
var _recent := 0 # fields sent over the unreliable channel since the last refresh
var _written := 0 # fields this client wrote in the current authority period

# ---- Prediction ----
var _predicted := PackedInt32Array()
var _previous_predicted := PackedInt32Array()
var _prediction_error := PackedInt32Array()
var _prediction_error_mask := 0


func _init(me: int = 0) -> void:
    _me = me
    _values.resize(32)
    _prior_values.resize(32)
    _sent.resize(32)
    _predicted.resize(32)
    _previous_predicted.resize(32)
    _prediction_error.resize(32)
    _received.resize(32)
    _versions.resize(32)
    _prior_versions.resize(32)


## For the client: the room's spawn of an object, as received by the client me.
static func spawned(r: Gs2SyncRecord, me: int) -> Gs2NetworkObject:
    var o := Gs2NetworkObject.new(me)
    o._id = r.id
    o._prefab = r.prefab
    o._mode = r.mode
    o._fields = r.mask
    o._owner_id = r.owner
    o._epoch = r.epoch
    o._lease_milliseconds = r.ttl
    # Request IDs are numbered per member: another member's (it also starts at 1) would look
    # like ours, so only our own are kept.
    o._request = r.request if o.is_mine() else 0
    o._initialize(r)
    return o


## What the object's mode allows.
func kind() -> Gs2ObjectKind:
    return Gs2ObjectKind.of(_mode)


## Somebody holds it (an owner, or a lease holder).
func has_holder() -> bool:
    return _owner_id != 0


## This client holds it: owns a player or simulated object, or holds the lease.
func is_mine() -> bool:
    return _me != 0 and _owner_id == _me


## A player or simulated object this client owns.
func owned_by_me() -> bool:
    return kind().owned and is_mine()


## A simulated object this client owns (drives with inputs; predicts).
func simulated_for_me() -> bool:
    return kind().simulated and is_mine()


## A leased object whose lease this client holds.
func lease_held_by_me() -> bool:
    return kind().leased and is_mine()


## This client sends its field values (it holds a kind the holder writes).
func writable_by_me() -> bool:
    return kind().holder_writes and is_mine()


## This client may despawn it (it owns a kind the holder despawns).
func despawnable_by_me() -> bool:
    return kind().holder_despawns and is_mine()


## The room confirms one of this client's own spawn requests with it (not a predicted spawn,
## whose request is the prediction's key).
func confirms_my_spawn() -> bool:
    return _request != 0 and not has_predicted_spawn_key()


## The room spawned it in a simulation step, with the key a prediction uses for the same spawn
## (request has the high bit).
func has_predicted_spawn_key() -> bool:
    return is_predicted_spawn_key(_request)


static func is_predicted_spawn_key(spawn_request: int) -> bool:
    return (spawn_request & (1 << 31)) != 0


## The schema has field (0..31); false for any other index.
func has_field(field: int) -> bool:
    return field >= 0 and field < 32 and (_fields & (1 << field)) != 0


## For the client: the mask names a field the schema does not have.
func has_unknown_fields(field_mask: int) -> bool:
    return (field_mask & ~_fields) != 0


## For the client.
func move_to_group(new_group: int) -> void:
    _group = new_group


## For the client: applies the room's authority state (holder, period, remaining lease). A new
## holder or period discards pending writes: the holder continues from the replicated state (a
## lease renewal keeps them). Returns whether holder or period changed.
func apply_authority(r: Gs2SyncRecord) -> bool:
    var holder_changed = _owner_id != r.owner or _epoch != r.epoch
    _owner_id = r.owner
    _epoch = r.epoch
    _lease_milliseconds = r.ttl
    if holder_changed:
        _reset_writes()
    return holder_changed


## For the client.
func notify_authority() -> void:
    authority_changed.emit()


## For the client.
func notify_command(command_request: int, result: int) -> void:
    command_completed.emit(command_request, result)


# ---- Room state ----

## The room's latest state of the field (0..31; 0 with last_error otherwise).
func value(field: int) -> int:
    if not _field(field):
        return 0
    return _values[field]


## The room's latest state of each field (a copy, 32 entries); the room's updates write it.
func get_values() -> PackedInt32Array:
    return _values.duplicate()


## For the client.
func notify(mask: int) -> void:
    changed.emit(mask)


func _initialize(spawn: Gs2SyncRecord) -> void:
    _values = spawn.values.duplicate()
    _pending.id = spawn.id
    _reset_writes()


## For the client: applies the fields of a room update with state version state that are not
## older than the newest received; returns the fields whose value changed. An update repeating
## the value held (a resend, a repeat of the same change) only moves the received version on:
## the value still holds from its earlier version, it keeps the value it replaced and it is not
## a change.
func apply_update(update: Gs2SyncRecord, state: int) -> int:
    var applied := 0
    var update_values := update.values
    for f in 32:
        var bit := 1 << f
        if (update.mask & bit) == 0 or _is_outdated(f, state):
            continue
        _received[f] = state
        _received_mask |= bit
        var v: int = update_values[f]
        if v == _values[f]:
            continue
        # Keep the value this update replaces, with its version when it has one (the spawn's
        # initial values have none).
        _prior_values[f] = _values[f]
        _prior_versions[f] = _versions[f]
        _prior_mask |= bit
        if (_versioned_mask & bit) != 0:
            _prior_versioned_mask |= bit
        else:
            _prior_versioned_mask &= ~bit
        _values[f] = v
        _versions[f] = state
        applied |= bit
    _versioned_mask |= applied
    return applied


# An update of the field with state version state is older than one received.
func _is_outdated(field: int, state: int) -> bool:
    return (_received_mask & (1 << field)) != 0 and Gs2SyncInt.serial_diff(state, _received[field]) < 0


## For the world: the field's value comes from a state version newer than state.
func is_newer(field: int, state: int) -> bool:
    return (_versioned_mask & (1 << field)) != 0 and Gs2SyncInt.serial_diff(_versions[field], state) > 0


# Unity's KnownAsOf(field, state, out version) is split in two (GDScript has no out
# parameters): is_known and known_version_as_of.

## For the world: some update of the field was received (false: it holds its spawn value).
func is_known(field: int) -> bool:
    return (_received_mask & (1 << field)) != 0


## For the world: how far the field's current value is known, as of the clock's state: the
## newest version received, but not past state (meaningful when is_known).
func known_version_as_of(field: int, state: int) -> int:
    return state if Gs2SyncInt.serial_diff(_received[field], state) > 0 else _received[field]


# Unity's Current(field, out value, out version) is split into value, current_version and
# has_version.

## For the world: the state version of the field's current value (meaningful when has_version).
func current_version(field: int) -> int:
    return _versions[field]


## For the world: the field's current value has a state version (false: none yet).
func has_version(field: int) -> bool:
    return (_versioned_mask & (1 << field)) != 0


# Unity's TryPriorAsOf(field, state, out value, out version, out versioned) is split into
# has_prior_as_of, prior_value, prior_version and is_prior_versioned.

## For the world: there is a value the field's latest update replaced, and that update was not
## newer than state (an unversioned prior, a spawn's initial value, holds as of any state
## before the field's first update).
func has_prior_as_of(field: int, state: int) -> bool:
    var bit := 1 << field
    if (_prior_mask & bit) == 0:
        return false
    return (_prior_versioned_mask & bit) == 0 or Gs2SyncInt.serial_diff(_prior_versions[field], state) <= 0


## For the world: the value the field's latest update replaced.
func prior_value(field: int) -> int:
    return _prior_values[field]


## For the world: the state version of prior_value (meaningful when is_prior_versioned).
func prior_version(field: int) -> int:
    return _prior_versions[field]


## For the world: prior_value has a state version (false for a spawn's initial value).
func is_prior_versioned(field: int) -> bool:
    return (_prior_versioned_mask & (1 << field)) != 0


# ---- This client's writes (owner or lease holder) ----

## For the client.
func has_pending_writes() -> bool:
    return _pending.mask != 0


## For the client: the staged writes as an update record (reused; valid until writes_sent).
func pending_writes() -> Gs2SyncRecord:
    return _pending


## For the client: stages a write; writing back the last sent value cancels it.
func stage_write(field: int, v: int) -> void:
    _pending.values[field] = v
    _written |= 1 << field
    if _sent[field] == v:
        _pending.mask &= ~(1 << field)
    else:
        _pending.mask |= 1 << field


## For the client: the staged writes were sent; they become the last sent values.
func writes_sent(unreliable: bool) -> void:
    var pending_values := _pending.values
    for f in 32:
        if _pending.has(f):
            _sent[f] = pending_values[f]
    if unreliable:
        _recent |= _pending.mask
    else:
        _recent &= ~_pending.mask # delivered reliably: nothing to resend
    _pending.mask = 0


# A new holder or authority period: drop staged writes and the resend set (values of an
# earlier period are not this period's to repeat) and continue from the room's state.
func _reset_writes() -> void:
    _pending.mask = 0
    _recent = 0
    _written = 0
    _pending.epoch = _epoch
    _sent = _values.duplicate()
    _pending.values = _values.duplicate()


## For the client: fields to resend reliably (refresh); cleared until they are sent unreliably
## again.
func take_recent() -> int:
    var m := _recent
    _recent = 0
    return m


## For the client.
func restore_recent(m: int) -> void:
    _recent |= m


# Unity's TryWritten(field, out value) is split into has_written and written_value.

## For the world: this client wrote the field in the current authority period (staged or sent).
func has_written(field: int) -> bool:
    return (_written & (1 << field)) != 0


## For the world: this client's latest write of the field (meaningful when has_written).
func written_value(field: int) -> int:
    return _pending.values[field]


## For the client: the last sent values (a copy).
func sent_values() -> PackedInt32Array:
    return _sent.duplicate()


# ---- What this client shows ----

## The value to present for the field (0..31; 0 with last_error otherwise): the prediction of an
## object this client predicts (is_predicted); for the writer (owner or lease holder), its own
## latest write of the field in the current authority period, sent or not; otherwise the room's
## latest state. A writer sees its writes at once, and a late echo of an older write never
## shows. Unity's ShownValues[field].
func shown_value(field: int) -> int:
    if not _field(field):
        return 0
    return _shown(field)


## The 32 shown values (a copy; see shown_value).
func get_shown_values() -> PackedInt32Array:
    var shown := PackedInt32Array()
    shown.resize(32)
    for f in 32:
        shown[f] = _shown(f)
    return shown


func _shown(field: int) -> int:
    if is_predicted:
        return _predicted[field]
    return _pending.values[field] if writable_by_me() and has_written(field) else _values[field]


# ---- Prediction (Gs2NetworkWorld.register_prediction) ----

## Values after the newest predicted tick (a copy); show them blended with
## get_previous_predicted_values by the alpha of predicted.
func get_predicted_values() -> PackedInt32Array:
    return _predicted.duplicate()


## Values after the tick before the newest predicted one (a copy).
func get_previous_predicted_values() -> PackedInt32Array:
    return _previous_predicted.duplicate()


## After the room disagreed with an earlier prediction: per field, the old predicted value minus
## the corrected one at the same tick (a copy). Fade this offset out to avoid a jump.
func get_prediction_error() -> PackedInt32Array:
    return _prediction_error.duplicate()


## One field of get_predicted_values.
func predicted_value(field: int) -> int:
    return _predicted[field] if _field(field) else 0


## One field of get_previous_predicted_values.
func previous_predicted_value(field: int) -> int:
    return _previous_predicted[field] if _field(field) else 0


## One field of get_prediction_error.
func prediction_error(field: int) -> int:
    return _prediction_error[field] if _field(field) else 0


## For the world.
func notify_predicted(alpha: float) -> void:
    predicted.emit(alpha)


## For the world (32 values each, copied).
func set_prediction(current: PackedInt32Array, previous: PackedInt32Array) -> void:
    _predicted = current.duplicate()
    _previous_predicted = previous.duplicate()


## For the world (32 values, copied).
func set_predicted(current: PackedInt32Array) -> void:
    _predicted = current.duplicate()


## For the world (32 values, copied).
func set_previous_predicted(previous: PackedInt32Array) -> void:
    _previous_predicted = previous.duplicate()


## For the world: records the difference between the shown prediction and corrected values for
## the same tick; returns whether they differ.
func measure_prediction_error(corrected: PackedInt32Array) -> bool:
    var m := 0
    for f in 32:
        var error := Gs2SyncInt.i32(_predicted[f] - corrected[f])
        _prediction_error[f] = error
        if error != 0:
            m |= 1 << f
    _prediction_error_mask = m
    return m != 0


## For the world.
func notify_corrected() -> void:
    prediction_corrected.emit(_prediction_error_mask)


func _field(field: int) -> bool:
    last_error = ""
    if field >= 0 and field < 32:
        return true
    last_error = _FIELD_ERROR
    push_error(_FIELD_ERROR)
    return false
