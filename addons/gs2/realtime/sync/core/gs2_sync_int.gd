# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# int32 / uint32 arithmetic on GDScript's 64-bit int. The room evaluates its rules in checked
# int32 arithmetic: a result outside int32, a division by zero or int.MinValue / -1 fails the
# step. The checked functions here do the same for prediction code generated from @predict
# rule methods: they report the failure with Gs2PredictionRoom.fail and return 0, and the
# generated code returns as soon as Gs2PredictionRoom.failed().
class_name Gs2SyncInt
extends RefCounted


const INT32_MIN = -2147483648
const INT32_MAX = 2147483647
const UINT32_MASK = 0xFFFFFFFF


## value's low 32 bits as a signed int32 (C#'s unchecked((int)value)).
static func i32(value: int) -> int:
    var low = value & UINT32_MASK
    return low - 0x100000000 if low >= 0x80000000 else low


## value's low 32 bits as a uint32 (C#'s unchecked((uint)value)).
static func u32(value: int) -> int:
    return value & UINT32_MASK


## Whether value is an int32.
static func fits(value: int) -> bool:
    return value >= INT32_MIN and value <= INT32_MAX


## (int)(a - b) of two uint32 serial numbers: positive when a is after b.
static func serial_diff(a: int, b: int) -> int:
    return i32(a - b)


## a + b, failing outside int32.
static func add(a: int, b: int) -> int:
    return _checked(a + b, "addition")


## a - b, failing outside int32.
static func sub(a: int, b: int) -> int:
    return _checked(a - b, "subtraction")


## a * b, failing outside int32 (both int32, so the product fits in int64).
static func mul(a: int, b: int) -> int:
    return _checked(a * b, "multiplication")


## a / b truncated toward zero, as C#; fails for b == 0 and outside int32 (MinValue / -1).
static func div(a: int, b: int) -> int:
    if b == 0:
        Gs2PredictionRoom.fail("Attempted to divide by zero")
        return 0
    return _checked(a / b, "division")


## a % b with the sign of a, as C#; fails for b == 0 and for MinValue % -1 (the CLR throws,
## and the room's cs_rem fails through cs_div).
static func rem(a: int, b: int) -> int:
    if b == 0:
        Gs2PredictionRoom.fail("Attempted to divide by zero")
        return 0
    if a == INT32_MIN and b == -1:
        Gs2PredictionRoom.fail("Arithmetic operation resulted in an overflow (remainder)")
        return 0
    return a % b


## -a, failing for int.MinValue.
static func neg(a: int) -> int:
    return _checked(-a, "negation")


## The IEEE double square root (for Gs2RoomMath, whose own sqrt shadows the engine's).
static func sqrt_double(value: float) -> float:
    return sqrt(value)


static func _checked(value: int, operation: String) -> int:
    if fits(value):
        return value
    Gs2PredictionRoom.fail("Arithmetic operation resulted in an overflow (%s)" % operation)
    return 0
