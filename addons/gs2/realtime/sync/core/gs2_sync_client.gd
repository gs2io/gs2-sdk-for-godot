# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The client side of a room's object synchronization (Unity's SyncClient): decodes the room's
# packets (receive), keeps the room's objects and properties, and sends this client's writes,
# inputs and commands. Call it from one thread (the main thread).
#
# Senders are Callables func(data: PackedByteArray, count: int) -> bool (Unity's TrySend):
# false means not sent. data is a packet of its own (count == data.size()); the client does not
# change it afterwards.
#
# Errors: GDScript has no exceptions. Where Unity throws for a misuse of the API (an object
# this client may not command, a bad target or count, ...), the call returns false / 0, records
# Unity's message in last_error and reports it with push_error; request callbacks are not run
# then, as in Unity. A false / 0 with an empty last_error means "not sent" (the outbox or the
# transport refused it), as in Unity. receive returns false with last_error for a packet it
# cannot apply (Unity's FormatException): the caller disconnects, as Unity's callers do.
#
# Request callbacks (Unity's CommandCallback / SpawnCallback) are Callables:
#   completed(status: int, result: int) for leases and interactions,
#   completed(status: int, spawned: Gs2NetworkObject, result: int) for spawns,
# with status a Gs2SyncTypes.RequestStatus and result a Gs2SyncTypes.CommandResult (or a rules
# code from 100). Each runs exactly once: with the room's answer, NOT_SENT at once, or ABANDONED.
#
# The world that presents the objects (Gs2NetworkWorld) sets presenter; the client tells it of
# every change before raising its own signals, so their observers find it up to date. The
# presenter implements (Unity's ISyncPresenter):
#   sync_spawned(o: Gs2NetworkObject)
#   sync_despawned(o: Gs2NetworkObject)
#   sync_updated(o: Gs2NetworkObject, update: Gs2SyncRecord, state: int)
#       (every update of a known object with its state version, including values older than
#       the object's: the world completes its confirmed state with them)
#   sync_rpc_received(o: Gs2NetworkObject, method: int, sender: int, args: PackedByteArray, offset: int, count: int)
#   sync_event_received(code: int, sender: int, args: PackedByteArray, offset: int, count: int)
#   sync_property_changed(scope: int, key: String, value: PackedByteArray, offset: int, count: int)
#   sync_clock_received(tick: int, rate: int, latest: int)
#
# Received arguments and property values borrow the received packet: (args, offset, count)
# names args[offset, offset + count). Read them in the handler, or copy them
# (args.slice(offset, offset + count)) to keep them; do not modify args.
class_name Gs2SyncClient
extends RefCounted


## Raised when an object arrives (in a snapshot or spawned later).
signal spawned(o: Gs2NetworkObject)
## Raised when a room update changes an object's fields (object, changed-field mask).
signal changed(o: Gs2NetworkObject, mask: int)
## Raised when an object is removed, also for every object a snapshot or reset clears.
signal despawned(o: Gs2NetworkObject)
## Raised for each RPC received on an object; args borrow the packet (see above).
signal rpc_received(target: Gs2NetworkObject, method: int, sender: int, args: PackedByteArray, offset: int, count: int)
## Raised for each room event received (raise_event); args borrow the packet.
signal event_received(code: int, sender: int, args: PackedByteArray, offset: int, count: int)
## Raised when a custom property changes, after property_value reflects the change. A property
## written by writer (count 0: deleted) in scope 0 (the room) or a player's connection ID; value
## borrows the packet.
signal property_changed(scope: int, writer: int, key: String, value: PackedByteArray, offset: int, count: int)
## A refused command, with the reason.
signal rejected(rejection: Gs2SyncRejection)
## Raised for every authority state the room sends about an object, even one that changes
## neither holder nor epoch (Gs2NetworkObject.authority_changed is raised only then).
signal authority_changed(o: Gs2NetworkObject)
## The answer to a lease request or interaction: (object ID, request ID, result).
signal command_completed(object_id: int, request: int, result: int)
## A spawn request of this client (the ID spawn returned) and the object the room made for it.
signal spawn_confirmed(request: int, o: Gs2NetworkObject)
## A spawn request (the ID spawn returned) that the room refused.
signal spawn_rejected(request: int, result: int)
## Raised with the new master's connection ID, and with the snapshot's at its start.
signal master_changed(connection_id: int)
## Raised when an object moves to another interest group (Gs2NetworkObject.group).
signal group_changed(o: Gs2NetworkObject)
## A snapshot starts: objects, master and properties are replaced.
signal snapshot_started
## The snapshot is applied (room_ready), raised after the packet, outside its handlers' packet
## processing. Commands made before (from attach on) wait in the outbox and leave now, in call
## order; those made from here on leave at once, and those made inside later handlers right
## after their packet.
signal snapshot_completed
## A ticking room's clock: (tick, ticks per second, newest input tick it received from this
## client).
signal clock_received(tick: int, rate: int, latest: int)

## Most packets the outbox holds. Commands wait there before the snapshot completes, inside
## handlers, or while the transport refuses them; when it is full, commands are not sent (they
## return false or 0).
const MAX_HELD_PACKETS = 256
## Objects a room holds at most (the room's MaxObjects).
const MAX_OBJECTS = 4096
## Ticks per second a ticking room runs at most (the room's MaxTickRate).
const MAX_TICK_RATE = 60
## How many recent ticks' inputs the client keeps for repeating in input packets.
const INPUT_HISTORY = 8
## Largest unreliable update packet, in bytes: it fits one datagram, as the room's do (larger
## ones would be fragmented on the way).
const MAX_DATAGRAM = 1000
## Longest property key, in UTF-8 bytes.
const MAX_PROPERTY_KEY = 64
## The scope of the room's own properties (a player's scope is its connection ID).
const ROOM_SCOPE = 0

const _HEADER_SIZE = 8 # with the largest state version
const _NOT_READY = "Wait for snapshot completion (SnapshotCompleted)"

## This client's connection ID in the room.
var connection_id := 0
## True once the room's snapshot is applied (snapshot_completed); false after reset and while a
## new snapshot arrives. set_field and send_input fail while it is false. Unity's Ready.
var room_ready := false
## Optional unreliable sender (e.g. Gs2RealtimeUdpChannel.try_send). When set (a valid
## Callable), flush and send_input send through it; flushes before commands stay on the
## reliable sender so updates still precede the command. Call refresh about once per second so
## values lost on the way are sent again (reliably).
var unreliable := Callable()
## The rules the room runs: the first 4 bytes of the SHA-256 of its GSL (0 for a room without
## rules), from the latest snapshot.
var rules_hash := 0
## The room's master client (0 until the snapshot names it).
var master_id := 0
## State version of the latest clock: the newest update the room sent before it. Updates up to
## this version make up the room's state at the clock's tick.
var clock_state := 0
## Ticks per second of a ticking room (0 until a clock arrives or when not ticking).
var tick_rate := 0
## Ticks per input packet (1..8, default 3): the newest input and the ones before it, so a lost
## packet's inputs arrive with a later one. Values outside the range are clamped.
var input_redundancy := 3:
    set(v):
        input_redundancy = clampi(v, 1, INPUT_HISTORY)
## The world that presents this client's objects (see above), or null.
var presenter: Object = null
## Why the last call failed, or "" (see above).
var last_error := ""

# State version of this client's update packets, numbered in sending order over both senders:
# the room keeps, per field, the value of the newest one, so a datagram delayed behind a
# reliable update cannot undo it. Process-wide, so a new client on the same connection never
# numbers below an earlier one.
static var _update_state := 0

var _send := Callable()
var _input := Gs2SyncCodec.new()
var _output: Array[Gs2SyncRecord] = []
var _refresh: Array[Gs2SyncRecord] = []
var _command := Gs2SyncRecord.new()
var _objects: Dictionary[int, Gs2NetworkObject] = {}
var _next_request := 1
var _next_command := 1
var _receiving := false
var _held: Array[PackedByteArray] = []
var _inputs: Array[Gs2SyncRecord] = []
var _input_count := 0
var _empty_slots := Gs2SlotValues.new()
# The callbacks of requests awaiting the room's answer, by request ID. Each runs exactly once:
# with the room's answer, NOT_SENT at once, or ABANDONED.
var _awaited_commands: Dictionary[int, Callable] = {}
var _awaited_spawns: Dictionary[int, Callable] = {}
# Raw values by scope (0: the room; a connection ID: that player's) and key. The room echoes
# every write; the stored value changes when the echo arrives.
var _properties: Dictionary = {} # int -> Dictionary[String, PackedByteArray]


## Creates a client for this connection; try_send is the reliable transport. A connection ID
## of 0 or an invalid try_send is a misuse (Unity throws ArgumentException): it is reported and
## the client sends nothing.
func _init(client_connection_id: int = 0, try_send: Callable = Callable()) -> void:
    for i in Gs2SyncCodec.MAX_RECORDS:
        _output.append(null)
        _refresh.append(Gs2SyncRecord.new())
    for i in INPUT_HISTORY:
        _inputs.append(Gs2SyncRecord.new())
    if client_connection_id <= 0 or client_connection_id > 0xFFFFFFFF or not try_send.is_valid():
        _misuse("A sync client needs a connection ID (not 0) and a trySend Callable")
        return
    connection_id = client_connection_id
    _send = try_send


static func _next_update_state() -> int:
    _update_state = (_update_state + 1) & 0xFFFFFFFF
    if _update_state == 0:
        _update_state = 1
    return _update_state


## The room objects this client currently knows (a new array).
func objects() -> Array[Gs2NetworkObject]:
    var list: Array[Gs2NetworkObject] = []
    list.assign(_objects.values())
    return list


## The object with this ID, or null when this client does not know it.
func find(id: int) -> Gs2NetworkObject:
    return _objects.get(id, null)


## A command now would be accepted: sent at once, or kept in the outbox while it has room (see
## MAX_HELD_PACKETS).
func can_send() -> bool:
    return _held.size() < MAX_HELD_PACKETS


# ---- Reliable sending: the outbox ----
# Every reliable packet leaves through _transmit, in call order. A packet waits in the outbox
# (_held) while it cannot leave yet: before the snapshot completes, inside handlers (receive),
# or when the transport refused it; the outbox drains after each packet received, on the next
# command and on flush. reset and a new snapshot after rejoining drop what is left.

func _releasing() -> bool:
    return room_ready and not _receiving


func _transmit(packet: PackedByteArray) -> bool:
    if _release_held() and _releasing() and _deliver(_send, packet):
        return true
    if _held.size() >= MAX_HELD_PACKETS:
        return false
    _held.append(packet)
    return true


# Sends what the outbox holds, when it may; true once it is empty.
func _release_held() -> bool:
    if not _releasing():
        return _held.is_empty()
    while not _held.is_empty():
        if not _deliver(_send, _held[0]):
            return false
        _held.pop_front()
    return true


static func _deliver(sender: Callable, packet: PackedByteArray) -> bool:
    if not sender.is_valid():
        return false
    return sender.call(packet, packet.size()) == true


# A packet through the unreliable sender, or the outbox.
func _send_via(packet: PackedByteArray, use_unreliable: bool) -> bool:
    if use_unreliable:
        return _deliver(unreliable, packet)
    return _transmit(packet)


# An encoded packet, or an empty one with last_error (records the client built that the codec
# refuses: a misuse, e.g. a value outside uint32).
func _encode(op: int, state: int, records: Array, count: int) -> PackedByteArray:
    var packet := Gs2SyncCodec.encode(op, state, records, count)
    if packet.is_empty():
        _misuse(Gs2SyncCodec.last_error)
    return packet


# Inputs need the snapshot (commands wait in the outbox instead).
func _check_ready() -> bool:
    if room_ready:
        return true
    _misuse(_NOT_READY)
    return false


# The one way commands leave: this client's writes made before a command are sent first,
# reliably, so the room applies them before it (an RPC sees the values its caller wrote).
# Writes go out on the unreliable sender only with flush.
func _send_command(op: int) -> bool:
    if not _flush_via(false):
        return false
    _output[0] = _command
    var packet := _encode(op, 0, _output, 1)
    if packet.is_empty():
        return false
    return _transmit(packet)


# ---- Answers to this client's requests ----

# Registers completed for request; a request that was not sent (0) completes at once with
# NOT_SENT, unless a misuse refused it (Unity throws then, and runs no callback).
func _await(command_request: int, completed: Callable) -> int:
    if not completed.is_valid():
        return command_request
    if command_request == 0:
        if last_error == "":
            completed.call(Gs2SyncTypes.RequestStatus.NOT_SENT, 0)
    else:
        _awaited_commands[command_request] = completed
    return command_request


static func _answer(result: int) -> int:
    if result == Gs2SyncTypes.CommandResult.SUCCESS or result == Gs2SyncTypes.CommandResult.ALREADY_APPLIED:
        return Gs2SyncTypes.RequestStatus.SUCCEEDED
    return Gs2SyncTypes.RequestStatus.REFUSED


func _answer_command(command_request: int, result: int) -> void:
    if not _awaited_commands.has(command_request):
        return
    var completed: Callable = _awaited_commands[command_request]
    _awaited_commands.erase(command_request)
    completed.call(_answer(result), result)


func _answer_spawn(spawn_request: int, o: Gs2NetworkObject, result: int) -> void:
    if not _awaited_spawns.has(spawn_request):
        return
    var completed: Callable = _awaited_spawns[spawn_request]
    _awaited_spawns.erase(spawn_request)
    completed.call(Gs2SyncTypes.RequestStatus.SUCCEEDED if o != null else Gs2SyncTypes.RequestStatus.REFUSED, o, result)


## Stops waiting for every request: their callbacks run with ABANDONED. reset and a new
## snapshot after rejoining do this (the room answers the requests of a session in that session
## only); a world detaching from this client does it too.
func abandon_requests() -> void:
    if _awaited_commands.is_empty() and _awaited_spawns.is_empty():
        return
    var commands := _awaited_commands.values()
    var spawns := _awaited_spawns.values()
    _awaited_commands.clear()
    _awaited_spawns.clear()
    for completed in commands:
        completed.call(Gs2SyncTypes.RequestStatus.ABANDONED, 0)
    for completed in spawns:
        completed.call(Gs2SyncTypes.RequestStatus.ABANDONED, null, 0)


## Requests a player or simulated object with the field values set in values (null: none; its
## fields start at the room's values, its defaults or what the rules' Spawned sets). Returns the
## request ID (see spawn_confirmed / spawn_rejected), or 0 when it was not sent (the outbox is
## full). With completed, it runs once: with the room's object (SUCCEEDED), its refusal
## (REFUSED), NOT_SENT (at once) or ABANDONED.
func spawn(prefab: int, values: Gs2SlotValues = null, completed: Callable = Callable()) -> int:
    last_error = ""
    if values == null:
        values = _empty_slots
    # Bit 31 marks the room's predicted-spawn keys.
    if _next_request == 0 or _next_request >= (1 << 31):
        _misuse("Request IDs exhausted")
        return 0
    _command.clear()
    _command.id = _next_request
    _command.prefab = prefab
    _command.mode = Gs2SyncTypes.ObjectMode.PLAYER
    values.copy_to_record(_command)
    var spawn_request := 0
    if _send_command(Gs2SyncCodec.Op.SPAWN):
        spawn_request = _next_request
        _next_request += 1
    if completed.is_valid():
        if spawn_request != 0:
            _awaited_spawns[spawn_request] = completed
        elif last_error == "":
            completed.call(Gs2SyncTypes.RequestStatus.NOT_SENT, null, 0)
    return spawn_request


# ---- The objects commands address ----
# Each command names the rule its object must satisfy; another object is the caller's mistake.

func _require(allowed: bool, refusal: String) -> bool:
    if allowed:
        return true
    _misuse(refusal)
    return false


func _my_owned_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.owned_by_me(), "Object is not owned by this connection") else null


func _leased_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.kind().leased, "Not a leased object") else null


func _server_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.kind().interactive, "Not a server object") else null


func _my_despawnable_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.despawnable_by_me(), "Only the owner of a player object despawns it") else null


func _rpc_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.kind().owned, "RPCs target player and simulated objects") else null


func _transferable_object(id: int) -> Gs2NetworkObject:
    var o := find(id)
    return o if _require(o != null and o.kind().transferable, "Ownership transfers player objects") else null


## Sends this client's input for a tick, together with the inputs of the input_redundancy - 1
## ticks before it, over the unreliable sender when one is set; slots not set in input read as
## 0. Requires room_ready and a ticking room (tick_rate > 0); tick must be newer than the
## previous call's. view_lag is how far the remote objects on screen trailed tick, in 1/16
## ticks; the room rewinds hit tests made for this client's objects by it (lag compensation).
## Returns false when it was not sent.
func send_input(tick: int, input: Gs2SlotValues, view_lag: int = 0) -> bool:
    last_error = ""
    if not _check_ready():
        return false
    if input == null:
        _misuse("input is required")
        return false
    if tick_rate == 0:
        _misuse("The room is not ticking")
        return false
    if tick < 0 or tick > 0xFFFFFFFF or view_lag < 0 or view_lag > 0xFFFFFFFF:
        _misuse("tick and viewLag are uint32")
        return false
    var advances := _input_count == 0 or Gs2SyncInt.serial_diff(tick, _inputs[(_input_count - 1) % INPUT_HISTORY].id) > 0
    if not advances:
        _misuse("Inputs must advance")
        return false
    var r := _inputs[_input_count % INPUT_HISTORY]
    r.clear()
    r.id = tick
    r.epoch = view_lag
    input.copy_to_record(r)
    _input_count += 1
    var count := mini(input_redundancy, mini(_input_count, INPUT_HISTORY))
    for i in count:
        _output[i] = _inputs[(_input_count - count + i) % INPUT_HISTORY]
    var packet := _encode(Gs2SyncCodec.Op.INPUT, 0, _output, count)
    if packet.is_empty():
        return false
    return _send_via(packet, unreliable.is_valid())


## Stages a write of an object's field (an int32 value) for the next flush. Allowed inside
## handlers (nothing is sent). Requires room_ready and write authority (can_write) and a field
## the object has; writing back the last sent value cancels the staged write. Unity's Set.
func set_field(id: int, field: int, value: int) -> bool:
    last_error = ""
    if not _check_ready():
        return false
    var o := find(id)
    if not _require(o != null and o.writable_by_me(), "No write authority"):
        return false
    if not o.has_field(field):
        _misuse("field is not a field of the object")
        return false
    if not Gs2SyncInt.fits(value):
        _misuse("value is not an int32")
        return false
    o.stage_write(field, value)
    return true


## Sends the outbox and the pending owner and lease-holder writes, batched per packet, through
## the unreliable sender when one is set. Returns false when a packet was not sent; its writes
## stay pending for the next flush.
func flush() -> bool:
    last_error = ""
    _release_held()
    return _flush_via(unreliable.is_valid())


func _flush_via(use_unreliable: bool) -> bool:
    if not room_ready:
        return true # nothing is written before the snapshot
    var count := 0
    var size := _HEADER_SIZE
    var limit := MAX_DATAGRAM if use_unreliable else Gs2SyncCodec.MAX_PACKET
    for o in _objects.values():
        if not o.has_pending_writes():
            continue
        var record: Gs2SyncRecord = o.pending_writes()
        var k := Gs2SyncCodec.update_size(record)
        var full := count == _output.size() or (count > 0 and size + k > limit)
        if full:
            if not _flush_batch(count, use_unreliable):
                return false
            count = 0
            size = _HEADER_SIZE
        _output[count] = record
        count += 1
        size += k
    return count == 0 or _flush_batch(count, use_unreliable)


# Before this client's authority over an object ends (a transfer, a lease release), its pending
# writes go out reliably, then the values it sent over UDP since the last refresh are sent again
# reliably: a lost or delayed datagram would arrive in the next period and be dropped, so the
# room would keep an older value. Writes just sent reliably are not resent.
func _hand_over_writes(o: Gs2NetworkObject) -> bool:
    return _flush_via(false) and _confirm_sent(o)


func _confirm_sent(o: Gs2NetworkObject) -> bool:
    var m := o.take_recent()
    if m == 0:
        return true
    var r := _refresh[0]
    r.clear()
    r.id = o.id
    r.epoch = o.epoch
    r.mask = m
    r.values = o.sent_values()
    var packet := _encode(Gs2SyncCodec.Op.UPDATE, _next_update_state(), _refresh, 1)
    if not packet.is_empty() and _transmit(packet):
        return true
    o.restore_recent(m)
    return false


func _flush_batch(count: int, use_unreliable: bool) -> bool:
    var packet := _encode(Gs2SyncCodec.Op.UPDATE, _next_update_state(), _output, count)
    if packet.is_empty() or not _send_via(packet, use_unreliable):
        return false
    for i in count:
        _objects[_output[i].id].writes_sent(use_unreliable)
    return true


## Resends the current values of fields sent unreliably since the last call. The resend is
## reliable, so the final value of every field reaches the room however many datagrams were
## lost; its state version keeps it from undoing newer values. Call it about once per second
## while unreliable is used.
func refresh() -> bool:
    last_error = ""
    if not room_ready:
        return true # nothing is written before the snapshot
    var count := 0
    for o in _objects.values():
        var m: int = o.take_recent()
        if m == 0:
            continue
        # Resent even after the unreliable sender was removed (UDP went inactive): the values
        # it lost reach the room only this way.
        if not can_write(o.id):
            continue
        var r := _refresh[count]
        r.clear()
        r.id = o.id
        r.epoch = o.epoch
        r.mask = m
        r.values = o.sent_values()
        count += 1
        if count == _refresh.size():
            if not _send_refresh(count):
                return false
            count = 0
    return count == 0 or _send_refresh(count)


func _send_refresh(count: int) -> bool:
    var packet := _encode(Gs2SyncCodec.Op.UPDATE, _next_update_state(), _refresh, count)
    if not packet.is_empty() and _transmit(packet):
        return true
    # Not sent: the next refresh tries again.
    for i in count:
        var o := find(_refresh[i].id)
        if o != null:
            o.restore_recent(_refresh[i].mask)
    return false


## This client may write the object's fields (set_field): it is room_ready and holds a kind the
## holder writes. False for unknown objects.
func can_write(id: int) -> bool:
    var o := find(id)
    return room_ready and o != null and o.writable_by_me()


## This client drives the object: it holds it (owns a player or simulated object, or holds a
## leased object's lease). The holder of a simulated object drives it with inputs while the
## rules write its fields.
func controls(id: int) -> bool:
    var o := find(id)
    return room_ready and o != null and o.is_mine()


## Acquires, renews or releases a leased object's lease (action: Gs2SyncTypes.LeaseAction).
## Releasing a held lease first sends this client's writes reliably. Returns the request ID
## (answered by command_completed and completed, see spawn), or 0 when it was not sent.
func lease(id: int, action: int, completed: Callable = Callable()) -> int:
    last_error = ""
    var o := _leased_object(id)
    if o == null:
        return 0
    if action < Gs2SyncTypes.LeaseAction.ACQUIRE or action > Gs2SyncTypes.LeaseAction.RELEASE:
        _misuse("action is not a LeaseAction")
        return 0
    # Only the holder hands its writes over; a lease that already expired has none.
    var handing_over := action == Gs2SyncTypes.LeaseAction.RELEASE and o.lease_held_by_me()
    if handing_over and not _hand_over_writes(o):
        return _await(0, completed)
    _command.clear()
    _command.id = id
    _command.epoch = o.epoch
    _command.kind = action
    return _await(_send_request(Gs2SyncCodec.Op.AUTHORITY), completed)


## Runs the rules' Interact(state, objectId, method) on a server object. Rule-based rooms take
## no arguments (args are reserved for host-defined actions; rules refuse them). args are sent
## whole unless count (0..args.size()) gives how many of their first bytes to send; -1 means all
## of them. Returns the request ID (answered by command_completed and completed, see spawn), or
## 0 when it was not sent.
func interact(id: int, method: int, args: PackedByteArray = PackedByteArray(), count: int = -1, completed: Callable = Callable()) -> int:
    last_error = ""
    if _server_object(id) == null:
        return 0
    if count == -1:
        count = args.size()
    if not _valid_count(args, count):
        return 0
    _command.clear()
    _command.id = id
    _command.method = method
    _command.args = args
    _command.args_count = count
    return _await(_send_request(Gs2SyncCodec.Op.CALL), completed)


func _send_request(op: int) -> int:
    if _next_command == 0:
        _misuse("Command IDs exhausted")
        return 0
    _command.request = _next_command
    if not _send_command(op):
        return 0
    var command_request := _next_command
    _next_command = (_next_command + 1) & 0xFFFFFFFF
    return command_request


## Despawns an object this client may despawn (despawnable_by_me; a misuse otherwise). Returns
## false when it was not sent.
func destroy(id: int) -> bool:
    last_error = ""
    if _my_despawnable_object(id) == null:
        return false
    _command.clear()
    _command.id = id
    return _send_command(Gs2SyncCodec.Op.DESPAWN)


# ---- RPCs and room events ----

## An RPC on a player or simulated object, to target's receivers (Gs2SyncTypes.RpcTarget).
## Calls on another player's object need the method in the prefab's publicMethods; the room
## refuses other non-owner calls. args (at most Gs2SyncCodec.MAX_ARGS bytes) are sent whole
## unless count gives how many of their first bytes to send (-1 sends all of them). Returns
## false when it was not sent. Unity's Rpc.
func send_rpc(id: int, method: int, target: int, args: PackedByteArray = PackedByteArray(), count: int = -1) -> bool:
    last_error = ""
    var receivers := _receivers(target)
    if receivers < 0:
        return false
    return send_rpc_target(id, method, receivers, 0, args, count)


## An RPC to one player (a connection ID, not 0), not buffered; args and count as in send_rpc.
func rpc_to(id: int, method: int, recipient: int, args: PackedByteArray = PackedByteArray(), count: int = -1) -> bool:
    last_error = ""
    if not _recipient(recipient):
        return false
    return send_rpc_target(id, method, Gs2SyncCodec.TARGET_PLAYER, recipient, args, count)


## A room event (not tied to an object): any member may raise any code, to ALL or OTHERS
## (optionally buffered); OWNER is a misuse. args and count as in send_rpc. Returns false when
## it was not sent.
func raise_event(code: int, target: int, args: PackedByteArray = PackedByteArray(), count: int = -1) -> bool:
    last_error = ""
    var receivers := _receivers(target)
    if receivers < 0:
        return false
    return send_event_target(code, receivers, 0, args, count)


## A room event to one player (a connection ID, not 0), not buffered; args and count as in
## send_rpc.
func raise_event_to(code: int, recipient: int, args: PackedByteArray = PackedByteArray(), count: int = -1) -> bool:
    last_error = ""
    if not _recipient(recipient):
        return false
    return send_event_target(code, Gs2SyncCodec.TARGET_PLAYER, recipient, args, count)


# The target byte of an RpcTarget (-1 for a value outside the enum).
func _receivers(target: int) -> int:
    if Gs2SyncCodec.is_unaddressed(target):
        return target
    _misuse("target is not an RpcTarget (one player goes with rpc_to / raise_event_to)")
    return -1


func _recipient(recipient: int) -> bool:
    if recipient > 0 and recipient <= 0xFFFFFFFF:
        return true
    _misuse("A player is a connection ID (not 0)")
    return false


## For the entity and the world: send_rpc with a raw target byte, with its recipient (TARGET_PLAYER)
## or without (0). Unity's internal SendRpc.
func send_rpc_target(id: int, method: int, target: int, recipient: int, args: PackedByteArray, count: int) -> bool:
    last_error = ""
    if _rpc_object(id) == null:
        return false
    return _call(id, method, target, recipient, args, count)


## For the world: raise_event with a raw target byte. Unity's internal SendEvent.
func send_event_target(code: int, target: int, recipient: int, args: PackedByteArray, count: int) -> bool:
    last_error = ""
    if Gs2SyncCodec.receivers(target) == Gs2SyncCodec.TARGET_OWNER:
        _misuse("Room events have no owner")
        return false
    return _call(0, code, target, recipient, args, count)


func _valid_count(args: PackedByteArray, count: int) -> bool:
    if count < 0 or count > args.size():
        _misuse("count is out of range (0..args.size())")
        return false
    # Checked here, before writes are flushed, as Unity checks span arguments.
    if count > Gs2SyncCodec.MAX_ARGS:
        _misuse("Arguments exceed %d bytes" % Gs2SyncCodec.MAX_ARGS)
        return false
    return true


# A recipient goes with the Player target only: one with another target would be ignored and
# the call reach everyone.
func _call(id: int, method: int, target: int, recipient: int, args: PackedByteArray, count: int) -> bool:
    if not Gs2SyncCodec.is_valid_target(target) or Gs2SyncCodec.has_recipient(target) != (recipient != 0):
        _misuse("A recipient goes with the Player target only, and the Player target needs one")
        return false
    if count == -1:
        count = args.size()
    if not _valid_count(args, count):
        return false
    _command.clear()
    _command.id = id
    _command.method = method
    _command.target = target
    _command.recipient = recipient
    _command.args = args
    _command.args_count = count
    return _send_command(Gs2SyncCodec.Op.CALL)


## Hands a player object to another member (from its owner), or takes it over (new_owner =
## connection_id) when the prefab allows takeover. The owner's pending writes are sent reliably
## first. Returns false when it was not sent.
func transfer(id: int, new_owner: int) -> bool:
    last_error = ""
    if new_owner == 0:
        _misuse("Ownership transfers to a member")
        return false
    var o := _transferable_object(id)
    if o == null:
        return false
    var handing_over := o.is_mine() # the owner's writes go out before the transfer
    if handing_over and not _hand_over_writes(o):
        return false
    _command.clear()
    _command.id = id
    _command.kind = Gs2SyncCodec.AUTHORITY_TRANSFER
    _command.owner = new_owner
    return _send_command(Gs2SyncCodec.Op.AUTHORITY)


## Moves an object this client owns to an interest group (0 = everyone).
func set_group(id: int, new_group: int) -> bool:
    last_error = ""
    if _my_owned_object(id) == null:
        return false
    _command.clear()
    _command.id = id
    _command.kind = Gs2SyncCodec.AUTHORITY_GROUP
    _command.owner = new_group
    return _send_command(Gs2SyncCodec.Op.AUTHORITY)


## Starts or stops receiving an interest group's updates and calls. Group 0 is always received
## (passing it is a misuse).
func subscribe(group: int, subscribing: bool) -> bool:
    last_error = ""
    if group == 0:
        _misuse("Group 0 is always received")
        return false
    _command.clear()
    _command.kind = Gs2SyncCodec.ROOM_INTEREST
    _command.id = group
    _command.owner = 1 if subscribing else 0
    return _send_command(Gs2SyncCodec.Op.ROOM)


## Names another master client. Only the current master may.
func set_master(new_master: int) -> bool:
    last_error = ""
    _command.clear()
    _command.kind = Gs2SyncCodec.ROOM_MASTER
    _command.id = new_master
    return _send_command(Gs2SyncCodec.Op.ROOM)


# ---- Custom properties ----

## The keys of a scope's properties (a new array; read their values with property_value).
func property_keys(scope: int) -> Array[String]:
    var keys: Array[String] = []
    if _properties.has(scope):
        keys.assign(_properties[scope].keys())
    return keys


## Whether the scope has a value for key.
func has_property(scope: int, key: String) -> bool:
    return _properties.has(scope) and _properties[scope].has(key)


## The stored value (a copy), or an empty array when there is none (stored values are never
## empty: an empty write deletes). Unity's TryGetProperty.
func property_value(scope: int, key: String) -> PackedByteArray:
    if not has_property(scope, key):
        return PackedByteArray()
    return _properties[scope][key].duplicate()


## Writes a property of the room (ROOM_SCOPE) or this player (connection_id); an empty value
## deletes it. Keys are 1..64 UTF-8 bytes, and key and value together fit
## Gs2SyncCodec.MAX_ARGS bytes (a misuse otherwise). The stored value changes when the room's
## echo arrives (property_changed).
func set_property(scope: int, key: String, value: PackedByteArray) -> bool:
    last_error = ""
    var key_bytes := key.to_utf8_buffer()
    var length := key_bytes.size()
    if length == 0 or length > MAX_PROPERTY_KEY:
        _misuse("Property keys are 1..%d UTF-8 bytes" % MAX_PROPERTY_KEY)
        return false
    if Gs2SyncCodec.varint_size(length) + length + value.size() > Gs2SyncCodec.MAX_ARGS:
        _misuse("Property exceeds %d bytes" % Gs2SyncCodec.MAX_ARGS)
        return false
    var args := PackedByteArray()
    Gs2SyncCodec.append_varint(args, length)
    args.append_array(key_bytes)
    args.append_array(value)
    _command.clear()
    _command.kind = Gs2SyncCodec.ROOM_PROPERTY
    _command.id = scope
    _command.set_arguments(args)
    return _send_command(Gs2SyncCodec.Op.ROOM)


## Writes a property as UTF-8 text (an empty text deletes it, like an empty value).
func set_text_property(scope: int, key: String, text: String) -> bool:
    return set_property(scope, key, text.to_utf8_buffer())


## The stored value as UTF-8 text; null when there is none, or it is not valid UTF-8. Unity's
## TryGetTextProperty.
func text_property(scope: int, key: String) -> Variant:
    if not has_property(scope, key):
        return null
    var value: PackedByteArray = _properties[scope][key]
    return decode_utf8(value, 0, value.size())


## Deletes a property (writes an empty value).
func delete_property(scope: int, key: String) -> bool:
    return set_property(scope, key, PackedByteArray())


# Applies a property the room announced; returns [key, value offset, value count], or [] with
# last_error.
func _apply_property(scope: int, args: PackedByteArray, offset: int, count: int) -> Array:
    var end := offset + count
    var read := Gs2SyncCodec.read_varint(args, offset, end)
    if read.is_empty():
        last_error = "Invalid property key (%s)" % Gs2SyncCodec.last_error
        return []
    var length: int = read[0]
    var at: int = read[1]
    if length == 0 or length > MAX_PROPERTY_KEY or length > end - at:
        last_error = "Invalid property key"
        return []
    var key = decode_utf8(args, at, at + length)
    if key == null:
        last_error = "Invalid UTF-8 in property key"
        return []
    var value_offset := at + length
    var value_count := end - value_offset
    if not _properties.has(scope):
        if value_count == 0:
            return [key, value_offset, value_count]
        _properties[scope] = {}
    var values: Dictionary = _properties[scope]
    if value_count == 0:
        values.erase(key)
        if values.is_empty():
            _properties.erase(scope)
    else:
        values[key] = args.slice(value_offset, value_offset + value_count)
    return [key, value_offset, value_count]


## Strict UTF-8 (as .NET's throwing UTF8Encoding: no overlong forms, surrogates or code points
## past U+10FFFF) of bytes[from, to); null when it is not valid. Godot's get_string_from_utf8
## replaces invalid sequences instead, and refuses NUL, which UTF-8 allows.
static func decode_utf8(bytes: PackedByteArray, from: int, to: int) -> Variant:
    var text := ""
    var i := from
    while i < to:
        var b0 := bytes[i]
        var n := 0
        var cp := 0
        if b0 < 0x80:
            n = 1
            cp = b0
        elif b0 >= 0xC2 and b0 <= 0xDF:
            n = 2
            cp = b0 & 0x1F
        elif b0 >= 0xE0 and b0 <= 0xEF:
            n = 3
            cp = b0 & 0x0F
        elif b0 >= 0xF0 and b0 <= 0xF4:
            n = 4
            cp = b0 & 0x07
        else:
            return null
        if i + n > to:
            return null
        for k in range(1, n):
            var b := bytes[i + k]
            if (b & 0xC0) != 0x80:
                return null
            cp = (cp << 6) | (b & 0x3F)
        if n == 3 and (cp < 0x800 or (cp >= 0xD800 and cp <= 0xDFFF)):
            return null
        if n == 4 and (cp < 0x10000 or cp > 0x10FFFF):
            return null
        text += String.chr(cp)
        i += n
    return text


## Call when the SDK changes its connection ID, then consume a fresh snapshot. Clears the
## objects (raising despawned), properties and outbox, and abandons awaited requests. A
## connection ID of 0, or a call inside receive, is a misuse (returns false).
func reset(new_connection_id: int) -> bool:
    last_error = ""
    if new_connection_id <= 0 or new_connection_id > 0xFFFFFFFF or _receiving:
        _misuse("Reset needs a connection ID (not 0) and is not allowed inside Receive")
        return false
    connection_id = new_connection_id
    room_ready = false
    tick_rate = 0
    clock_state = 0
    _input_count = 0
    master_id = 0
    rules_hash = 0
    _properties.clear()
    # Held packets and awaited requests belong to the previous room.
    _held.clear()
    _clear_objects()
    abandon_requests()
    return true


func _clear_objects() -> void:
    for o in _objects.values():
        if presenter != null:
            presenter.sync_despawned(o)
        despawned.emit(o)
    _objects.clear()


## Applies one packet from the room (its first count bytes; all when count is negative) and
## raises the signals it causes. Not reentrant: do not call it from its handlers. Returns false,
## with last_error, for a packet it cannot apply (Unity's FormatException): the session should
## disconnect. The records before the bad one were applied, as in Unity.
func receive(packet: PackedByteArray, count: int = -1) -> bool:
    last_error = ""
    if _receiving:
        _misuse("Reentrant Receive")
        return false
    if not _input.decode(packet, count):
        last_error = _input.decode_error
        return false
    _receiving = true
    var completed := false
    for i in _input.count:
        var r: Gs2SyncRecord = _input.records[i]
        var o: Gs2NetworkObject = null
        match _input.operation:
            Gs2SyncCodec.Op.SNAPSHOT:
                if r.id != 1:
                    return _malformed("Unsupported schema")
                if r.kind == Gs2SyncCodec.SNAPSHOT_END:
                    room_ready = true
                    completed = true
                    continue
                # A snapshot after a completed one (rejoined) replaces every object and
                # property: held commands no longer apply and the previous session's requests
                # get no answer. Before the first snapshot, or when one restarts before
                # completing (room_ready false), the outbox and its requests are kept: nothing
                # was sent since, so they reach this session.
                if room_ready:
                    _held.clear()
                    abandon_requests()
                room_ready = false
                _clear_objects()
                _properties.clear()
                master_id = r.owner
                rules_hash = r.epoch
                snapshot_started.emit()
                master_changed.emit(master_id)
            Gs2SyncCodec.Op.SPAWN:
                if _objects.has(r.id) or _objects.size() >= MAX_OBJECTS:
                    return _malformed("Duplicate object or capacity exceeded")
                o = Gs2NetworkObject.spawned(r, connection_id)
                _objects[o.id] = o
                if presenter != null:
                    presenter.sync_spawned(o)
                spawned.emit(o)
                if o.confirms_my_spawn():
                    spawn_confirmed.emit(o.request, o)
                    _answer_spawn(o.request, o, Gs2SyncTypes.CommandResult.SUCCESS)
            Gs2SyncCodec.Op.UPDATE:
                o = find(r.id)
                # Unreliable updates may overtake a spawn or trail a despawn.
                if o == null:
                    continue
                if o.has_unknown_fields(r.mask):
                    return _malformed("Unknown field")
                var state := _input.state
                var applied := o.apply_update(r, state)
                if presenter != null:
                    presenter.sync_updated(o, r, state)
                if applied == 0:
                    continue
                o.notify(applied)
                changed.emit(o, applied)
            Gs2SyncCodec.Op.DESPAWN:
                o = find(r.id)
                if o == null:
                    return _malformed("Unknown object")
                _objects.erase(r.id)
                if presenter != null:
                    presenter.sync_despawned(o)
                despawned.emit(o)
            Gs2SyncCodec.Op.CALL:
                if r.id == 0:
                    if presenter != null:
                        presenter.sync_event_received(r.method, r.owner, r.args, r.args_offset, r.args_count)
                    event_received.emit(r.method, r.owner, r.args, r.args_offset, r.args_count)
                    continue
                o = find(r.id)
                if o == null:
                    return _malformed("Unknown RPC object")
                if presenter != null:
                    presenter.sync_rpc_received(o, r.method, r.owner, r.args, r.args_offset, r.args_count)
                rpc_received.emit(o, r.method, r.owner, r.args, r.args_offset, r.args_count)
            Gs2SyncCodec.Op.AUTHORITY:
                o = find(r.id)
                if o != null and r.kind == Gs2SyncCodec.AUTHORITY_GROUP:
                    o.move_to_group(r.owner)
                    group_changed.emit(o)
                    continue
                var describes_a_holder := o != null and r.kind == Gs2SyncCodec.AUTHORITY_STATE and o.kind().has_holder()
                if not describes_a_holder:
                    return _malformed("Unknown authority object")
                if o.apply_authority(r):
                    o.notify_authority()
                authority_changed.emit(o)
            Gs2SyncCodec.Op.RESULT:
                if r.id != 0:
                    o = find(r.id)
                    if o != null:
                        o.notify_command(r.request, r.method)
                    command_completed.emit(r.id, r.request, r.method)
                    _answer_command(r.request, r.method)
                elif r.request != 0:
                    spawn_rejected.emit(r.request, r.method)
                    _answer_spawn(r.request, null, r.method)
                else:
                    rejected.emit(Gs2SyncRejection.new(r.kind, r.owner, r.method))
            Gs2SyncCodec.Op.CLOCK:
                if r.ttl == 0 or r.ttl > MAX_TICK_RATE:
                    return _malformed("Invalid tick rate")
                tick_rate = r.ttl
                clock_state = _input.state
                if presenter != null:
                    presenter.sync_clock_received(r.id, r.ttl, r.request)
                clock_received.emit(r.id, r.ttl, r.request)
            Gs2SyncCodec.Op.ROOM:
                if r.kind == Gs2SyncCodec.ROOM_MASTER:
                    master_id = r.id
                    master_changed.emit(master_id)
                else:
                    var applied_property := _apply_property(r.id, r.args, r.args_offset, r.args_count)
                    if applied_property.is_empty():
                        return _malformed(last_error)
                    var key: String = applied_property[0]
                    var at: int = applied_property[1]
                    var length: int = applied_property[2]
                    if presenter != null:
                        presenter.sync_property_changed(r.id, key, r.args, at, length)
                    property_changed.emit(r.id, r.owner, key, r.args, at, length)
            _:
                return _malformed("Unknown sync operation")
    _receiving = false
    _release_held() # commands made in the handlers (or before the snapshot), in order
    if completed:
        snapshot_completed.emit()
    return true


# A packet the client cannot apply: receive stops (the session disconnects).
func _malformed(message: String) -> bool:
    _receiving = false
    last_error = message
    return false


func _misuse(message: String) -> void:
    last_error = message
    push_error(message)
