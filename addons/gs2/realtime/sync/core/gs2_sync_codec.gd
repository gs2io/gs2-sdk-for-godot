# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Encodes and decodes sync packets (wire version 3), as Unity's SyncCodec. One packet carries
# 1..64 records of one op. Header: 0xd7, 0x30|op, count; the count's high bit is a per-op
# variant flag that encode derives from the records (UPDATE: epoch present; CALL: request
# present; SNAPSHOT: end marker). UPDATE and CLOCK headers continue with the state version.
#
# decode fills the reusable records; a decoded record is valid until the next decode. Errors
# are not thrown: encode returns an empty array and decode false, with the reason in
# last_error (the messages are Unity's).
class_name Gs2SyncCodec
extends RefCounted


## Sync packet operations.
enum Op {
    ## id, prefab, mode, owner, request, epoch, ttl, mask, values.
    SPAWN = 1,
    ## id, [epoch], mask, values.
    UPDATE,
    ## id.
    DESPAWN,
    ## id, method, sender, target, [recipient], [request], argLength, args.
    CALL,
    ## id, kind, owner, epoch, ttl, request.
    AUTHORITY,
    ## id (schema 1), owner (master client).
    SNAPSHOT,
    ## id, request, code.
    RESULT,
    ## kind, id, owner, argLength, args.
    ROOM,
    ## id (tick), epoch (view lag in 1/16 ticks), mask, values.
    INPUT,
    ## id (tick), ttl (ticks per second), request (newest input tick received).
    CLOCK,
}

## Call target byte (RpcTargetByte).
const TARGET_ALL = 0
const TARGET_OTHERS = 1
const TARGET_OWNER = 2
const TARGET_PLAYER = 3
const TARGET_BUFFERED = 0x80

## Authority record kinds (AuthorityKind).
const AUTHORITY_STATE = 0
const AUTHORITY_ACQUIRE = 1
const AUTHORITY_RENEW = 2
const AUTHORITY_RELEASE = 3
const AUTHORITY_TRANSFER = 4
const AUTHORITY_GROUP = 5

## Room record kinds (RoomKind).
const ROOM_MASTER = 1
const ROOM_PROPERTY = 2
const ROOM_INTEREST = 3

## Snapshot record kinds (End is the header's variant flag).
const SNAPSHOT_BEGIN = 0
const SNAPSHOT_END = 1

## Object modes (ObjectMode).
const MODE_PLAYER = 0
const MODE_LEASE = 1
const MODE_SERVER = 2
const MODE_SIMULATED = 3

const MAX_PACKET = 16384
const MAX_RECORDS = 64
const MAX_ARGS = 4096

const _MAGIC = 0xd7
const _VERSION = 0x30
const _VARIANT_BIT = 0x80

## Why the last encode or quantize failed (static calls), or "".
static var last_error := ""

## The decoded packet: valid after decode returns true.
var operation := 0
var count := 0
## State version of the decoded UPDATE or CLOCK packet (0 for other operations).
var state := 0
var records: Array[Gs2SyncRecord] = []
## Why the last decode failed, or "".
var decode_error := ""


func _init() -> void:
    for i in MAX_RECORDS:
        records.append(Gs2SyncRecord.new())


## Whether target is a call target a record may carry.
static func is_valid_target(target: int) -> bool:
    var base_target = target & ~TARGET_BUFFERED
    return target >= 0 and target <= 0xff and base_target <= TARGET_PLAYER and ((target & TARGET_BUFFERED) == 0 or base_target <= TARGET_OTHERS)


## Who receives the call now (the target without the buffered flag).
static func receivers(target: int) -> int:
    return target & ~TARGET_BUFFERED


## Whether the target is followed by a recipient (TARGET_PLAYER).
static func has_recipient(target: int) -> bool:
    return receivers(target) == TARGET_PLAYER


## A valid target that selects its receivers without naming one (all, others, owner).
static func is_unaddressed(target: int) -> bool:
    return is_valid_target(target) and not has_recipient(target)


## Encodes count records of op (all when count is negative) with the state version of UPDATE
## and CLOCK packets (clients send 0). Returns the packet, or an empty array (last_error
## says why) for invalid records or a packet over MAX_PACKET bytes.
static func encode(op: int, packet_state: int, packet_records: Array, record_count: int = -1) -> PackedByteArray:
    last_error = ""
    var n = packet_records.size() if record_count < 0 else record_count
    if not _valid_op(op) or n < 1 or n > MAX_RECORDS or n > packet_records.size():
        last_error = "Invalid sync packet"
        return PackedByteArray()
    var flagged = _flagged(op, packet_records, n)
    var size := _Wire.sizer()
    size.length = 3
    if _has_state(op):
        size.uint_value(packet_state)
    for i in n:
        _layout(size, op, packet_records[i], flagged)
    if size.failed():
        last_error = size.error
        return PackedByteArray()
    if size.length > MAX_PACKET:
        last_error = "Sync packet too large"
        return PackedByteArray()
    var output := _Wire.writer(size.length)
    output.bytes[0] = _MAGIC
    output.bytes[1] = _VERSION | op
    output.bytes[2] = n | (_VARIANT_BIT if flagged else 0)
    output.at = 3
    if _has_state(op):
        output.uint_value(packet_state)
    for i in n:
        _layout(output, op, packet_records[i], flagged)
    return output.bytes


## The encoded size of an UPDATE record, counting its epoch as present (the most it takes
## in a packet).
static func update_size(record: Gs2SyncRecord) -> int:
    var size := _Wire.sizer()
    _layout(size, Op.UPDATE, record, true)
    return size.length


## Decodes the first byte_count bytes of packet (all when negative) into operation, count,
## state and records. Returns false, with decode_error, for a malformed or non-canonical packet.
func decode(packet: PackedByteArray, byte_count: int = -1) -> bool:
    decode_error = ""
    var end = packet.size() if byte_count < 0 else byte_count
    if end < 3 or end > packet.size() or end > MAX_PACKET:
        return _refuse("Invalid sync header")
    if packet[0] != _MAGIC or (packet[1] & 0xf0) != _VERSION:
        return _refuse("Invalid sync header")
    var op = packet[1] & 15
    var record_count = packet[2] & ~_VARIANT_BIT
    var flagged = (packet[2] & _VARIANT_BIT) != 0
    if not _valid_op(op) or record_count < 1 or record_count > MAX_RECORDS:
        return _refuse("Invalid sync header")
    if flagged and not _has_variant(op):
        return _refuse("Invalid sync header")
    var input := _Wire.reader(packet, 3, end)
    var packet_state = 0
    if _has_state(op):
        packet_state = input.uint_value(0)
    for i in record_count:
        var r = records[i]
        r.clear()
        _layout(input, op, r, flagged)
        if input.failed():
            return _refuse(input.error)
        if op == Op.SNAPSHOT:
            r.kind = SNAPSHOT_END if flagged else SNAPSHOT_BEGIN
    if input.failed():
        return _refuse(input.error)
    if input.at != end:
        return _refuse("Trailing sync data")
    # The variant flag is derived from the records; one that none needs is not canonical.
    if flagged != _flagged(op, records, record_count):
        return _refuse("Invalid sync header")
    operation = op
    count = record_count
    state = packet_state
    return true


## value / units_per_step rounded to the nearest int (halves away from zero). A
## non-positive step or a result outside int32 gives 0 with last_error.
static func quantize(value: float, units_per_step: float) -> int:
    last_error = ""
    if is_nan(units_per_step) or is_inf(units_per_step) or units_per_step <= 0:
        last_error = "unitsPerStep"
        return 0
    var v = round(value / units_per_step)
    if is_nan(v) or v < -2147483648.0 or v > 2147483647.0:
        last_error = "value"
        return 0
    return int(v)


# Unsigned varints (7 bits per byte, least significant first), shared with the property
# encoding of the sync client.
static func varint_size(v: int) -> int:
    var n = 1
    while v >= 128:
        n += 1
        v >>= 7
    return n


## Appends v (a uint32) as a varint to bytes (Unity's SyncCodec.Put).
static func append_varint(bytes: PackedByteArray, v: int) -> void:
    while v >= 128:
        bytes.append((v & 127) | 128)
        v >>= 7
    bytes.append(v)


## Reads one canonical varint at bytes[at], before end (Unity's SyncCodec.Get). Returns
## [value, position after it], or [] with last_error (the decoder's messages).
static func read_varint(bytes: PackedByteArray, at: int, end: int) -> Array:
    last_error = ""
    var input := _Wire.reader(bytes, at, mini(end, bytes.size()))
    var v = input._read_varint()
    if input.failed():
        last_error = input.error
        return []
    return [v, input.at]


static func zig(v: int) -> int:
    return ((v << 1) ^ (v >> 31)) & 0xFFFFFFFF


static func unzig(v: int) -> int:
    return (v >> 1) ^ -(v & 1)


func _refuse(message: String) -> bool:
    decode_error = message
    return false


static func _has_state(op: int) -> bool:
    return op == Op.UPDATE or op == Op.CLOCK


static func _has_variant(op: int) -> bool:
    return op == Op.UPDATE or op == Op.CALL or op == Op.SNAPSHOT


static func _valid_op(op: int) -> bool:
    return op >= Op.SPAWN and op <= Op.CLOCK


static func _flagged(op: int, packet_records: Array, n: int) -> bool:
    for i in n:
        if _variant(op, packet_records[i]):
            return true
    return false


static func _variant(op: int, r: Gs2SyncRecord) -> bool:
    match op:
        Op.UPDATE:
            return r.epoch != 0
        Op.CALL:
            return r.request != 0
        Op.SNAPSHOT:
            return r.kind == SNAPSHOT_END
    return false


# A record's fields in wire order, walked by w (measuring, writing or reading). One layout
# for all three, so they cannot disagree.
static func _layout(w: _Wire, op: int, r: Gs2SyncRecord, flagged: bool) -> void:
    if op == Op.ROOM:
        r.kind = w.byte_value(r.kind)
        if r.kind < ROOM_MASTER or r.kind > ROOM_INTEREST:
            w.fail("Invalid room record")
    r.id = w.uint_value(r.id)
    match op:
        Op.SPAWN:
            r.prefab = w.uint_value(r.prefab)
            r.mode = w.byte_value(r.mode)
            if r.mode > MODE_SIMULATED:
                w.fail("Invalid object mode")
            r.owner = w.uint_value(r.owner)
            r.request = w.uint_value(r.request)
            r.epoch = w.uint_value(r.epoch)
            r.ttl = w.uint_value(r.ttl)
            w.fields(r)
        Op.UPDATE:
            if flagged:
                r.epoch = w.uint_value(r.epoch)
            w.fields(r)
        Op.DESPAWN:
            pass
        Op.CALL:
            r.method = w.uint_value(r.method)
            r.owner = w.uint_value(r.owner)
            r.target = w.byte_value(r.target)
            if not is_valid_target(r.target):
                w.fail("Invalid call target")
            if has_recipient(r.target):
                r.recipient = w.uint_value(r.recipient)
            if flagged:
                r.request = w.uint_value(r.request)
            w.arguments(r)
        Op.AUTHORITY:
            r.kind = w.byte_value(r.kind)
            if r.kind > AUTHORITY_GROUP:
                w.fail("Invalid authority kind")
            r.owner = w.uint_value(r.owner)
            r.epoch = w.uint_value(r.epoch)
            r.ttl = w.uint_value(r.ttl)
            r.request = w.uint_value(r.request)
        Op.SNAPSHOT:
            r.owner = w.uint_value(r.owner)
            r.epoch = w.uint_value(r.epoch)
        Op.RESULT:
            r.request = w.uint_value(r.request)
            r.method = w.uint_value(r.method)
            r.kind = w.byte_value(r.kind)
            r.owner = w.uint_value(r.owner)
        Op.ROOM:
            r.owner = w.uint_value(r.owner)
            w.arguments(r)
        Op.INPUT:
            r.epoch = w.uint_value(r.epoch)
            w.fields(r)
        Op.CLOCK:
            r.ttl = w.uint_value(r.ttl)
            r.request = w.uint_value(r.request)
        _:
            w.fail("Invalid sync operation")


# A direction a record is walked in. Each method takes the record's current value and returns
# the value to store: the same when measuring or writing, the decoded one when reading. The
# first failure is kept, and later steps do nothing.
class _Wire:
    extends RefCounted

    const SIZE = 0
    const WRITE = 1
    const READ = 2

    var mode := SIZE
    var length := 0
    var bytes := PackedByteArray()
    var at := 0
    var end := 0
    var error := ""

    static func sizer() -> _Wire:
        return _Wire.new()

    static func writer(size: int) -> _Wire:
        var w := _Wire.new()
        w.mode = WRITE
        w.bytes.resize(size)
        return w

    static func reader(packet: PackedByteArray, from: int, to: int) -> _Wire:
        var w := _Wire.new()
        w.mode = READ
        w.bytes = packet
        w.at = from
        w.end = to
        return w

    func failed() -> bool:
        return error != ""

    func fail(message: String) -> void:
        if error == "":
            error = message

    func uint_value(v: int) -> int:
        if error != "":
            return v
        match mode:
            SIZE:
                if v < 0 or v > 0xFFFFFFFF:
                    fail("Invalid value")
                length += Gs2SyncCodec.varint_size(v)
                return v
            WRITE:
                _write_varint(v)
                return v
        return _read_varint()

    func byte_value(v: int) -> int:
        if error != "":
            return v
        match mode:
            SIZE:
                if v < 0 or v > 0xff:
                    fail("Invalid value")
                length += 1
                return v
            WRITE:
                bytes[at] = v
                at += 1
                return v
        if at >= end:
            fail("Truncated sync packet")
            return 0
        var b = bytes[at]
        at += 1
        return b

    func fields(r: Gs2SyncRecord) -> void:
        if error != "":
            return
        match mode:
            SIZE:
                var m = r.mask
                if m < 0 or m > 0xFFFFFFFF:
                    fail("Invalid value")
                    return
                length += Gs2SyncCodec.varint_size(m)
                var f = 0
                while m != 0:
                    if (m & 1) != 0:
                        length += Gs2SyncCodec.varint_size(Gs2SyncCodec.zig(r.values[f]))
                    f += 1
                    m >>= 1
            WRITE:
                var m = r.mask
                _write_varint(m)
                var f = 0
                while m != 0:
                    if (m & 1) != 0:
                        _write_varint(Gs2SyncCodec.zig(r.values[f]))
                    f += 1
                    m >>= 1
            READ:
                var m = _read_varint()
                r.mask = m
                var values := r.values
                var f = 0
                while m != 0 and error == "":
                    if (m & 1) != 0:
                        values[f] = Gs2SyncCodec.unzig(_read_varint())
                    f += 1
                    m >>= 1
                r.values = values

    # Arguments borrow the packet when reading (no copy).
    func arguments(r: Gs2SyncRecord) -> void:
        if error != "":
            return
        match mode:
            SIZE:
                if r.args_count < 0 or r.args_count > Gs2SyncCodec.MAX_ARGS or r.args_offset < 0 \
                        or (r.args_count > 0 and r.args_offset > r.args.size() - r.args_count):
                    fail("Invalid arguments")
                    return
                length += Gs2SyncCodec.varint_size(r.args_count) + r.args_count
            WRITE:
                _write_varint(r.args_count)
                for i in r.args_count:
                    bytes[at + i] = r.args[r.args_offset + i]
                at += r.args_count
            READ:
                var n = _read_varint()
                if error != "":
                    return
                if n > Gs2SyncCodec.MAX_ARGS or n > end - at:
                    fail("Invalid arguments")
                    return
                r.args = bytes
                r.args_offset = at
                r.args_count = n
                at += n

    func _write_varint(v: int) -> void:
        while v >= 128:
            bytes[at] = (v & 127) | 128
            at += 1
            v >>= 7
        bytes[at] = v
        at += 1

    # Accepts only the canonical (shortest) form.
    func _read_varint() -> int:
        var v = 0
        for i in 5:
            if at >= end:
                fail("Truncated sync packet")
                return 0
            var x = bytes[at]
            at += 1
            if i == 4 and x > 15:
                fail("Varint overflow")
                return 0
            v |= (x & 127) << (7 * i)
            if x < 128:
                if i > 0 and x == 0:
                    fail("Noncanonical varint")
                    return 0
                return v
        fail("Invalid varint")
        return 0
