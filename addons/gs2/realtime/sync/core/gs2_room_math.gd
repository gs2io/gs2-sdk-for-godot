# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The room rules' RoomMath: integer functions the room (in Lua, with the same IEEE double
# operations) and prediction code generated from @predict methods compute identically. Rule
# scripts call them too; there the compiler lowers them to the room's functions.
# A result outside int32, a negative sqrt, a zero denominator or min > max fails the
# prediction (Gs2PredictionRoom.fail) and returns 0, where Unity's RoomMath throws.
class_name Gs2RoomMath
extends RefCounted


## int.MinValue / int.MaxValue of the rules' int32.
const INT32_MIN = -2147483648
const INT32_MAX = 2147483647


## value limited to min_value..max_value; fails when min_value exceeds max_value.
static func clamp(value: int, min_value: int, max_value: int) -> int:
    if min_value > max_value:
        Gs2PredictionRoom.fail("RoomMath.Clamp: min exceeds max")
        return 0
    return min_value if value < min_value else max_value if value > max_value else value


## |value|; fails for int.MinValue.
static func abs(value: int) -> int:
    return Gs2SyncInt.neg(value) if value < 0 else value


## -1, 0 or 1.
static func sign(value: int) -> int:
    return -1 if value < 0 else 1 if value > 0 else 0


## Square root rounded down; fails for a negative value.
static func sqrt(value: int) -> int:
    if value < 0:
        Gs2PredictionRoom.fail("RoomMath.Sqrt of a negative value")
        return 0
    return int(floor(_sqrt(float(value))))


# Each product is its own statement, as in Unity's RoomMath, so the sums round like the room's.
## Length of the vector (x, y), rounded down.
static func length2(x: int, y: int) -> int:
    var xx: float = float(x) * float(x)
    var yy: float = float(y) * float(y)
    var sum: float = xx + yy
    return _to_int32(floor(_sqrt(sum)))


## Length of the vector (x, y, z), rounded down.
static func length3(x: int, y: int, z: int) -> int:
    var xx: float = float(x) * float(x)
    var yy: float = float(y) * float(y)
    var zz: float = float(z) * float(z)
    var sum: float = xx + yy
    sum += zz
    return _to_int32(floor(_sqrt(sum)))


## value * numerator / denominator with the exact (64-bit) product, truncated toward zero.
static func mul_div(value: int, numerator: int, denominator: int) -> int:
    if denominator == 0:
        Gs2PredictionRoom.fail("RoomMath.MulDiv: division by zero")
        return 0
    # Both factors are int32, so the product fits in GDScript's int64.
    var quotient: int = (value * numerator) / denominator
    if not Gs2SyncInt.fits(quotient):
        Gs2PredictionRoom.fail("Arithmetic operation resulted in an overflow (RoomMath.MulDiv)")
        return 0
    return quotient


# Gs2SyncInt calls the engine's sqrt: here the name is this class's own sqrt.
static func _sqrt(value: float) -> float:
    return Gs2SyncInt.sqrt_double(value)


static func _to_int32(value: float) -> int:
    if value < Gs2SyncInt.INT32_MIN or value > Gs2SyncInt.INT32_MAX:
        Gs2PredictionRoom.fail("Arithmetic operation resulted in an overflow (RoomMath)")
        return 0
    return int(value)
