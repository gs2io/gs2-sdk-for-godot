# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The small value types of the sync client (Unity's ObjectMode, LeaseAction, RpcTarget,
# RequestStatus, CommandResult and CommandResults in SyncClient.cs). Their numbers are the
# wire's: keep them equal to Gs2SyncCodec's MODE_* / AUTHORITY_* / TARGET_* constants.
class_name Gs2SyncTypes
extends RefCounted


## How an object is synchronized (see Gs2ObjectKind). PLAYER: a member owns it and writes its
## fields. LEASE: members borrow it. SERVER: the room's rules own it and members interact with
## it. SIMULATED: the rules write the fields every tick; the owner sends inputs.
enum ObjectMode { PLAYER = 0, LEASE = 1, SERVER = 2, SIMULATED = 3 }

## What Gs2SyncClient.lease asks of a leased object (the authority record kinds).
enum LeaseAction { ACQUIRE = 1, RENEW = 2, RELEASE = 3 }

## Receivers of an RPC or room event. OWNER is the object's owner (the caller itself for
## owner-only methods; room events have none). Buffered targets are also replayed to players
## who join later, until the object is removed or the caller leaves. One player is reached
## with rpc_to / raise_event_to instead.
enum RpcTarget { ALL = 0, OTHERS = 1, OWNER = 2, ALL_BUFFERED = 0x80, OTHERS_BUFFERED = 0x81 }

## What became of a request (a spawn, a lease request or an interaction): the room applied it
## (SUCCEEDED) or refused it (REFUSED, with its reason); it never left (NOT_SENT: the outbox was
## full); or this client stopped waiting for it (ABANDONED: reset, a new snapshot after
## rejoining, or abandon_requests) and no answer will come.
enum RequestStatus { PENDING, SUCCEEDED, REFUSED, NOT_SENT, ABANDONED }

## The room's results (0..99). A rule-based room also refuses commands and spawns with the
## rules' own codes (Step.Ignore), from FIRST_RULES_CODE: compare them with the error enum the
## compiler generates with the rules. Results are plain ints, so codes from 100 fit.
enum CommandResult {
    SUCCESS,
    MISSING_OBJECT,
    FORBIDDEN,
    LEASE_BUSY,
    STALE_EPOCH,
    INVALID_OPERATION,
    ALREADY_APPLIED,
    STALE_REQUEST,
    ## A room limit: objects owned, subscriptions, properties, buffered calls, members.
    LIMIT_REACHED,
    ## An RPC the object catalog does not allow this caller.
    METHOD_NOT_ALLOWED,
}

## The lowest code of the rules' own results; lower codes are the room's.
const FIRST_RULES_CODE = 100


## A code of the room's rules (Step.Ignore), not one of the room's own results.
static func is_rules_code(result: int) -> bool:
    return result >= FIRST_RULES_CODE


## The result's name (SUCCESS, ...), or its number for a rules code.
static func result_name(result: int) -> String:
    var key = CommandResult.find_key(result)
    return str(result) if key == null else String(key)


## The status's name (SUCCEEDED, ...).
static func status_name(status: int) -> String:
    var key = RequestStatus.find_key(status)
    return str(status) if key == null else String(key)
