# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# One record of a sync packet (Unity's Record); instances are reused. The uint32 fields hold
# 0..0xFFFFFFFF in GDScript's int. args borrows the received packet until the next decode:
# the record's arguments are args[args_offset, args_offset + args_count).
class_name Gs2SyncRecord
extends RefCounted


var id := 0
var prefab := 0
var owner := 0
var request := 0
var mask := 0
var method := 0
var epoch := 0
var ttl := 0
var recipient := 0
var mode := 0
var kind := 0
var target := 0
var values := PackedInt32Array()
var args := PackedByteArray()
var args_offset := 0
var args_count := 0


func _init() -> void:
    values.resize(32)


## Whether the record carries field (0..31) in mask.
func has(field: int) -> bool:
    return (mask & (1 << field)) != 0


func clear() -> void:
    id = 0
    prefab = 0
    owner = 0
    request = 0
    mask = 0
    method = 0
    epoch = 0
    ttl = 0
    recipient = 0
    mode = 0
    kind = 0
    target = 0
    args = PackedByteArray()
    args_offset = 0
    args_count = 0
    values.fill(0)


## The record's arguments, copied.
func arguments() -> PackedByteArray:
    if args_count == 0:
        return PackedByteArray()
    return args.slice(args_offset, args_offset + args_count)


## Sets the arguments to all of data.
func set_arguments(data: PackedByteArray) -> void:
    args = data
    args_offset = 0
    args_count = data.size()


## A copy of the record (its arguments still share the same packet).
func duplicate_record() -> Gs2SyncRecord:
    var copy := Gs2SyncRecord.new()
    copy.copy_from(self)
    return copy


func copy_from(other: Gs2SyncRecord) -> void:
    id = other.id
    prefab = other.prefab
    owner = other.owner
    request = other.request
    mask = other.mask
    method = other.method
    epoch = other.epoch
    ttl = other.ttl
    recipient = other.recipient
    mode = other.mode
    kind = other.kind
    target = other.target
    values = other.values.duplicate()
    args = other.args
    args_offset = other.args_offset
    args_count = other.args_count
