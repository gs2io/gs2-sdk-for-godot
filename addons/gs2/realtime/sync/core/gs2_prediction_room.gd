# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The room API seen by prediction code generated from @predict rule methods
# (godot/<rules>_prediction.gd), as Unity's PredictionRoom. Valid only while a world predicts:
# reads see the room's latest confirmed state plus this prediction's own writes, and writes
# never leave the client.
#
# GDScript has no exceptions, so a failure (an unknown object, an overflow in Gs2SyncInt, ...)
# is recorded with fail(): every call then returns 0 / false, the generated code returns as
# soon as failed() is true, and the world reads the failure from end() and stops predicting,
# as Unity does when a prediction throws.
#
# The host (the world) implements:
#   _prediction_get(object_id, field) -> int
#   _prediction_set(object_id, field, value) -> void
#   _prediction_input(object_id, field) -> int
#   _prediction_spawn_owned(prefab, owner_object_id, x, y, z) -> int
#   _prediction_despawn(object_id) -> void
#   _prediction_prefab_of(object_id) -> int
#   _prediction_owner_of(object_id) -> int
#   _prediction_find_owned(prefab, connection_id) -> int
#   _prediction_exists(object_id) -> bool
#   _prediction_objects(prefab) -> Array[int]
# and calls Gs2PredictionRoom.fail for what Unity's NetworkWorld throws.
#
# The generated code (GdScriptPredictionEmitter) does every int32 operation with Gs2SyncInt and
# RoomMath with Gs2RoomMath (both fail the run like the room's checked arithmetic), checks
# failed() after each statement and at the top of each loop iteration, and registers itself
# with world.expect_rules(hash) and world.register_prediction(prefab, step(object_id, tick)).
class_name Gs2PredictionRoom
extends RefCounted


const NOT_PREDICTING = "Gs2PredictionRoom is only available while Gs2NetworkWorld predicts"

static var _host: Object = null
static var _failure := ""


## Starts a prediction run on host. Called by the world.
static func begin(host: Object) -> void:
    _host = host
    _failure = ""


## Ends the run and returns its failure ("" when it succeeded). Called by the world.
static func end() -> String:
    var failure = _failure
    _host = null
    _failure = ""
    return failure


## Whether this run is in progress.
static func is_predicting() -> bool:
    return _host != null


## Whether this run has failed: generated code returns at once.
static func failed() -> bool:
    return _failure != ""


## Why this run failed ("" when it has not).
static func failure() -> String:
    return _failure


## Fails this run (the first failure is kept). Outside a run, reports the error instead.
static func fail(message: String) -> void:
    if _host == null:
        push_error(message)
        return
    if _failure == "":
        _failure = message


## The object's field value in this prediction (Room.Get).
static func get_field(object_id: int, field: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_get(object_id, field)


## Sets the object's field for the rest of this prediction, never sent (Room.Set).
static func set_field(object_id: int, field: int, value: int) -> void:
    if not _usable():
        return
    _host._prediction_set(object_id, field, value)


## This client's input for the predicted tick on its own objects; other members' inputs are
## unknown to clients and read as 0 (Room.Input).
static func input(object_id: int, field: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_input(object_id, field)


## The input clamped to min_value..max_value (Room.Input with a range, or an @input_range
## slot). Fails when min_value exceeds max_value, as RoomMath.Clamp.
static func input_clamped(object_id: int, field: int, min_value: int, max_value: int) -> int:
    var value = input(object_id, field)
    if failed():
        return 0
    if min_value > max_value:
        fail("RoomMath.Clamp: min exceeds max")
        return 0
    return clampi(value, min_value, max_value)


## A predicted spawn: a local object ID (negative), shown at once when this client owns it;
## the room's object with the same spawn key takes over its instance (Room.SpawnOwned).
static func spawn_owned(prefab: int, owner_object_id: int, x: int, y: int, z: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_spawn_owned(prefab, owner_object_id, x, y, z)


## Removes the object for the rest of this prediction (Room.Despawn).
static func despawn(object_id: int) -> void:
    if not _usable():
        return
    _host._prediction_despawn(object_id)


## The object's prefab ID (Room.PrefabOf, and Room.Is in predicted code).
static func prefab_of(object_id: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_prefab_of(object_id)


## The object's owner or lease holder (Room.OwnerOf; 0: none).
static func owner_of(object_id: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_owner_of(object_id)


## The prefab's first object owned (or leased) by the connection (Room.FindOwned), or 0.
static func find_owned(prefab: int, connection_id: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_find_owned(prefab, connection_id)


## Whether the ID names an object (Room.Exists): false for 0 and removed objects.
static func exists(object_id: int) -> bool:
    if not _usable():
        return false
    return _host._prediction_exists(object_id)


## Number of the prefab's objects: those known to this client in ascending ID order, followed
## by the objects spawned by this prediction (Room.ObjectCount).
static func object_count(prefab: int) -> int:
    if not _usable():
        return 0
    return _host._prediction_objects(prefab).size()


## The prefab's object at index (0..object_count - 1), in object_count's order (Room.ObjectAt).
static func object_at(prefab: int, index: int) -> int:
    if not _usable():
        return 0
    var ids: Array = _host._prediction_objects(prefab)
    if index < 0 or index >= ids.size():
        fail("Index was out of range (object_at %d of %d)" % [index, ids.size()])
        return 0
    return Gs2SyncInt.i32(ids[index])


static func _usable() -> bool:
    if _host == null:
        push_error(NOT_PREDICTING)
        return false
    return _failure == ""
