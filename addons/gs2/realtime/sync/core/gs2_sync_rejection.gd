# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# A command the room refused (Unity's Rejection): which (its op and the ID its record named: an
# object, a group, a member or a property scope) and why.
class_name Gs2SyncRejection
extends RefCounted


## The refused command's Gs2SyncCodec.Op.
var command := 0
## The ID the command's record named.
var target := 0
## Why (a Gs2SyncTypes.CommandResult, or a rules code from 100).
var reason := 0


func _init(refused_command: int = 0, refused_target: int = 0, refusal: int = 0) -> void:
    command = refused_command
    target = refused_target
    reason = refusal


func _to_string() -> String:
    var op = Gs2SyncCodec.Op.find_key(command)
    return "%s (%d): %s" % [str(command) if op == null else String(op), target, Gs2SyncTypes.result_name(reason)]
