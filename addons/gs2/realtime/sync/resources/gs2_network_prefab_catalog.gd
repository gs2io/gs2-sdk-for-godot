# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# A reusable list of prefab entries (Unity's NetworkPrefabCatalog): id -> PackedScene. Assign it
# to a Gs2NetworkWorld's catalog; problems() lists what is wrong with its entries (Unity logs
# them from OnValidate; the Inspector warnings are R2-8).
class_name Gs2NetworkPrefabCatalog
extends Resource


## The prefab entries.
@export var prefabs: Array[Gs2NetworkPrefabEntry] = []


## A catalog of these entries (for code).
static func create(entries: Array) -> Gs2NetworkPrefabCatalog:
    var catalog := Gs2NetworkPrefabCatalog.new()
    var list: Array[Gs2NetworkPrefabEntry] = []
    for entry in entries:
        list.append(entry)
    catalog.prefabs = list
    return catalog


## What is wrong with this catalog's entries (see problems_of); empty when all are usable.
func problems() -> Array[String]:
    return problems_of(prefabs)


## Describes what is wrong with prefab entries: IDs that are 0 or repeated, missing scenes or
## Gs2NetworkEntity nodes, and schemas generated for another prefab ID. Empty when all entries
## are usable. Unity's NetworkWorld.Problems; each scene is instantiated once and freed.
static func problems_of(entries: Array) -> Array[String]:
    var found: Array[String] = []
    var seen := {}
    for entry in entries:
        if entry == null:
            continue
        if entry.id == 0:
            found.append("an entry has prefab ID 0")
        elif seen.has(entry.id):
            found.append("prefab ID %d is used more than once" % entry.id)
        else:
            seen[entry.id] = true
        var contents: Dictionary = entry.inspect()
        if contents.is_empty():
            found.append("prefab ID %d has no prefab" % entry.id)
            continue
        if not contents.entity:
            found.append("%s needs a Gs2NetworkEntity child of its root" % contents.name)
            continue
        var schema: Gs2NetworkSchema = contents.schema
        if schema != null and schema.prefab != entry.id:
            found.append("%s (ID %d) uses schema %s, generated for prefab %d" % [contents.name, entry.id, schema.display_name(), schema.prefab])
    return found
