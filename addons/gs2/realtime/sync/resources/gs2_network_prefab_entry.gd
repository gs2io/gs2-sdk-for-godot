# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# A network prefab (a PackedScene) and the prefab ID the room uses for it (Unity's
# NetworkWorld.PrefabEntry). The scene's root holds a Gs2NetworkEntity as a direct child (the
# MultiplayerSynchronizer layout, D1).
class_name Gs2NetworkPrefabEntry
extends Resource


## The room's prefab ID (not 0).
@export var id := 1
## The prefab.
@export var scene: PackedScene


## An entry (for code; the Inspector edits the exported members).
static func create(prefab_id: int, prefab_scene: PackedScene) -> Gs2NetworkPrefabEntry:
    var entry := Gs2NetworkPrefabEntry.new()
    entry.id = prefab_id
    entry.scene = prefab_scene
    return entry


## True when the entry has a prefab ID other than 0 and a scene.
func is_complete() -> bool:
    return id != 0 and scene != null


## The Gs2NetworkEntity of a prefab instance: a direct child of its root (D1); null when it has
## none.
static func entity_of(root: Node) -> Gs2NetworkEntity:
    if root == null:
        return null
    for child in root.get_children():
        if child is Gs2NetworkEntity:
            return child
    return null


## What the scene holds, read from an instance freed at once: {name: the root's name, entity:
## whether a Gs2NetworkEntity is a child of the root, schema: its Gs2NetworkSchema or null}.
## Empty when there is no scene or it does not instantiate.
func inspect() -> Dictionary:
    if scene == null:
        return {}
    var root := scene.instantiate()
    if root == null:
        return {}
    var entity := entity_of(root)
    var result := {name = String(root.name), entity = entity != null, schema = entity.schema if entity != null else null}
    root.free()
    return result
