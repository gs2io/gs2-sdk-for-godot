# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The fields of one prefab (Unity's NetworkSchema), generated from the room's rules as a
# .realtimeschema (JSON) file: from_json reads one. A client resource, never sent on the wire;
# assign it to Gs2NetworkEntity.schema.
#
# Errors (D2): validate / initialize return -1 / false with last_error (Unity throws
# InvalidOperationException); from_json returns null with Gs2NetworkSchema.parse_error (Unity's
# importer throws InvalidDataException).
class_name Gs2NetworkSchema
extends Resource


const ValueType = Gs2NetworkSchemaField.ValueType

## The largest finite float32 (a FLOAT field's precision * int.MinValue must stay finite).
const _FLOAT32_MAX = 3.4028234663852886e38
const _RULE_DEFINED_MODES = ["server", "lease", "simulated"]

## Why the last from_json failed, or "".
static var parse_error := ""

## The schema's name (the rules' prefab type, e.g. "EnemyState"; Unity's asset name).
@export var schema_name := ""
## The prefab ID the schema was generated for.
@export var prefab := 0
## True when the room rules define the prefab (define_server_prefab, define_leased_prefab,
## define_simulated_prefab, ...), not the object catalog.
@export var rule_defined := false
## The rules this schema was generated from (the world compares it with the room's): the first
## 4 bytes of the SHA-256 of the GSL as a uint32; 0 when unknown.
@export var rules := 0
## The fields (Unity's Fields).
@export var fields: Array[Gs2NetworkSchemaField] = []

## Why the last validate / initialize failed, or "".
var last_error := ""


## Reads a .realtimeschema document (formatVersion 1); null with parse_error when it is not a
## valid one. The precision travels as the bits of a float32 (precisionBits) and is restored
## exactly (encode_s32 -> decode_float).
static func from_json(text: String) -> Gs2NetworkSchema:
    parse_error = ""
    var json := JSON.new()
    if json.parse(text) != OK or typeof(json.data) != TYPE_DICTIONARY:
        return _invalid("Invalid realtime schema")
    var document: Dictionary = json.data
    if _integer(document.get("formatVersion")) != 1 or typeof(document.get("fields")) != TYPE_ARRAY:
        return _invalid("Invalid realtime schema")
    var mode = document.get("mode", "")
    if mode == null:
        mode = ""
    if typeof(mode) != TYPE_STRING:
        return _invalid("Invalid prefab mode: " + str(mode))
    var is_rule_defined: bool = mode != ""
    if is_rule_defined and not _RULE_DEFINED_MODES.has(mode):
        return _invalid("Invalid prefab mode: " + mode)
    var defaults = document.get("defaults", [])
    if defaults == null:
        defaults = []
    if typeof(defaults) != TYPE_ARRAY:
        return _invalid("Invalid realtime schema")
    var parsed: Array[Gs2NetworkSchemaField] = []
    for value in document["fields"]:
        if typeof(value) != TYPE_DICTIONARY:
            return _invalid("Invalid field type")
        var type := _value_type(value.get("type"))
        if type < 0:
            return _invalid("Invalid field type")
        var name = value.get("name")
        var field_slot = _integer(value.get("slot"))
        var bits = _integer(value.get("precisionBits"))
        if typeof(name) != TYPE_STRING or field_slot == null or bits == null or bits < -2147483648 or bits > 2147483647:
            return _invalid("Invalid network field")
        var field := Gs2NetworkSchemaField.create(name, field_slot, type, _float32_of_bits(bits))
        for initial in defaults:
            if typeof(initial) == TYPE_DICTIONARY and _integer(initial.get("slot")) == field_slot:
                var default_value = _integer(initial.get("value"))
                if default_value == null:
                    return _invalid("Invalid realtime schema")
                field.has_default = true
                field.default_value = default_value
                break
        parsed.append(field)
    var rules_hash := 0
    var hex = document.get("rules", "")
    if hex == null:
        hex = ""
    if typeof(hex) != TYPE_STRING:
        return _invalid("Invalid rules hash")
    if hex != "":
        if hex.length() > 8 or not hex.is_valid_hex_number(false):
            return _invalid("Invalid rules hash")
        rules_hash = hex.hex_to_int()
    var prefab_id = _integer(document.get("prefab"))
    var name = document.get("name", "")
    var schema := Gs2NetworkSchema.new()
    if not schema.initialize(prefab_id if prefab_id != null else 0, parsed, is_rule_defined, rules_hash):
        return _invalid(schema.last_error)
    schema.schema_name = name if typeof(name) == TYPE_STRING else ""
    return schema


## Reads a .realtimeschema file (see from_json); null with parse_error.
static func load_json(path: String) -> Gs2NetworkSchema:
    var text := FileAccess.get_file_as_string(path)
    if text == "" and FileAccess.get_open_error() != OK:
        parse_error = "Cannot read " + path
        return null
    return from_json(text)


static func _invalid(message: String) -> Gs2NetworkSchema:
    parse_error = message
    return null


# A JSON number that is an integer, as an int; null otherwise.
static func _integer(value: Variant) -> Variant:
    if typeof(value) == TYPE_INT:
        return value
    if typeof(value) == TYPE_FLOAT and is_finite(value) and value == floor(value) and absf(value) < 9.0e15:
        return int(value)
    return null


static func _value_type(value: Variant) -> int:
    match value:
        "Int":
            return ValueType.INT
        "Bool":
            return ValueType.BOOL
        "Float":
            return ValueType.FLOAT
    return -1


## The float32 whose bits are bits (an int32), as a float (C#'s BitConverter.Int32BitsToSingle).
static func _float32_of_bits(bits: int) -> float:
    var bytes := PackedByteArray()
    bytes.resize(4)
    bytes.encode_s32(0, bits)
    return bytes.decode_float(0)


## value rounded to the nearest float32 (C#'s (float)value).
static func float32(value: float) -> float:
    var bytes := PackedByteArray()
    bytes.resize(4)
    bytes.encode_float(0, value)
    return bytes.decode_float(0)


## The name messages use: schema_name, or the resource file's name.
func display_name() -> String:
    if schema_name != "":
        return schema_name
    if resource_path != "":
        return resource_path.get_file().get_basename()
    return "schema of prefab %d" % prefab


## Fills the schema (as the importer does); false with last_error when it is not valid (see
## validate). Unity's Initialize.
func initialize(prefab_id: int, schema_fields: Array, is_rule_defined: bool = false, rules_hash: int = 0) -> bool:
    prefab = prefab_id
    rule_defined = is_rule_defined
    rules = rules_hash & 0xFFFFFFFF
    var copy: Array[Gs2NetworkSchemaField] = []
    for field in schema_fields:
        copy.append(field)
    fields = copy
    if validate() < 0:
        push_error(last_error)
        return false
    return true


## Writes the default wire value of each field that has one into values (32 entries, indexed by
## slot), as the room does on spawn; returns the result (a copy).
func apply_defaults(values: PackedInt32Array) -> PackedInt32Array:
    var result := values.duplicate()
    for field in fields:
        if field != null and field.has_default and field.slot >= 0 and field.slot < result.size():
            result[field.slot] = field.default_value
    return result


## The field with this name; null when none.
func find(name: String) -> Gs2NetworkSchemaField:
    for field in fields:
        if field != null and field.field_name == name:
            return field
    return null


## The schema's fields, or the standard position and rotation fields when schema is null.
static func fields_of(schema: Gs2NetworkSchema) -> Array[Gs2NetworkSchemaField]:
    return Gs2NetworkStandardFields.fields() if schema == null else schema.fields


## find in the schema, or in the standard fields when schema is null.
static func resolve(schema: Gs2NetworkSchema, name: String) -> Gs2NetworkSchemaField:
    return Gs2NetworkStandardFields.find(name) if schema == null else schema.find(name)


## True when this schema matches the object's prefab and the fields the room enabled.
func describes(o: Gs2NetworkObject) -> bool:
    return prefab == o.prefab and validate() == o.fields


# FLOAT: a positive step whose int range stays finite (in float32). Other types: 1.
static func _valid_precision(field: Gs2NetworkSchemaField) -> bool:
    var p := field.precision
    if field.type != ValueType.FLOAT:
        return p == 1.0
    return p > 0.0 and is_finite(p) and p * 2147483648.0 <= _FLOAT32_MAX


## Checks the prefab ID, names, slots, types and precisions; returns the slot bit mask of the
## fields, or -1 with last_error when invalid (Unity throws InvalidOperationException).
func validate() -> int:
    last_error = ""
    if prefab <= 0 or prefab > 0xFFFFFFFF or fields.is_empty() or fields.size() > 32:
        last_error = "Invalid network schema"
        return -1
    var mask := 0
    var names := {}
    for field in fields:
        if field == null or field.field_name == "" or names.has(field.field_name):
            last_error = "Invalid network field"
            return -1
        names[field.field_name] = true
        if field.slot < 0 or field.slot > 31 or (mask & (1 << field.slot)) != 0:
            last_error = "Invalid network field"
            return -1
        if field.type < ValueType.INT or field.type > ValueType.FLOAT:
            last_error = "Invalid network field"
            return -1
        if not _valid_precision(field):
            last_error = "Invalid field precision"
            return -1
        mask |= 1 << field.slot
    return mask
