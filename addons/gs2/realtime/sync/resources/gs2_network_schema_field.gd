# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# One synchronized field of a Gs2NetworkSchema (Unity's NetworkSchema.Field): name, slot (0..31),
# value type and precision, and the default value a rule-defined prefab starts with. Treat the
# fields of a schema in use as read-only.
class_name Gs2NetworkSchemaField
extends Resource


## The value type of a field (Unity's NetworkValueType). FLOAT values travel as ints scaled by
## precision.
enum ValueType { INT, BOOL, FLOAT }

## The field's name (the rules' field name in PascalCase, e.g. "PositionX").
@export var field_name := ""
## The field's slot (0..31) in the object's values.
@export_range(0, 31) var slot := 0
## The value type.
@export var type: ValueType = ValueType.INT
## Step of a FLOAT field (wire value * precision = value); 1 for other types.
@export var precision := 1.0
## True when objects of a rule-defined prefab start with default_value (the wire value of the
## rules' default); otherwise they start with 0.
@export var has_default := false
## The default wire value (see has_default).
@export var default_value := 0


## A field (Unity's Field(name, slot, type, precision)).
static func create(name: String, field_slot: int, value_type: ValueType, step: float = 1.0) -> Gs2NetworkSchemaField:
    var field := Gs2NetworkSchemaField.new()
    field.field_name = name
    field.slot = field_slot
    field.type = value_type
    field.precision = step
    return field


## A field with a default wire value (Unity's Field(name, slot, type, precision, defaultValue)).
static func with_default(name: String, field_slot: int, value_type: ValueType, step: float, initial: int) -> Gs2NetworkSchemaField:
    var field := create(name, field_slot, value_type, step)
    field.has_default = true
    field.default_value = initial
    return field


## The type's name as the .realtimeschema writes it ("Int", "Bool", "Float").
static func type_name(value_type: int) -> String:
    match value_type:
        ValueType.INT:
            return "Int"
        ValueType.BOOL:
            return "Bool"
        ValueType.FLOAT:
            return "Float"
    return str(value_type)
