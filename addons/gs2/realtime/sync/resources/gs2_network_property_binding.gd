# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Shows a synchronized field on a node when it changes (Unity's NetworkPropertyBinding, whose
# UnityEvents become a property or a method here): the entity converts the field's wire value
# by its type (int, bool, or float scaled by the precision) and sets property or calls method
# on the target node. Gs2NetworkEntity.field_changed reports the same changes as a signal.
class_name Gs2NetworkPropertyBinding
extends Resource


## The field's name in the entity's schema (or a standard field without one).
@export var field := ""
## The node to update, relative to the entity node; empty means the entity's target (its parent
## by default).
@export var target: NodePath
## The property to set (set_indexed, so "scale:x" works); empty when method is used.
@export var property: StringName
## The method to call with the value; empty when property is used.
@export var method: StringName


## A binding (for code).
static func create(field_name: String, node: NodePath = NodePath(), property_name: StringName = &"", method_name: StringName = &"") -> Gs2NetworkPropertyBinding:
    var binding := Gs2NetworkPropertyBinding.new()
    binding.field = field_name
    binding.target = node
    binding.property = property_name
    binding.method = method_name
    return binding


## The value a field's wire value stands for: an int, a bool, or a float scaled by precision.
static func value_of(definition: Gs2NetworkSchemaField, wire: int) -> Variant:
    match definition.type:
        Gs2NetworkSchemaField.ValueType.BOOL:
            return wire != 0
        Gs2NetworkSchemaField.ValueType.FLOAT:
            return wire * definition.precision
    return wire


## For the entity: shows value on node.
func publish(node: Node, value: Variant) -> void:
    if node == null:
        return
    if method != &"":
        node.call(method, value)
    if property != &"":
        node.set_indexed(NodePath(String(property)), value)
