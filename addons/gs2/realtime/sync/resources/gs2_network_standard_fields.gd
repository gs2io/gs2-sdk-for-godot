# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The built-in position and rotation fields (slots 0..5) every object has without a schema
# (Unity's NetworkStandardFields). A fixed wire contract shared with the room's RoomSync /
# RoomFields; the precisions are Unity's float32 values.
class_name Gs2NetworkStandardFields
extends RefCounted


## Slot bit masks of the position, rotation, and both.
const POSITION_MASK = 7
const ROTATION_MASK = 56
const TRANSFORM_MASK = 63
## Quantization step of the rotation, in degrees (360 / 4096, exact in float32).
const ROTATION_PRECISION = 360.0 / 4096

static var _fields: Array[Gs2NetworkSchemaField] = []


## Quantization step of the position, in units: float32 0.01 (Unity's .01f).
static func position_precision() -> float:
    return Gs2NetworkSchema.float32(0.01)


## The standard fields (shared instances: do not modify them).
static func fields() -> Array[Gs2NetworkSchemaField]:
    if _fields.is_empty():
        var position := position_precision()
        var list: Array[Gs2NetworkSchemaField] = []
        for axis in 3:
            list.append(Gs2NetworkSchemaField.create("Position" + "XYZ"[axis], axis, Gs2NetworkSchemaField.ValueType.FLOAT, position))
        for axis in 3:
            list.append(Gs2NetworkSchemaField.create("Rotation" + "XYZ"[axis], 3 + axis, Gs2NetworkSchemaField.ValueType.FLOAT, ROTATION_PRECISION))
        _fields = list
    return _fields


## The standard field with this name; null when none.
static func find(name: String) -> Gs2NetworkSchemaField:
    for field in fields():
        if field.field_name == name:
            return field
    return null
