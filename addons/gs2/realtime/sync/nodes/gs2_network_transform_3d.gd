# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Synchronizes a Node3D's global position and rotation (Unity's NetworkTransform): a child of
# the prefab's root next to its Gs2NetworkEntity, moving target (the root by default). See
# Gs2NetworkTransform for the roles (owner, remote, predicted).
#
# Fields: global_position.x / .y / .z travel as PositionX / Y / Z (slots 0..2 without a schema)
# and the global rotation as RotationX / Y / Z (slots 3..5): Euler angles in degrees in Godot's
# YXZ order (Node3D's default rotation_order; EULER_ORDER_YXZ), whatever the target's own
# rotation_order. Unity uses ZXY; both clients of a room are Godot (decision 2), so rules that
# read rotations see YXZ angles. With all three rotation axes the rotation is interpolated as a
# quaternion; with some of them, per axis. The target's scale is kept.
class_name Gs2NetworkTransform3D
extends Gs2NetworkTransform


## Synchronized position axes. Set before binding.
@export_flags("X", "Y", "Z") var position_axes := 7:
    set(value):
        position_axes = value & 7
## Synchronized rotation axes. Set before binding.
@export_flags("X", "Y", "Z") var rotation_axes := 7:
    set(value):
        rotation_axes = value & 7


func _position_axes() -> int:
    return position_axes & 7


func _rotation_axes() -> int:
    return rotation_axes & 7


func _whole_rotation() -> bool:
    return (rotation_axes & 7) == 7


func _accepts(node: Node) -> bool:
    return node is Node3D


func _target_kind() -> String:
    return "Node3D"


# The pose in world space; outside the tree (an instance being spawned, before the world adds
# it) the node's own transform, which becomes its world pose under the world's origin.
func _transform(node: Node) -> Transform3D:
    var body := node as Node3D
    return body.global_transform if body.is_inside_tree() else body.transform


func _set_transform(node: Node, value: Transform3D) -> void:
    var body := node as Node3D
    if body.is_inside_tree():
        body.global_transform = value
    else:
        body.transform = value


func _get_position(node: Node) -> Vector3:
    return _transform(node).origin


func _set_position(node: Node, position: Vector3) -> void:
    var value := _transform(node)
    value.origin = position
    _set_transform(node, value)


func _get_quaternion(node: Node) -> Quaternion:
    return _transform(node).basis.get_rotation_quaternion()


func _set_quaternion(node: Node, rotation: Quaternion) -> void:
    var value := _transform(node)
    value.basis = Basis(rotation.normalized()) * Basis.from_scale(value.basis.get_scale())
    _set_transform(node, value)


func _get_euler(node: Node) -> Vector3:
    return euler_degrees_of(_get_quaternion(node))


func _set_euler(node: Node, euler: Vector3) -> void:
    _set_quaternion(node, _quaternion_of(euler))


func _quaternion_of(euler: Vector3) -> Quaternion:
    return quaternion_of_degrees(euler)


## The YXZ Euler angles (degrees, each 0..360) of a rotation.
static func euler_degrees_of(rotation: Quaternion) -> Vector3:
    var e := rotation.get_euler(EULER_ORDER_YXZ)
    return Vector3(fposmod(rad_to_deg(e.x), 360.0), fposmod(rad_to_deg(e.y), 360.0), fposmod(rad_to_deg(e.z), 360.0))


## The rotation of YXZ Euler angles in degrees.
static func quaternion_of_degrees(euler: Vector3) -> Quaternion:
    return Quaternion.from_euler(Vector3(deg_to_rad(euler.x), deg_to_rad(euler.y), deg_to_rad(euler.z)))


func _spawn_pose(position: Variant, rotation: Variant) -> Variant:
    var p := Vector3.ZERO
    if position is Vector3:
        p = position
    elif position != null:
        last_error = "A 3D spawn position is a Vector3"
        return null
    var q := Quaternion.IDENTITY
    if rotation is Quaternion:
        q = rotation
    elif rotation is Basis:
        q = (rotation as Basis).get_rotation_quaternion()
    elif rotation is Vector3:
        q = Quaternion.from_euler(rotation) # radians, as Node3D.rotation
    elif rotation != null:
        last_error = "A 3D spawn rotation is a Quaternion, a Basis or Euler angles in radians (Vector3)"
        return null
    return [p, euler_degrees_of(q)]
