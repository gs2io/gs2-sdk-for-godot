# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The shared part of Gs2NetworkTransform2D and Gs2NetworkTransform3D (Unity's NetworkTransform):
# synchronizes a node's global position and rotation through the entity's float fields
# PositionX/Y/Z and RotationX/Y/Z (degrees), quantized with the schema's precision (the
# standard fields without a schema). The owner writes its pose every world update; other
# clients show the received poses (between timestamped samples InterpolationDelay behind the
# server clock when the world receives server timestamps, else approached at a rate); objects
# this client predicts show the prediction, fading corrections out.
#
# Layout (D1): a child of the prefab's root, next to its Gs2NetworkEntity; it acts on target
# (the root by default). The entity calls _network_bind / _network_unbind / _network_tick; the
# world calls _network_spawn_values (spawn values from a position and rotation) and
# _show_unbound (a predicted spawn not bound yet).
#
# Axes are 3-bit masks (1: X, 2: Y, 4: Z); set them before binding (fields are resolved at
# bind). The subclasses map the pose of their node type to these axes.
#
# Errors (D2): _network_bind and _network_spawn_values return false with last_error (Unity
# throws ArgumentException).
class_name Gs2NetworkTransform
extends Node


const _ALL = 0xFFFFFFFF
const _MAX_SAMPLES = 32

## The node this transform moves (the prefab's root by default).
@export var target: NodePath = NodePath("..")
## Without server timestamps, how fast remote objects approach the received pose, per second
## (0 = jump).
@export_range(0.0, 100.0, 0.1, "or_greater") var interpolation := 20.0:
    set(value):
        interpolation = maxf(0.0, value)
## Remote objects farther than this from the received position jump instead of interpolating
## (0 = never). A predicted object's correction larger than it is a teleport, not faded.
@export_range(0.0, 1000.0, 0.01, "or_greater") var teleport_distance := 0.0:
    set(value):
        teleport_distance = maxf(0.0, value)
## With server timestamps, remote objects show the pose from this many seconds ago,
## interpolated between received updates. Keep it equal to the world's view_delay.
@export_range(0.0, 2.0, 0.01, "or_greater") var interpolation_delay := 0.1:
    set(value):
        interpolation_delay = maxf(0.0, value)
## Time constant (seconds) over which a predicted object's correction by the room fades out
## (0 = jump).
@export_range(0.0, 2.0, 0.01, "or_greater") var correction_time := 0.1:
    set(value):
        correction_time = maxf(0.0, value)

## The bound room object, or null while unbound. Unity's Object.
var network_object: Gs2NetworkObject:
    get: return _state
    set(_v): push_error("network_object is read-only")
## The client this transform is bound through, or null while unbound. Unity's Session.
var client: Gs2SyncClient:
    get: return _client
    set(_v): push_error("client is read-only")
## Why the last bind or spawn-value fill failed, or "".
var last_error := ""

var _client: Gs2SyncClient = null
var _state: Gs2NetworkObject = null
var _world: Gs2NetworkWorld = null
var _slots := PackedInt32Array([0, 0, 0, 0, 0, 0]) # position X/Y/Z, rotation X/Y/Z
var _units := PackedFloat64Array([1, 1, 1, 1, 1, 1])
# The room's latest pose of the object.
var _target_position := Vector3.ZERO
var _target_euler := Vector3.ZERO
# Remote motion: timestamped samples (oldest first).
var _samples: Array[_Sample] = []
# Predicted motion: the fading offsets of the latest corrections.
var _position_error := Vector3.ZERO
var _euler_error := Vector3.ZERO
# Fields of an unbound instance (a predicted spawn): 6 entries, null for an axis not synced.
var _unbound: Array = []


class _Sample:
    extends RefCounted
    var time := 0.0
    var position := Vector3.ZERO
    var euler := Vector3.ZERO
    var cut := false # reached by a teleport: do not blend into it


# ---- What the subclasses provide ----

## Synchronized position axes (bits 1: X, 2: Y, 4: Z).
func _position_axes() -> int:
    return 0


## Synchronized rotation axes (bits 1: X, 2: Y, 4: Z).
func _rotation_axes() -> int:
    return 0


## True when the rotation is interpolated as a whole (a quaternion) rather than per axis.
func _whole_rotation() -> bool:
    return false


## Whether node is a target this transform can move.
func _accepts(_node: Node) -> bool:
    return false


func _target_kind() -> String:
    return "Node"


func _get_position(_node: Node) -> Vector3:
    return Vector3.ZERO


func _set_position(_node: Node, _position: Vector3) -> void:
    pass


## Euler angles in degrees.
func _get_euler(_node: Node) -> Vector3:
    return Vector3.ZERO


func _set_euler(_node: Node, _euler: Vector3) -> void:
    pass


func _get_quaternion(_node: Node) -> Quaternion:
    return Quaternion.IDENTITY


func _set_quaternion(_node: Node, _rotation: Quaternion) -> void:
    pass


## The rotation of euler (degrees) as a quaternion, in the subclass's rotation order.
func _quaternion_of(_euler: Vector3) -> Quaternion:
    return Quaternion.IDENTITY


## [position: Vector3, euler degrees: Vector3] of a spawn's position and rotation arguments
## (null for either: the origin, no rotation); null with last_error for unsupported types.
func _spawn_pose(_position: Variant, _rotation: Variant) -> Variant:
    return [Vector3.ZERO, Vector3.ZERO]


# ---- Public API ----

## The standard-field slot mask this node synchronizes when the entity has no schema (bits
## 0..2 the position axes, 3..5 the rotation axes). Works outside the tree.
func network_field_mask() -> int:
    return (_position_axes() & 7) | (_rotation_axes() & 7) << 3


## The node this transform moves, or null.
func get_target() -> Node:
    return get_node_or_null(target)


## True when this client writes the object's pose.
func is_owner() -> bool:
    return _client != null and _state != null and _client.room_ready and _state.writable_by_me()


## Moves a remote object straight to the latest received pose (e.g. after a respawn). Does
## nothing for the owner or while unbound.
func snap_to_network() -> void:
    if _state != null and not is_owner():
        _snap()


## Angles just below 360 round up to one full turn; they are sent as 0 so the same orientation
## never alternates between two values. Unity's QuantizeAngle.
static func quantize_angle(degrees: float, unit: float) -> int:
    var value := Gs2SyncCodec.quantize(fposmod(degrees, 360.0), unit)
    var turn := Gs2SyncCodec.quantize(360.0, unit)
    return value - turn if value >= turn else value


# Unity's Mathf.LerpAngle in degrees (t clamped to 0..1).
static func lerp_angle_degrees(a: float, b: float, t: float) -> float:
    var delta := fposmod(b - a, 360.0)
    if delta > 180.0:
        delta -= 360.0
    return a + delta * clampf(t, 0.0, 1.0)


# Unity's Mathf.DeltaAngle in degrees.
static func delta_angle_degrees(current: float, goal: float) -> float:
    var delta := fposmod(goal - current, 360.0)
    return delta - 360.0 if delta > 180.0 else delta


static func _includes(axes: int, axis: int) -> bool:
    return (axes & (1 << axis)) != 0


static func _merge(original: Vector3, update: Vector3, axes: int) -> Vector3:
    for axis in 3:
        if _includes(axes, axis):
            original[axis] = update[axis]
    return original


func _changed(mask: int, axis: int, rotation: bool) -> bool:
    var axes := _rotation_axes() if rotation else _position_axes()
    return _includes(axes, axis) and (mask & (1 << _slots[(3 if rotation else 0) + axis])) != 0


func _refuse(message: String) -> bool:
    last_error = message
    push_error(message)
    return false


# ---- Binding (the entity calls these) ----

# Resolves the axes' fields; returns their slot mask, or -1 with last_error.
func _resolve(axes: int, prefix: String, offset: int, schema: Gs2NetworkSchema) -> int:
    if (axes & ~7) != 0:
        _refuse("Invalid axes")
        return -1
    var mask := 0
    for axis in 3:
        if not _includes(axes, axis):
            continue
        var name: String = prefix + "XYZ"[axis]
        var field := Gs2NetworkSchema.resolve(schema, name)
        if field == null or field.type != Gs2NetworkSchemaField.ValueType.FLOAT:
            _refuse("Transform requires a float field enabled in the schema: " + name)
            return -1
        _slots[offset + axis] = field.slot
        _units[offset + axis] = field.precision
        mask |= 1 << field.slot
    return mask


## For the entity: binds the room object; false with last_error when the schema does not match
## it, the synchronized axes lack float fields or overlap, or the target is not of the right
## type.
func _network_bind(entity: Gs2NetworkEntity) -> bool:
    last_error = ""
    var node := get_target()
    if node == null or not _accepts(node):
        return _refuse("%s needs a %s target" % [name, _target_kind()])
    var value := entity.network_object
    var schema := entity.schema
    if schema != null and not schema.describes(value):
        return _refuse("Transform schema does not match the object")
    var position_mask := _resolve(_position_axes(), "Position", 0, schema)
    if position_mask < 0:
        return false
    var rotation_mask := _resolve(_rotation_axes(), "Rotation", 3, schema)
    if rotation_mask < 0:
        return false
    if (position_mask & rotation_mask) != 0 or ((position_mask | rotation_mask) & ~value.fields) != 0:
        return _refuse("Transform fields overlap or are missing from server schema")
    _release()
    _client = entity.client
    _state = value
    _world = entity.world
    _state.changed.connect(_on_changed)
    _state.authority_changed.connect(_on_authority)
    _state.predicted.connect(_on_predicted)
    _state.prediction_corrected.connect(_on_corrected)
    _samples.clear()
    _position_error = Vector3.ZERO
    _euler_error = Vector3.ZERO
    _target_position = _get_position(node)
    _target_euler = _get_euler(node)
    # A confirmed instantiate keeps the pose the owner already moved it to.
    if entity.binding_placeholder and value.is_mine():
        return true
    _on_changed(_ALL)
    _snap()
    return true


## For the entity: unbinds.
func _network_unbind(_entity: Gs2NetworkEntity) -> void:
    _release()


func _release() -> void:
    if _state != null:
        if _state.changed.is_connected(_on_changed):
            _state.changed.disconnect(_on_changed)
        if _state.authority_changed.is_connected(_on_authority):
            _state.authority_changed.disconnect(_on_authority)
        if _state.predicted.is_connected(_on_predicted):
            _state.predicted.disconnect(_on_predicted)
        if _state.prediction_corrected.is_connected(_on_corrected):
            _state.prediction_corrected.disconnect(_on_corrected)
    _state = null
    _client = null
    _world = null
    _samples.clear()


func _notification(what: int) -> void:
    if what == NOTIFICATION_PREDELETE:
        _release()


func _snap() -> void:
    _samples.clear()
    var node := get_target()
    if node == null:
        return
    _set_position(node, _merge(_get_position(node), _target_position, _position_axes()))
    if _rotation_axes() != 0:
        _set_euler(node, _merge(_get_euler(node), _target_euler, _rotation_axes()))


func _on_authority() -> void:
    _on_changed(_ALL)
    _snap()


func _on_changed(mask: int) -> void:
    var values := _state.get_values()
    for axis in 3:
        if _changed(mask, axis, false):
            _target_position[axis] = values[_slots[axis]] * _units[axis]
        if _changed(mask, axis, true):
            _target_euler[axis] = values[_slots[3 + axis]] * _units[3 + axis]
    if mask != _ALL and _world != null and not is_nan(_world.received_server_time):
        _record(_world.received_server_time)


## For the entity: each world update while bound.
func _network_tick(_entity: Gs2NetworkEntity) -> void:
    if _client == null or not _client.room_ready or not can_process():
        return
    var node := get_target()
    if node == null:
        return
    if _state.is_predicted:
        return # the world shows the prediction (_on_predicted)
    if _client.room_ready and _state.writable_by_me():
        _write_pose(node)
    elif not _interpolate(node):
        _approach(node)


func _delta() -> float:
    return _world.real_delta() if _world != null else 0.0


# ---- Owner: this client writes the pose; the world sends it at its send rate ----

func _write_pose(node: Node) -> void:
    var p := _get_position(node)
    var r := _get_euler(node) if _rotation_axes() != 0 else Vector3.ZERO
    for axis in 3:
        if _includes(_position_axes(), axis):
            var wire := Gs2SyncCodec.quantize(p[axis], _units[axis])
            if Gs2SyncCodec.last_error == "":
                _client.set_field(_state.id, _slots[axis], wire)
        if _includes(_rotation_axes(), axis):
            _client.set_field(_state.id, _slots[3 + axis], quantize_angle(r[axis], _units[3 + axis]))


# ---- Remote: another member's or the room's object ----

func _record(time: float) -> void:
    var node := get_target()
    if node == null:
        return
    var count := _samples.size()
    if count > 0 and time < _samples[count - 1].time:
        return # out of order: keep the newer pose
    if count == 0 and _world.has_server_time():
        # Start from the pose on screen so the first update blends in instead of jumping.
        var now := _world.server_time() - interpolation_delay
        if now < time:
            var start := _Sample.new()
            start.time = now
            start.position = _get_position(node)
            start.euler = _get_euler(node)
            _samples.append(start)
            count = 1
    var previous := _samples[count - 1].position if count > 0 else _get_position(node)
    var sample := _Sample.new()
    sample.time = time
    sample.position = _target_position
    sample.euler = _target_euler
    sample.cut = teleport_distance > 0 and (_merge(previous, _target_position, _position_axes()) - previous).length_squared() > teleport_distance * teleport_distance
    if count > 0 and _samples[count - 1].time == time:
        sample.cut = sample.cut or _samples[count - 1].cut
        _samples[count - 1] = sample
        return
    if count == _MAX_SAMPLES:
        _samples.pop_front()
    _samples.append(sample)


# Shows the pose at server_time - interpolation_delay between the two received updates around
# it; holds the newest pose when updates stop (no extrapolation).
func _interpolate(node: Node) -> bool:
    if _samples.is_empty() or _world == null or not _world.has_server_time():
        return false
    var time := _world.server_time() - interpolation_delay
    var count := _samples.size()
    var next := 0
    while next < count and _samples[next].time <= time:
        next += 1
    var position: Vector3
    var euler: Vector3
    var rotation: Quaternion
    if next == 0:
        position = _samples[0].position
        euler = _samples[0].euler
        rotation = _quaternion_of(euler)
    elif next == count:
        var newest := _samples[next - 1]
        position = newest.position
        euler = newest.euler
        rotation = _quaternion_of(euler)
        # Keep the newest sample as the base for later updates.
        if next > 1:
            _samples.clear()
            _samples.append(newest)
    else:
        var a := _samples[next - 1]
        var b := _samples[next]
        var u := 0.0 if b.cut else (time - a.time) / (b.time - a.time)
        position = a.position.lerp(b.position, u)
        rotation = _quaternion_of(a.euler).slerp(_quaternion_of(b.euler), u)
        euler = a.euler
        for axis in 3:
            euler[axis] = lerp_angle_degrees(a.euler[axis], b.euler[axis], u)
        # Drop samples that are entirely in the past.
        if next > 1:
            _samples = _samples.slice(next - 1)
    _set_position(node, _merge(_get_position(node), position, _position_axes()))
    if _whole_rotation():
        _set_quaternion(node, rotation)
    elif _rotation_axes() != 0:
        _set_euler(node, _merge(_get_euler(node), euler, _rotation_axes()))
    return true


# Without timestamps: approach the latest pose at a rate per second.
func _approach(node: Node) -> void:
    var rate := 1.0 if interpolation <= 0 else 1.0 - exp(-interpolation * _delta())
    var current := _get_position(node)
    var goal := _merge(current, _target_position, _position_axes())
    if teleport_distance > 0 and (goal - current).length_squared() > teleport_distance * teleport_distance:
        rate = 1.0
    _set_position(node, current.lerp(goal, rate))
    if _whole_rotation():
        # Interpolate the orientation as a whole; per-axis Euler blending takes detours when
        # several axes change at once.
        _set_quaternion(node, _get_quaternion(node).slerp(_quaternion_of(_target_euler), rate))
    elif _rotation_axes() != 0:
        var euler := _get_euler(node)
        for axis in 3:
            if _includes(_rotation_axes(), axis):
                euler[axis] = lerp_angle_degrees(euler[axis], _target_euler[axis], rate)
        _set_euler(node, euler)


# ---- Predicted: this client's prediction, plus the fading offset of corrections ----

func _on_predicted(alpha: float) -> void:
    var node := get_target()
    if node == null or _state == null:
        return
    var fade := 0.0 if correction_time <= 0 else exp(-_delta() / correction_time)
    _position_error *= fade
    _euler_error *= fade
    var previous := _state.get_previous_predicted_values()
    var current := _state.get_predicted_values()
    var position := _get_position(node)
    var euler := _get_euler(node) if _rotation_axes() != 0 else Vector3.ZERO
    for axis in 3:
        if _includes(_position_axes(), axis):
            var slot := _slots[axis]
            position[axis] = lerpf(previous[slot], current[slot], alpha) * _units[axis] + _position_error[axis]
        if _includes(_rotation_axes(), axis):
            var slot := _slots[3 + axis]
            euler[axis] = lerp_angle_degrees(previous[slot] * _units[3 + axis], current[slot] * _units[3 + axis], alpha) + _euler_error[axis]
    _set_position(node, position)
    if _rotation_axes() != 0:
        _set_euler(node, euler)


func _on_corrected(mask: int) -> void:
    if _state == null:
        return
    var error := _state.get_prediction_error()
    for axis in 3:
        if _changed(mask, axis, false):
            _position_error[axis] += error[_slots[axis]] * _units[axis]
        if _changed(mask, axis, true):
            _euler_error[axis] = delta_angle_degrees(0.0, _euler_error[axis] + error[_slots[3 + axis]] * _units[3 + axis])
    # A large correction (e.g. a respawn) is a teleport, not an error to fade.
    if teleport_distance > 0 and _position_error.length_squared() > teleport_distance * teleport_distance:
        _position_error = Vector3.ZERO
        _euler_error = Vector3.ZERO


# ---- For the world ----

## For the world: places an instance not bound to an object yet (a predicted spawn) between the
## previous and current values (32 each) by alpha. Slots and precisions come from the entity's
## schema, resolved once.
func _show_unbound(entity: Gs2NetworkEntity, previous: PackedInt32Array, current: PackedInt32Array, alpha: float) -> void:
    var node := get_target()
    if node == null or not _accepts(node):
        return
    if _unbound.is_empty():
        var schema := entity.schema if entity != null else null
        _unbound.resize(6)
        for axis in 3:
            if _includes(_position_axes(), axis):
                _unbound[axis] = Gs2NetworkSchema.resolve(schema, "Position" + "XYZ"[axis])
            if _includes(_rotation_axes(), axis):
                _unbound[3 + axis] = Gs2NetworkSchema.resolve(schema, "Rotation" + "XYZ"[axis])
    var position := _get_position(node)
    var euler := _get_euler(node) if _rotation_axes() != 0 else Vector3.ZERO
    for axis in 3:
        var field: Gs2NetworkSchemaField = _unbound[axis]
        if field != null:
            position[axis] = lerpf(previous[field.slot], current[field.slot], alpha) * field.precision
        field = _unbound[3 + axis]
        if field != null:
            euler[axis] = lerp_angle_degrees(previous[field.slot] * field.precision, current[field.slot] * field.precision, alpha)
    _set_position(node, position)
    if _rotation_axes() != 0:
        _set_euler(node, euler)


## For the world (on the prefab's template, outside the tree): fills the spawn values of the
## synchronized axes from a spawn's position and rotation; false with last_error when the
## entity's schema lacks one of their float fields or a value does not fit.
func _network_spawn_values(entity: Gs2NetworkEntity, values: Gs2SlotValues, position: Variant, rotation: Variant) -> bool:
    last_error = ""
    var pose = _spawn_pose(position, rotation)
    if pose == null:
        return false
    var schema := entity.schema
    for axis in 3:
        if _includes(_position_axes(), axis) and not _fill(values, schema, "Position" + "XYZ"[axis], pose[0][axis], false):
            return false
        if _includes(_rotation_axes(), axis) and not _fill(values, schema, "Rotation" + "XYZ"[axis], pose[1][axis], true):
            return false
    return true


func _fill(values: Gs2SlotValues, schema: Gs2NetworkSchema, field_name: String, value: float, angle: bool) -> bool:
    var field := Gs2NetworkSchema.resolve(schema, field_name)
    if field == null or field.type != Gs2NetworkSchemaField.ValueType.FLOAT:
        last_error = "Prefab schema has no float field " + field_name
        return false
    var wire := quantize_angle(value, field.precision) if angle else Gs2SyncCodec.quantize(value, field.precision)
    if Gs2SyncCodec.last_error != "":
        last_error = "Network field %s cannot hold %s" % [field_name, str(value)]
        return false
    values.set_slot(field.slot, wire)
    return true
