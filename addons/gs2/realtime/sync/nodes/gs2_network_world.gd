# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Presents a synchronized room in the scene (Unity's NetworkWorld and NetworkWorld.Room):
# instantiates the registered prefabs for the room's objects, sends batched updates at the send
# rate and runs RPCs, room events and request completions. It is the Gs2SyncClient's presenter.
#
# Order of work: received calls, events and notifications run after the packet is applied
# (the post queue), outside Gs2SyncClient.receive, so they may send at once. Each frame the world
# services its entities, then (at the send rate) asks the _network_write nodes for their values
# and flushes: process_priority 100 runs it after the game's own _process (Unity's
# DefaultExecutionOrder(100) and LateUpdate). It processes while the tree is paused
# (PROCESS_MODE_ALWAYS).
#
# Ticking rooms and prediction (Unity's NetworkWorld.Tick.cs / .Prediction.cs): GDScript has no
# partial classes, so their state lives in two helpers this world owns, Gs2NetworkWorldTick (the
# input clock: server_tick, input_tick, set_input) and Gs2NetworkWorldPrediction (the prediction
# of own simulated objects, predicted spawns, corrections); the API is this world's. The world
# is the Gs2PredictionRoom host of the generated prediction (the contract in gs2_prediction_room.gd).
# Real time is Time.get_ticks_usec (Unity's unscaled time).
#
# Errors (D2): calls Unity throws from return false / null with last_error and push_error. A
# packet the world cannot apply (malformed, an unknown prefab, a schema mismatch) makes receive
# return false with last_error: disconnect then, as Unity's callers do on its exception.
class_name Gs2NetworkWorld
extends Node


## Raised when an instance is bound to a room object, own or remote (inside receive, as Unity's
## Spawned).
signal spawned(entity: Gs2NetworkEntity)
## Raised when a room object is removed (or on detach), before the instance is freed.
signal despawned(entity: Gs2NetworkEntity)
## An instantiate the room refused (e.g. capacity), with the room's reason; the instance is freed
## after the handlers run.
signal spawn_failed(entity: Gs2NetworkEntity, result: int)
## Raised with the new master's connection ID.
signal master_client_changed(connection_id: int)
## Every room event as received: (code, sender connection ID, a copy of the encoded arguments).
## Use it with raise_raw_event, or to observe all events.
signal event_received(code: int, sender: int, data: PackedByteArray)
## Raised with the key of a room property that changed or was deleted.
signal room_property_changed(key: String)
## Raised with (connection ID, key) when a player property changes.
signal player_property_changed(connection_id: int, key: String)
## The room refused one of this client's commands (which, and why); also logged as a warning
## while log_rejections is on. Spawn requests report theirs in Gs2SpawnRequest and spawn_failed.
signal command_rejected(rejection: Gs2SyncRejection)
## Raised with the tick before its input is sampled, for games that set inputs per tick rather
## than per frame (in the world's update). Unity's InputSampling.
signal input_sampling(tick: int)
## Raised when a prediction shows a spawned object before the room confirms it. The instance is a
## placeholder (is_mine) that the room's object takes over; it is freed if the room does not
## spawn it. Unity's PredictedSpawned.
signal predicted_spawned(entity: Gs2NetworkEntity)

const _ATTACH_FIRST = "Attach first"
## Ticks of inputs kept for re-simulation. When input_tick is further than this ahead of
## confirmed_tick, predicted objects show the room's state instead.
const PREDICTION_WINDOW = Gs2NetworkWorldPrediction.WINDOW

## Shared prefab catalog, combined with this world's own prefabs at attach. Refused while
## attached.
@export var catalog: Gs2NetworkPrefabCatalog:
    set(value):
        if _client != null:
            _misuse("Detach before changing catalog")
            return
        catalog = value
## This world's own prefab entries (combined with the catalog's at attach).
@export var prefabs: Array[Gs2NetworkPrefabEntry] = []
## Batched sends per second (1..60), like PhotonNetwork.SendRate.
@export_range(1, 60) var send_rate := 20:
    set(value):
        send_rate = clampi(value, 1, 60)
## Logs a warning for every command the room refuses.
@export var log_rejections := true
## Where instances are added; empty means this world.
@export var spawn_parent: NodePath
@export_group("Tick")
## Ticks by which inputs should reach the room before it simulates them (1..10).
@export_range(1, 10) var input_lead_ticks := 2:
    set(value):
        input_lead_ticks = clampi(value, 1, 10)
## Seconds remote objects are shown behind the room; keep equal to the network transforms'
## interpolation_delay so that lag-compensated hit tests match the screen.
@export_range(0.0, 1.0, 0.01, "or_greater") var view_delay := 0.1:
    set(value):
        view_delay = maxf(0.0, value)

## The underlying sync client while attached; null after detach. Unity's Client.
var client: Gs2SyncClient:
    get: return _client
    set(_v): _misuse("client is read-only; call attach")
## Optional unreliable sender for the periodic state updates (for example
## Gs2RealtimeUdpChannel.try_send while it is active); an invalid Callable keeps everything
## reliable. Requires an attached world.
var unreliable: Callable:
    get: return _client.unreliable if _client != null else Callable()
    set(value):
        if _client == null:
            _misuse(_ATTACH_FIRST)
            return
        _client.unreliable = value
## Server time in seconds of the packet being applied; NAN outside receive or without a
## timestamp.
var received_server_time := NAN
## Why the last call failed, or "".
var last_error := ""
## Simulation steps per second of the room (0 when it is not ticking).
var tick_rate: int:
    get: return _client.tick_rate if _client != null else 0
    set(_v): _misuse("tick_rate is read-only")
## The step the room completed last, as of its latest clock (uint32).
var server_tick: int:
    get: return _tick.server_tick
    set(_v): _misuse("server_tick is read-only")
## The tick inputs are stamped with (uint32); runs ahead of server_tick so that inputs arrive
## about input_lead_ticks before the room simulates them.
var input_tick: int:
    get: return _tick.input_tick
    set(_v): _misuse("input_tick is read-only")
## Measured lead: ticks between the room's tick and the newest input it had received from this
## client (smoothed). Approaches input_lead_ticks.
var input_lead: float:
    get: return _tick.input_lead
    set(_v): _misuse("input_lead is read-only")
## The tick of the room state that prediction starts from (the latest clock).
var confirmed_tick: int:
    get: return _prediction.confirmed_tick
    set(_v): _misuse("confirmed_tick is read-only")

var _client: Gs2SyncClient = null
var _catalog: Dictionary = {} # prefab ID -> _Prefab
var _instances: Dictionary = {} # object ID -> Gs2NetworkEntity
# This connection's spawn requests waiting for the room, by request ID, with the instance an
# instantiate shows meanwhile.
var _spawns: Dictionary = {} # request ID -> _PendingSpawn
# This connection's shared-object requests waiting for the room, by request ID. They outlive
# their objects: an interaction that removes its object is answered after the despawn.
var _command_requests: Dictionary = {} # request ID -> Gs2CommandRequest
# User code (RPC methods, notifications) runs after the packet is applied; completions always
# run, notifications of a room the world left are dropped.
var _deferred: Array[Callable] = []
var _completions: Array[Callable] = []
var _running_deferred := false
var _detachments := 0
var _detaching := false
var _next_flush := 0.0
var _next_refresh := 0.0
# Why the packet being received cannot be applied (set by the presenter methods).
var _receive_error := ""
# Server time: offset = server - local, tracking the least-delayed sample.
var _server_offset := 0.0
var _has_server_time := false

# ---- Room events ----
var _event_handlers: Array = [] # [node, Gs2NetworkRpc.Method]

# ---- Custom properties ----
var _room_properties: Dictionary = {}
var _player_properties: Dictionary = {} # connection ID -> Dictionary

# ---- Interest groups ----
var _interest_groups: Dictionary = {} # group -> true

# ---- Rules consistency ----
var _prediction_rules := 0
var _rules_warnings: Dictionary = {}

# ---- Tick clock and prediction ----
var _tick: Gs2NetworkWorldTick
var _prediction: Gs2NetworkWorldPrediction
var _last_frame := -1.0
var _real_delta := 0.0


# A registered prefab: its scene and a template instance (outside the tree, never shown) that
# answers what the prefab holds (its entity's schema, the nodes that fill spawn values).
class _Prefab:
    extends RefCounted
    var id := 0
    var scene: PackedScene
    var template: Node
    var entity: Gs2NetworkEntity
    var name := ""


class _PendingSpawn:
    extends RefCounted
    var request: Gs2SpawnRequest = null
    var shown: Gs2NetworkEntity = null # null for spawn
    var had_shown := false


func _init() -> void:
    process_mode = PROCESS_MODE_ALWAYS
    process_priority = 100
    _tick = Gs2NetworkWorldTick.new(self)
    _prediction = Gs2NetworkWorldPrediction.new(self)


func _notification(what: int) -> void:
    if what == NOTIFICATION_PREDELETE:
        detach()


static func _now() -> float:
    return Time.get_ticks_usec() / 1000000.0


## The instance of a room object ID, or null if none is shown.
func find(id: int) -> Gs2NetworkEntity:
    var entity = _instances.get(id)
    return entity if is_instance_valid(entity) else null


## Number of room objects currently shown by this world.
func instance_count() -> int:
    return _instances.size()


## The shown instances (a new array).
func instances() -> Array[Gs2NetworkEntity]:
    var list: Array[Gs2NetworkEntity] = []
    for entity in _instances.values():
        if is_instance_valid(entity):
            list.append(entity)
    return list


## What is wrong with the catalog's and this world's prefab entries (see
## Gs2NetworkPrefabCatalog.problems_of).
func problems() -> Array[String]:
    var all: Array = []
    if catalog != null:
        all.append_array(catalog.prefabs)
    all.append_array(prefabs)
    return Gs2NetworkPrefabCatalog.problems_of(all)


func _add_prefab(entry: Gs2NetworkPrefabEntry) -> bool:
    if entry == null or not entry.is_complete() or _catalog.has(entry.id):
        _misuse("Invalid or duplicate prefab ID")
        return false
    var root := entry.scene.instantiate()
    var entity := Gs2NetworkPrefabEntry.entity_of(root)
    if entity == null:
        var name := String(root.name) if root != null else entry.scene.resource_path
        if root != null:
            root.free()
        _misuse("Network prefab %s needs a Gs2NetworkEntity child of its root" % name)
        return false
    var prefab := _Prefab.new()
    prefab.id = entry.id
    prefab.scene = entry.scene
    prefab.template = root
    prefab.entity = entity
    prefab.name = String(root.name)
    _catalog[entry.id] = prefab
    return true


func _clear_catalog() -> void:
    for prefab in _catalog.values():
        if is_instance_valid(prefab.template):
            prefab.template.free()
    _catalog.clear()


## Connects the world to a room session: call after HelloResult and before passing buffered
## snapshot messages to receive. Detaches from any previous session first. connection_id is this
## client's connection ID; send the reliable sender (func(data, count) -> bool). False with
## last_error for invalid prefab entries or arguments (Unity throws).
func attach(connection_id: int, send: Callable) -> bool:
    detach()
    last_error = ""
    _clear_catalog()
    var entries: Array = []
    if catalog != null:
        entries.append_array(catalog.prefabs)
    entries.append_array(prefabs)
    for entry in entries:
        if not _add_prefab(entry):
            var reason := last_error
            _clear_catalog()
            last_error = reason
            return false
    var created := Gs2SyncClient.new(connection_id, send)
    if created.last_error != "":
        _clear_catalog()
        last_error = created.last_error
        return false
    _client = created
    _client.presenter = self
    _reset_clock()
    _attach_room()
    _next_flush = _now()
    _has_server_time = false
    return true


## Applies one received room message (its first count bytes; all when count is negative).
## Requires an attached world. False with last_error for a packet it cannot apply.
func receive(payload: PackedByteArray, count: int = -1) -> bool:
    return _apply(payload, count, NAN)


## Applies one received room message with its server timestamp. Pass the message metadata's
## life_time_milli_seconds to enable server_time (and timestamped interpolation of remote
## motion).
func receive_at(payload: PackedByteArray, server_milliseconds: int, count: int = -1) -> bool:
    var server := server_milliseconds / 1000.0
    var sample := server - _now()
    # A smaller delay shows up as a larger offset; adopt it at once and drift slowly
    # otherwise, so congestion spikes do not move the clock backwards much.
    if not _has_server_time or sample > _server_offset:
        _server_offset = sample
    else:
        _server_offset += (sample - _server_offset) * 0.02
    _has_server_time = true
    return _apply(payload, count, server)


## Estimated room server time in seconds, like PhotonNetwork.Time: shared by all members of the
## room; 0 until has_server_time (after a timestamped receive).
func server_time() -> float:
    return _now() + _server_offset if _has_server_time else 0.0


## True once a receive_at has set server_time.
func has_server_time() -> bool:
    return _has_server_time


func _apply(payload: PackedByteArray, count: int, server: float) -> bool:
    last_error = ""
    if _client == null:
        _misuse(_ATTACH_FIRST)
        return false
    var receiving := _client
    received_server_time = server
    _receive_error = ""
    var ok := receiving.receive(payload, count)
    received_server_time = NAN
    if not ok or _receive_error != "":
        _deferred.clear()
        last_error = _receive_error if _receive_error != "" else receiving.last_error
        push_error(last_error)
        return false
    _run_deferred()
    return true


# A packet the world cannot apply; the first reason is kept.
func _fail_receive(message: String) -> void:
    if _receive_error == "":
        _receive_error = message


## Completes a request outside network callbacks: after the packet being received, at the end
## of this frame's update, or at the end of detach. Unlike notifications (which detach drops), a
## completion always runs, so whoever waits learns how it ended. Unity's Defer.
func defer(completion: Callable) -> void:
    _completions.append(completion)


# Runs each batch's notifications, then its completions, until none is left. Re-entered from a
# callback it returns at once: the outer run takes up what was added, so nothing runs twice.
# After a callback detaches the world, the rest of its batch's notifications (of the room it
# left) are dropped; completions still run. A handler's script error stops that handler only.
func _run_deferred() -> void:
    if _running_deferred:
        return
    _running_deferred = true
    while not _deferred.is_empty() or not _completions.is_empty():
        var detached := _detachments
        var running: Array[Callable] = _deferred.duplicate()
        _deferred.clear()
        var notifications := running.size()
        running.append_array(_completions)
        _completions.clear()
        for i in running.size():
            if i < notifications and _detachments != detached:
                continue
            if running[i].is_valid():
                running[i].call()
    _running_deferred = false


# ---- Spawning ----

func _prefab_of(prefab_id: int) -> _Prefab:
    if _client == null:
        _misuse(_ATTACH_FIRST)
        return null
    if _detaching:
        _misuse("The world is detaching; spawn after attaching again")
        return null
    if not _catalog.has(prefab_id):
        _misuse("Unknown prefab ID: %d" % prefab_id)
        return null
    return _catalog[prefab_id]


## Requests a player object owned by this connection. The instance appears only once the room
## confirms it; use instantiate to show it at once. position and rotation (optional) fill the
## fields the prefab's network transform synchronizes (Gs2NetworkTransform2D: Vector2 and an
## angle in radians; Gs2NetworkTransform3D: Vector3 and a Quaternion, Basis or Euler radians;
## null: the origin, no rotation), which the room must permit.
## Returns a request that completes once: SPAWNED (with the entity), REJECTED (with the room's
## reason), NOT_SENT (the transport refused the packet) or ABANDONED (the world detached or the
## room was rejoined); null with last_error for a misuse.
func spawn(prefab_id: int, position: Variant = null, rotation: Variant = null) -> Gs2SpawnRequest:
    last_error = ""
    var prefab := _prefab_of(prefab_id)
    if prefab == null:
        return null
    var values := _encode(prefab, position, rotation)
    if values == null:
        return null
    return _request(prefab_id, values, null)


## Raw form of spawn: values holds the wire integers of the fields to set.
func spawn_values(prefab_id: int, values: Gs2SlotValues) -> Gs2SpawnRequest:
    last_error = ""
    if _prefab_of(prefab_id) == null:
        return null
    return _request(prefab_id, values, null)


## Like PhotonNetwork.Instantiate: returns the entity of a new instance at once, owned by this
## connection (is_mine), so it can move and send RPCs immediately; those are queued until the
## room confirms the object. A refused request raises spawn_failed and frees the instance.
## position and rotation (optional) place the instance's root and fill its transform fields.
## null with last_error when the packet could not be sent (the outbox is full) or for a misuse.
func instantiate(prefab_id: int, position: Variant = null, rotation: Variant = null) -> Gs2NetworkEntity:
    last_error = ""
    var prefab := _prefab_of(prefab_id)
    if prefab == null:
        return null
    var values := _encode(prefab, position, rotation)
    if values == null:
        return null
    var entity := _create_instance(prefab, position, rotation)
    entity.begin_placeholder()
    var request := _request(prefab_id, values, entity)
    if request == null or request.status == Gs2SpawnRequest.SpawnStatus.NOT_SENT:
        var reason := last_error
        _discard(entity)
        if request != null:
            _misuse("Instantiate not sent: the outbox is full")
        else:
            last_error = reason
        return null
    entity.spawn_request = request
    return entity


func _request(prefab_id: int, values: Gs2SlotValues, shown: Gs2NetworkEntity) -> Gs2SpawnRequest:
    var pending := _PendingSpawn.new()
    pending.shown = shown
    pending.had_shown = shown != null
    var id := _client.spawn(prefab_id, values, _on_spawn_answered.bind(pending))
    if id == 0 and _client.last_error != "":
        last_error = _client.last_error
        return null
    pending.request = Gs2SpawnRequest.new(id)
    if id == 0:
        pending.request.complete(Gs2SpawnRequest.SpawnStatus.NOT_SENT)
    else:
        _spawns[id] = pending
    return pending.request


# Runs after sync_spawned bound the room's object. Requests no longer tracked (not sent, or torn
# down) are ignored.
func _on_spawn_answered(status: int, o: Gs2NetworkObject, result: int, pending: _PendingSpawn) -> void:
    if pending.request == null or not _spawns.has(pending.request.id):
        return
    _spawns.erase(pending.request.id)
    var entity: Gs2NetworkEntity = pending.shown if is_instance_valid(pending.shown) else null
    match status:
        Gs2SyncTypes.RequestStatus.SUCCEEDED:
            var confirmed := find(o.id)
            defer(func() -> void: pending.request.complete(Gs2SpawnRequest.SpawnStatus.SPAWNED, confirmed))
        Gs2SyncTypes.RequestStatus.REFUSED:
            if entity != null:
                push_warning("The room refused to spawn %s: %s" % [entity._display_name(), Gs2SyncTypes.result_name(result)])
            defer(func() -> void:
                pending.request.complete(Gs2SpawnRequest.SpawnStatus.REJECTED, null, result)
                if entity == null:
                    return
                spawn_failed.emit(entity, result)
                if is_instance_valid(entity):
                    _discard(entity))
        _: # ABANDONED: the room rejoined; the placeholder goes
            if entity != null:
                _discard(entity)
            defer(func() -> void: pending.request.complete(Gs2SpawnRequest.SpawnStatus.ABANDONED))


# The spawn values of a prefab: every schema field declared (a room without an object catalog
# keeps the fields chosen at spawn; fields other than the transform start at 0), then what the
# nodes of its scope fill in (the network transforms, from position and rotation).
func _encode(prefab: _Prefab, position: Variant, rotation: Variant) -> Gs2SlotValues:
    var values := Gs2SlotValues.new()
    var schema := prefab.entity.schema
    if schema != null:
        if schema.validate() < 0:
            _misuse(schema.last_error)
            return null
        for field in schema.fields:
            values.set_slot(field.slot, 0)
    # _network_spawn_values(entity, values, position, rotation) -> bool
    # (false with the node's last_error when the prefab cannot take them).
    for node in prefab.entity.scope_nodes():
        if node.has_method(&"_network_spawn_values"):
            var filled = node._network_spawn_values(prefab.entity, values, position, rotation)
            if typeof(filled) == TYPE_BOOL and not filled:
                var reason = node.get(&"last_error")
                _misuse(reason if typeof(reason) == TYPE_STRING and reason != "" else "%s cannot take the spawn values" % prefab.name)
                return null
    return values


# A new instance of a prefab, placed (position / rotation, when given) and added under
# spawn_parent; returns its entity.
func _create_instance(prefab: _Prefab, position: Variant = null, rotation: Variant = null) -> Gs2NetworkEntity:
    var root := prefab.scene.instantiate()
    _place(root, position, rotation)
    var entity := Gs2NetworkPrefabEntry.entity_of(root)
    entity.instance_root = root
    var parent := get_node_or_null(spawn_parent) if not spawn_parent.is_empty() else self
    (parent if parent != null else self).add_child(root, true)
    return entity


static func _place(root: Node, position: Variant, rotation: Variant) -> void:
    if root is Node3D:
        if position is Vector3:
            root.position = position
        if rotation is Quaternion:
            root.quaternion = rotation
        elif rotation is Basis:
            root.basis = rotation
        elif rotation is Vector3:
            root.rotation = rotation
    elif root is Node2D:
        if position is Vector2:
            root.position = position
        if rotation is float or rotation is int:
            root.rotation = rotation


## For the world's presenter role (Unity's ISyncPresenter.Spawned).
func sync_spawned(o: Gs2NetworkObject) -> void:
    _prediction.dirty = true # a predicted spawn may hand over to this object
    if not _catalog.has(o.prefab):
        _fail_receive("Unknown prefab ID: %d" % o.prefab)
        return
    var prefab: _Prefab = _catalog[o.prefab]
    var placeholder: Gs2NetworkEntity = null
    var had_placeholder := false
    if o.is_mine():
        # The room's object takes over the instance shown for it: a predicted spawn's (same
        # prefab and key) or a spawn request's.
        if o.has_predicted_spawn_key():
            placeholder = _take_shown_spawn(o.prefab, o.request)
            had_placeholder = placeholder != null
        elif _spawns.has(o.request):
            var pending: _PendingSpawn = _spawns[o.request]
            had_placeholder = pending.had_shown
            if is_instance_valid(pending.shown) and not pending.shown.is_queued_for_deletion():
                placeholder = pending.shown
    # A placeholder the game freed before confirmation: create the object normally and despawn
    # it, so the room does not keep an orphan. Objects the member cannot despawn (simulated,
    # including predicted spawns) belong to the rules.
    var destroyed := had_placeholder and placeholder == null
    var orphan := destroyed and o.kind().holder_despawns
    var entity := placeholder if placeholder != null else _create_instance(prefab)
    if not entity.bind(self, _client, o):
        _instances.erase(o.id)
        _fail_receive(entity.last_error)
        _discard(entity)
        return
    _instances[o.id] = entity
    if orphan:
        entity.destroy()
    spawned.emit(entity)


## For the presenter role (Unity's ISyncPresenter.Despawned).
func sync_despawned(o: Gs2NetworkObject) -> void:
    _prediction.dirty = true
    if not _instances.has(o.id):
        return
    var entity = _instances[o.id]
    _instances.erase(o.id)
    if is_instance_valid(entity):
        _remove(entity)


## For the presenter role (Unity's ISyncPresenter.Updated).
func sync_updated(o: Gs2NetworkObject, update: Gs2SyncRecord, state: int) -> void:
    _on_update_received(o, update, state)


## For the presenter role (Unity's ISyncPresenter.ClockReceived).
func sync_clock_received(tick: int, rate: int, latest: int) -> void:
    _on_clock(tick, rate, latest)


## For the presenter role (Unity's ISyncPresenter.RpcReceived).
func sync_rpc_received(o: Gs2NetworkObject, method: int, sender: int, args: PackedByteArray, offset: int, count: int) -> void:
    var entity := find(o.id)
    if entity == null:
        return
    var call := entity.prepare_rpc(method, sender, args, offset, count)
    if call.is_valid():
        _deferred.append(call)


# Despawned observers run before the entity releases its bindings.
func _remove(entity: Gs2NetworkEntity) -> void:
    despawned.emit(entity)
    if is_instance_valid(entity):
        _discard(entity)


static func _discard(entity: Gs2NetworkEntity) -> void:
    var root := entity.instance_root if is_instance_valid(entity.instance_root) else entity.get_parent()
    entity.unbind()
    if root == null:
        root = entity
    if root.is_queued_for_deletion():
        return
    root.process_mode = PROCESS_MODE_DISABLED
    var parent := root.get_parent()
    if parent != null:
        parent.remove_child(root)
    root.queue_free()


# ---- Commands of shared objects ----

## For Gs2SharedObject: send is a Gs2SyncClient call given its callback (func(completed) ->
## request ID); the request is tracked until answered. null with last_error for a misuse.
func command(send: Callable) -> Gs2CommandRequest:
    last_error = ""
    if _client == null:
        _misuse(_ATTACH_FIRST)
        return null
    var holder := [null]
    var id: int = send.call(func(status: int, result: int) -> void: _on_command_answered(holder[0], status, result))
    if id == 0 and _client.last_error != "":
        last_error = _client.last_error
        return null
    var request := Gs2CommandRequest.new(id)
    holder[0] = request
    if id == 0:
        request.complete(Gs2SyncTypes.RequestStatus.NOT_SENT, 0)
    else:
        _command_requests[id] = request
    return request


func _on_command_answered(request: Gs2CommandRequest, status: int, result: int) -> void:
    if request == null or not _command_requests.has(request.id):
        return
    _command_requests.erase(request.id)
    # A lambda holds the request; a Callable bound to it would not, and a request nobody else
    # holds would be freed before it completes.
    defer(func() -> void: request.complete(status, result))


# ---- Frame ----

func _process(_delta: float) -> void:
    var now := _now()
    _real_delta = now - _last_frame if _last_frame >= 0 else 0.0
    _last_frame = now
    if _client == null or not _client.room_ready:
        return
    _service_tick()
    _service_prediction()
    for entity in _instances.values():
        if is_instance_valid(entity):
            entity.service()
    _run_deferred()
    _late_update()


# All writes of this frame precede the batched flush (Unity's LateUpdate).
func _late_update() -> void:
    if _client == null or not _client.room_ready:
        return
    var now := _now()
    if now < _next_flush:
        return
    _next_flush = now + 1.0 / clampi(send_rate, 1, 60)
    for entity in _instances.values():
        if is_instance_valid(entity):
            entity.write_observables()
    _client.flush()
    # Values sent unreliably are sent again once per second, also after the unreliable
    # sender was removed (nothing is sent when there are none).
    if now >= _next_refresh:
        _next_refresh = now + 1.0
        _client.refresh()


## Disconnects from the room session: frees every instance (raising despawned) and completes
## pending requests as ABANDONED. Safe to call when not attached.
func detach() -> void:
    if _detaching:
        return
    _detaching = true
    _teardown()
    _detaching = false


func _teardown() -> void:
    _detachments += 1
    if _client != null:
        _client.presenter = null
    _reset_clock()
    _detach_room()
    var unanswered: Array[Gs2SpawnRequest] = []
    for pending in _spawns.values():
        unanswered.append(pending.request)
        if is_instance_valid(pending.shown):
            _discard(pending.shown)
    _spawns.clear()
    _deferred.clear()
    var unanswered_commands: Array = _command_requests.values()
    _command_requests.clear()
    if _client != null:
        _client.abandon_requests()
    for entity in _instances.values():
        if is_instance_valid(entity):
            _remove(entity)
    _instances.clear()
    _client = null
    _clear_catalog()
    # Last, once detached: a callback that spawns again finds the world detached (spawn fails)
    # instead of registering a request nothing would answer.
    for request in unanswered:
        request.complete(Gs2SpawnRequest.SpawnStatus.ABANDONED)
    for request in unanswered_commands:
        request.complete(Gs2SyncTypes.RequestStatus.ABANDONED, 0)
    # Run completions queued before detach or by the unbinding entities; drop the detached
    # room's notifications.
    _deferred.clear()
    _run_deferred()


func _require_room() -> bool:
    if _client != null:
        return true
    _misuse(_ATTACH_FIRST)
    return false


# ---- Master client ----

## Connection ID of the master client, like PhotonNetwork.MasterClient (0 when unknown or
## detached). The room names the earliest remaining member; the master may name another.
func master_client_id() -> int:
    return _client.master_id if _client != null else 0


## True when this connection is the master client.
func is_master_client() -> bool:
    return _client != null and _client.master_id != 0 and _client.master_id == _client.connection_id


## Names another member as master; only the current master may. False when it could not be sent
## (or with last_error for a misuse).
func set_master_client(connection_id: int) -> bool:
    last_error = ""
    if not _require_room():
        return false
    if not is_master_client():
        _misuse("Only the master client can name another master")
        return false
    return _client_call(_client.set_master(connection_id))


func _client_call(ok: bool) -> bool:
    if not ok and _client != null:
        last_error = _client.last_error
    return ok


func _on_master_changed(master: int) -> void:
    _deferred.append(func() -> void: master_client_changed.emit(master))


# ---- Room events ----
# Raising an event encodes the arguments by a registered handler's signature for that code, so a
# code needs a registered handler on the sender too.

## Registers a node's net_event_<name> methods as room event handlers, like Photon's OnEvent.
## Registering again replaces the earlier registration. False with last_error when its methods
## cannot bind.
func add_event_target(node: Node) -> bool:
    last_error = ""
    if node == null:
        _misuse("add_event_target needs a node")
        return false
    var table := Gs2NetworkRpc.table_of(node.get_script(), true)
    if table.error != "":
        _misuse(table.error)
        return false
    remove_event_target(node)
    for method in table.methods:
        _event_handlers.append([node, method])
    return true


## Unregisters a node added with add_event_target.
func remove_event_target(node: Node) -> void:
    _event_handlers = _event_handlers.filter(func(h: Array) -> bool: return is_instance_valid(h[0]) and h[0] != node)


func _event_code(event: Variant) -> int:
    if typeof(event) == TYPE_INT:
        return event
    var name := String(event)
    for handler in _event_handlers:
        if is_instance_valid(handler[0]) and handler[1].name == name:
            return handler[1].id
    return Gs2NetworkRpc.id_of(name)


func _event_signature(code: int) -> Gs2NetworkRpc.Method:
    for handler in _event_handlers:
        if is_instance_valid(handler[0]) and handler[1].id == code:
            return handler[1]
    _misuse("No net_event_ handler for code %d is registered; register one with add_event_target or use raise_raw_event" % code)
    return null


## Raises a room event to ALL, OTHERS or their buffered forms (Gs2SyncTypes.RpcTarget), like
## PhotonNetwork.RaiseEvent. event is a registered net_event_ method's name (without the
## prefix) or a code. False when the packet could not be sent (or with last_error for a misuse).
func raise_event(event: Variant, rpc_target: int, ...args: Array) -> bool:
    last_error = ""
    var room_event_target := Gs2SyncCodec.is_unaddressed(rpc_target) and rpc_target != Gs2SyncTypes.RpcTarget.OWNER
    if not room_event_target:
        _misuse("Room events go to ALL, OTHERS or their buffered forms; use raise_event_to for one player")
        return false
    return _send_event(_event_code(event), rpc_target, 0, args)


## Raises a room event to one player (a connection ID); see raise_event.
func raise_event_to(event: Variant, connection_id: int, ...args: Array) -> bool:
    last_error = ""
    if connection_id <= 0:
        _misuse("A player is a connection ID (not 0)")
        return false
    return _send_event(_event_code(event), Gs2SyncCodec.TARGET_PLAYER, connection_id, args)


## Raises an event with a raw payload, for handlers outside net_event_ (received through
## event_received). False when not sent.
func raise_raw_event(code: int, rpc_target: int, data: PackedByteArray = PackedByteArray()) -> bool:
    last_error = ""
    if not _require_room():
        return false
    return _client_call(_client.raise_event(code, rpc_target, data, data.size()))


## Raises a raw-payload event to one player (a connection ID).
func raise_raw_event_to(code: int, connection_id: int, data: PackedByteArray = PackedByteArray()) -> bool:
    last_error = ""
    if not _require_room():
        return false
    return _client_call(_client.raise_event_to(code, connection_id, data, data.size()))


func _send_event(code: int, rpc_target: int, recipient: int, args: Array) -> bool:
    if not _require_room():
        return false
    var signature := _event_signature(code)
    if signature == null:
        return false
    var encoded = Gs2NetworkRpc.encode(signature, args)
    if encoded == null:
        _misuse(Gs2NetworkRpc.last_error)
        return false
    return _client_call(_client.send_event_target(code, rpc_target, recipient, encoded, encoded.size()))


## For the presenter role (Unity's ISyncPresenter.EventReceived).
func sync_event_received(code: int, sender: int, args: PackedByteArray, offset: int, count: int) -> void:
    var copy := args.slice(offset, offset + count)
    _deferred.append(func() -> void: event_received.emit(code, sender, copy))
    var info := Gs2NetworkRpcInfo.new(null, code, sender, _client != null and sender == _client.connection_id)
    for handler in _event_handlers:
        if not is_instance_valid(handler[0]) or handler[1].id != code:
            continue
        var values = Gs2NetworkRpc.decode(handler[1], copy, 0, count, info)
        if values == null:
            push_warning("Dropped event %d for %s: %s" % [code, handler[0].name, Gs2NetworkRpc.last_error])
            continue
        _deferred.append(_invoke_event.bind(handler[0], handler[1].method_name, values))


static func _invoke_event(node: Node, method_name: StringName, values: Array) -> void:
    if is_instance_valid(node):
        node.callv(method_name, values)


# ---- Custom properties ----

## Writes a room property; null deletes it. Values: bool, int, float, String, PackedByteArray,
## Vector2/3/4, Vector2i/3i, Quaternion, Color. Keys are 1..64 UTF-8 bytes. The write applies
## when the room echoes it, so every member (including the writer) sees the same order. False
## when not sent (or with last_error for a misuse).
func set_room_property(key: String, value: Variant) -> bool:
    return _set_property(Gs2SyncClient.ROOM_SCOPE, key, value)


## Writes this player's property, with the rules of set_room_property. Other players'
## properties are read-only.
func set_player_property(key: String, value: Variant) -> bool:
    last_error = ""
    if not _require_room():
        return false
    return _set_property(_client.connection_id, key, value)


func _set_property(scope: int, key: String, value: Variant) -> bool:
    last_error = ""
    if not _require_room():
        return false
    var length := key.to_utf8_buffer().size()
    if length == 0 or length > Gs2SyncClient.MAX_PROPERTY_KEY:
        _misuse("Property keys are 1..%d UTF-8 bytes" % Gs2SyncClient.MAX_PROPERTY_KEY)
        return false
    var encoded = Gs2NetworkRpc.encode_property_value(value)
    if encoded == null:
        _misuse(Gs2NetworkRpc.last_error)
        return false
    return _client_call(_client.set_property(scope, key, encoded))


## The room's custom properties (a copy), like Photon's Room.CustomProperties.
func room_properties() -> Dictionary:
    return _room_properties.duplicate()


## A room property's value, or fallback when it has none. Unity's TryGetRoomProperty (test the
## type of the result).
func room_property(key: String, fallback: Variant = null) -> Variant:
    return _room_properties.get(key, fallback)


## Whether the room has the property.
func has_room_property(key: String) -> bool:
    return _room_properties.has(key)


## A player's custom properties (a copy; empty when it has none).
func player_properties(connection_id: int) -> Dictionary:
    return _player_properties.get(connection_id, {}).duplicate()


## A player's property, or fallback when it has none.
func player_property(connection_id: int, key: String, fallback: Variant = null) -> Variant:
    return _player_properties.get(connection_id, {}).get(key, fallback)


## Whether the player has the property.
func has_player_property(connection_id: int, key: String) -> bool:
    return _player_properties.has(connection_id) and _player_properties[connection_id].has(key)


## For the presenter role (Unity's ISyncPresenter.PropertyChanged).
func sync_property_changed(scope: int, key: String, args: PackedByteArray, offset: int, count: int) -> void:
    var value = Gs2NetworkRpc.decode_property_value(args, offset, count)
    if Gs2NetworkRpc.last_error != "":
        _fail_receive(Gs2NetworkRpc.last_error)
        return
    var properties: Dictionary
    if scope == Gs2SyncClient.ROOM_SCOPE:
        properties = _room_properties
    elif _player_properties.has(scope):
        properties = _player_properties[scope]
    else:
        if value == null:
            return
        properties = {}
        _player_properties[scope] = properties
    if value == null:
        properties.erase(key)
    else:
        properties[key] = value
    if scope == Gs2SyncClient.ROOM_SCOPE:
        _deferred.append(func() -> void: room_property_changed.emit(key))
    else:
        if properties.is_empty():
            _player_properties.erase(scope)
        _deferred.append(func() -> void: player_property_changed.emit(scope, key))


# ---- Refused commands ----

func _on_rejected(refused: Gs2SyncRejection) -> void:
    if log_rejections:
        push_warning("The room refused %s" % refused)
    _deferred.append(func() -> void: command_rejected.emit(refused))


# ---- Interest groups ----

## The interest groups this client subscribes to (group 0 is implicit).
func interest_groups() -> Array[int]:
    var groups: Array[int] = []
    groups.assign(_interest_groups.keys())
    return groups


## Subscribes to one interest group; see set_interest_groups.
func subscribe_group(group: int) -> bool:
    return set_interest_groups([], [group])


## Unsubscribes from one interest group; see set_interest_groups.
func unsubscribe_group(group: int) -> bool:
    return set_interest_groups([group], [])


## Changes interest group subscriptions, like PhotonNetwork.SetInterestGroups. Group 0 is always
## received. Subscriptions persist across reconnects and are sent again to a new room;
## subscribing delivers the group's current values. Works while detached. False when the outbox
## refused a change; that change is not recorded, so call again.
func set_interest_groups(disable: Array, enable: Array) -> bool:
    last_error = ""
    var ok := true
    for group in disable:
        if group == 0 or not _interest_groups.has(group):
            continue
        if _client == null or _client.subscribe(group, false):
            _interest_groups.erase(group)
        else:
            ok = false
    for group in enable:
        if group == 0 or _interest_groups.has(group):
            continue
        if _client == null or _client.subscribe(group, true):
            _interest_groups[group] = true
        else:
            ok = false
    return ok


# ---- Rules consistency ----
# A room running other rules than the generated code is logged once per pair, since fields,
# precision or predictions may no longer match.

## Records the rules hash the registered prediction was generated from (the first 4 bytes of
## the SHA-256 of the GSL as a uint32), so that a room running other rules logs a warning.
## Called by generated code.
func expect_rules(rules: int) -> void:
    _prediction_rules = rules & 0xFFFFFFFF


## The rules hash expect_rules recorded (0: none).
func expected_rules() -> int:
    return _prediction_rules


func _check_rules(room: int) -> void:
    if room == 0:
        return
    if _generated_from_other_rules(_prediction_rules, room):
        _warn_rules("The registered prediction", _prediction_rules, room)
    for prefab in _catalog.values():
        var schema: Gs2NetworkSchema = prefab.entity.schema
        if schema != null and _generated_from_other_rules(schema.rules, room):
            _warn_rules("Schema %s (%s)" % [schema.display_name(), prefab.name], schema.rules, room)


# generated is 0 when the code names no rules.
static func _generated_from_other_rules(generated: int, room: int) -> bool:
    return generated != 0 and generated != room


func _warn_rules(what: String, generated: int, room: int) -> void:
    var key := "%s%d:%d" % [what, generated, room]
    if _rules_warnings.has(key):
        return
    _rules_warnings[key] = true
    push_warning("%s was generated from other rules (%08x) than the room runs (%08x): rebuild the room rules and copy their godot/ outputs into the project" % [what, generated, room])


func _on_snapshot_started() -> void:
    _check_rules(_client.rules_hash)
    _reset_clock()
    _room_properties.clear()
    _player_properties.clear()


func _attach_room() -> void:
    _client.master_changed.connect(_on_master_changed)
    _client.snapshot_started.connect(_on_snapshot_started)
    _client.rejected.connect(_on_rejected)
    # Sent once the snapshot completes (the outbox holds them until then).
    for group in _interest_groups.keys():
        _client.subscribe(group, true)


func _detach_room() -> void:
    if _client != null:
        if _client.master_changed.is_connected(_on_master_changed):
            _client.master_changed.disconnect(_on_master_changed)
        if _client.snapshot_started.is_connected(_on_snapshot_started):
            _client.snapshot_started.disconnect(_on_snapshot_started)
        if _client.rejected.is_connected(_on_rejected):
            _client.rejected.disconnect(_on_rejected)
    _room_properties.clear()
    _player_properties.clear()


# ---- Tick clock (Unity's NetworkWorld.Tick.cs; state in Gs2NetworkWorldTick) ----

## Real seconds between the two latest world updates (Unity's Time.unscaledDeltaTime), for the
## nodes the world drives (network transforms).
func real_delta() -> float:
    return _real_delta


## True once the room's first clock arrived, for rooms with a tick rate (define_tick_rate in
## the room rules).
func is_ticking() -> bool:
    return _client != null and _client.tick_rate != 0 and _tick.started()


## The (fractional) room tick of the remote objects on screen: server_tick moved back by
## view_delay when the world receives server timestamps. Each input carries input_tick -
## view_tick so that the room can rewind hit tests to this view.
func view_tick() -> float:
    return _tick.view_tick()


## Sets an input slot (0..31) to an int32. The input is a held state of up to 32 integer slots,
## sampled every tick and sent while this client owns a simulated object; room rules read it
## with input. False with last_error for a slot outside 0..31.
func set_input(slot: int, value: int) -> bool:
    last_error = ""
    if slot < 0 or slot >= 32:
        _misuse("Slots are 0..31")
        return false
    _tick.input.set_slot(slot, Gs2SyncInt.i32(value))
    return true


## Sets an input slot to 1 (true) or 0 (false).
func set_input_bool(slot: int, value: bool) -> bool:
    return set_input(slot, 1 if value else 0)


## Sets an input slot quantized like synchronized float fields: value / precision, rounded.
## False with last_error when it does not fit.
func set_input_float(slot: int, value: float, precision: float) -> bool:
    last_error = ""
    var wire := Gs2SyncCodec.quantize(value, precision)
    if Gs2SyncCodec.last_error != "":
        _misuse("Input %s with precision %s does not fit an int32" % [str(value), str(precision)])
        return false
    return set_input(slot, wire)


## The value currently held in an input slot (0 for a slot not set or outside 0..31).
func get_input(slot: int) -> int:
    return _tick.input.get_slot(slot) if slot >= 0 and slot < 32 else 0


## Releases every input slot (all read as 0 by the room).
func clear_input() -> void:
    _tick.input.clear()


# Unity's ResetClock (also resets the prediction).
func _reset_clock() -> void:
    _tick.reset()
    _prediction.reset()


# Unity's OnClock.
func _on_clock(tick: int, rate: int, latest: int) -> void:
    _tick.on_clock(tick, rate, latest)


# Unity's ServiceTick (input sampling and sending).
func _service_tick() -> void:
    _tick.service(_real_delta)


# ---- Prediction (Unity's NetworkWorld.Prediction.cs; state in Gs2NetworkWorldPrediction) ----

## Registers the prediction of a prefab's simulated objects: step(object_id, tick) as generated
## from the @predict function (the contract in gs2_prediction_room.gd). Generated register functions
## call this; a prediction that failed is retried after a registration. False with last_error
## for an invalid step.
func register_prediction(prefab: int, step: Callable) -> bool:
    last_error = ""
    if not step.is_valid():
        _misuse("register_prediction needs a valid step Callable")
        return false
    _prediction.register(prefab, step)
    return true


## Stops predicting a prefab's objects; they are shown from the room's state again.
func unregister_prediction(prefab: int) -> void:
    _prediction.unregister(prefab)


## The registered prediction step of a prefab, or an invalid Callable.
func prediction_of(prefab: int) -> Callable:
    return _prediction.predictions.get(prefab, Callable())


## The prefabs with a registered prediction, in registration order.
func predicted_prefabs() -> Array[int]:
    return _prediction.order.duplicate()


# Unity's OnUpdateReceived (completes the confirmed state with late values).
func _on_update_received(o: Gs2NetworkObject, update: Gs2SyncRecord, state: int) -> void:
    _prediction.on_update_received(o, update, state)


# Unity's ServicePrediction.
func _service_prediction() -> void:
    _prediction.service()


# Unity's TakeShownSpawn: the instance a predicted spawn shows, handed to the room's object with
# the same prefab and key; null when none is shown.
func _take_shown_spawn(prefab: int, key: int) -> Gs2NetworkEntity:
    return _prediction.take_shown_spawn(prefab, key)


