# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The outcome of one interaction or lease request on a shared object (Unity's CommandRequest).
# It completes even when the request removes its object, and with ABANDONED when no answer will
# come (the world detached, or the room was rejoined). status is a
# Gs2SyncTypes.RequestStatus.
class_name Gs2CommandRequest
extends Gs2NetworkRequest


## The room's result when SUCCEEDED or REFUSED (a Gs2SyncTypes.CommandResult; codes from 100 are
## the rules' own).
var result := 0


## For the world: completes the request once.
func complete(request_status: int, command_result: int) -> bool:
    if is_done():
        return false
    result = command_result
    return _finish(request_status)
