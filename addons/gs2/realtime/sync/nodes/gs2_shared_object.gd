# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Put on a room-owned (leased or server) prefab, in its entity's scope (a child of the prefab's
# root, next to its Gs2NetworkEntity; Unity's SharedObject). The server catalog decides the
# kind; a client cannot grant authority or create room-owned objects. Interactions and lease
# requests return a Gs2CommandRequest.
#
# Errors (D2): calls Unity throws from return null with last_error and push_error.
class_name Gs2SharedObject
extends Node


## Why the last call failed, or "".
var last_error := ""
## The bound room object; null while unbound. Unity's Object.
var network_object: Gs2NetworkObject:
    get: return _object
    set(_v): push_error("network_object is read-only")

var _client: Gs2SyncClient = null
var _world: Gs2NetworkWorld = null
var _object: Gs2NetworkObject = null


## True while this client may write the object's fields.
func can_write() -> bool:
    return _client != null and _object != null and _client.can_write(_object.id)


## Called by the entity when it binds (Unity's Bind); refuses (false with last_error) an owned
## (player or simulated) object.
func _network_bind(entity: Gs2NetworkEntity) -> bool:
    last_error = ""
    var o := entity.network_object
    if o.kind().owned:
        last_error = "Expected shared object"
        return false
    if entity.world == null:
        last_error = "A Gs2SharedObject is bound by the Gs2NetworkWorld that creates its entity"
        return false
    _world = entity.world
    _client = entity.client
    _object = o
    return true


## Detaches from the room object. Requests already sent still complete: the world keeps them,
## since the room may answer after the object is gone.
func _network_unbind(_entity: Gs2NetworkEntity) -> void:
    _client = null
    _world = null
    _object = null


## Requests the lease manually. It does not enable the entity's controlled nodes and is not
## renewed; to take a leased object and wait until it is controlled, use
## Gs2NetworkEntity.acquire_control. null with last_error while unbound.
func acquire() -> Gs2CommandRequest:
    return _lease(Gs2SyncTypes.LeaseAction.ACQUIRE)


## Renews the held lease manually; see acquire.
func renew() -> Gs2CommandRequest:
    return _lease(Gs2SyncTypes.LeaseAction.RENEW)


## Gives the lease back manually; see acquire.
func release() -> Gs2CommandRequest:
    return _lease(Gs2SyncTypes.LeaseAction.RELEASE)


## Runs the rules' Interact(state, objectId, method) in the room, with argument bytes (copied,
## sent whole; rule-based rooms take none, host-defined actions may). null with last_error while
## unbound.
func interact(method: int, args: PackedByteArray = PackedByteArray()) -> Gs2CommandRequest:
    if not _require():
        return null
    var sync_client := _client
    var id := _object.id
    var copy := args.duplicate()
    return _command(func(completed: Callable) -> int: return sync_client.interact(id, method, copy, copy.size(), completed))


func _lease(action: int) -> Gs2CommandRequest:
    if not _require():
        return null
    var sync_client := _client
    var id := _object.id
    return _command(func(completed: Callable) -> int: return sync_client.lease(id, action, completed))


func _command(send: Callable) -> Gs2CommandRequest:
    var request := _world.command(send)
    if request == null:
        last_error = _world.last_error
    return request


func _require() -> bool:
    last_error = ""
    if _client == null or _object == null:
        last_error = "The shared object is not bound to a room object (not spawned yet, or despawned)"
        push_error(last_error)
        return false
    return true
