# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# RPCs and room events bound by method name (Unity's NetworkRpc.cs, whose [NetworkRpc] and
# [NetworkEvent] attributes become name prefixes), and the argument codec.
#
# Binding: a script's methods named
#   net_rpc_public_<name>  an RPC any member may call on any player's object ("publicMethods")
#   net_rpc_<name>         an RPC its object's owner calls ("methods")
#   net_event_<name>       a room event handler (register the node with
#                          Gs2NetworkWorld.add_event_target)
# are matched longest prefix first. The ID (method ID or event code) is id_of(<name>): FNV-1a of
# its UTF-8 bytes, as Unity's NetworkRpcAttribute.IdOf; renaming a method changes its ID. Every
# parameter needs a supported type (untyped and Variant parameters are errors); enums travel as
# int; a last parameter typed Gs2NetworkRpcInfo receives the call's details. Two methods with
# one ID are an error. The scan is cached per Script.
#
# Arguments (Godot's own format; Unity and Godot clients never share a room): bool 1 byte; int
# (and enums) a zigzag 64-bit varint; float an f64; Vector2/3/4, Quaternion and Color f32
# components; Vector2i/3i zigzag varints; String a varint length and UTF-8; PackedByteArray a
# varint length and the bytes; all little-endian. Received arguments must fill the call exactly.
#
# Errors (D2): encode / decode return null with last_error (Unity throws ArgumentException /
# FormatException); the tables carry the error of a script that cannot bind.
class_name Gs2NetworkRpc
extends RefCounted


const RPC_PREFIX = "net_rpc_"
const PUBLIC_RPC_PREFIX = "net_rpc_public_"
const EVENT_PREFIX = "net_event_"

## The argument types. Their order gives the custom property tags (index + 1), which are the
## wire format: append new types at the end.
enum Arg { BOOL, INT, FLOAT, STRING, BYTES, VECTOR2, VECTOR3, VECTOR4, QUATERNION, COLOR, VECTOR2I, VECTOR3I }

const _ARG_NAMES = ["bool", "int", "float", "String", "PackedByteArray", "Vector2", "Vector3", "Vector4", "Quaternion", "Color", "Vector2i", "Vector3i"]
const _VARIANT_ARGS = {
    TYPE_BOOL: Arg.BOOL, TYPE_INT: Arg.INT, TYPE_FLOAT: Arg.FLOAT, TYPE_STRING: Arg.STRING,
    TYPE_PACKED_BYTE_ARRAY: Arg.BYTES, TYPE_VECTOR2: Arg.VECTOR2, TYPE_VECTOR3: Arg.VECTOR3,
    TYPE_VECTOR4: Arg.VECTOR4, TYPE_QUATERNION: Arg.QUATERNION, TYPE_COLOR: Arg.COLOR,
    TYPE_VECTOR2I: Arg.VECTOR2I, TYPE_VECTOR3I: Arg.VECTOR3I,
}
const _INFO_CLASS = &"Gs2NetworkRpcInfo"

## Why the last encode / decode failed, or "".
static var last_error := ""

static var _rpc_tables: Dictionary = {} # Script -> Table
static var _event_tables: Dictionary = {} # Script -> Table


## One bound method of a script (Unity's NetworkRpcMethod).
class Method:
    extends RefCounted
    ## The method ID or event code.
    var id := 0
    ## The name the ID is derived from (the method name without its prefix).
    var name := ""
    ## The script method to call.
    var method_name: StringName
    ## How each parameter travels (Arg), without the Gs2NetworkRpcInfo one.
    var args := PackedInt32Array()
    ## The parameters' declared type names (an enum's name for enums).
    var arg_types: Array[String] = []
    ## The last parameter receives a Gs2NetworkRpcInfo.
    var has_info := false
    ## A net_rpc_public_ method (any caller).
    var any_caller := false


## The bound methods of a script, or why it cannot bind.
class Table:
    extends RefCounted
    var methods: Array[Method] = []
    ## Why the script's methods cannot bind (no method of it is bound then), or "".
    var error := ""


## The ID of a name: FNV-1a (32-bit) of its UTF-8 bytes, never 0 (Unity's
## NetworkRpcAttribute.IdOf).
static func id_of(name: String) -> int:
    var hash := 2166136261
    for b in name.to_utf8_buffer():
        hash = ((hash ^ b) * 16777619) & 0xFFFFFFFF
    return 1 if hash == 0 else hash


## The RPC methods (events: the room event handlers) of a script; cached per Script. A null
## script has none.
static func table_of(script: Script, events: bool = false) -> Table:
    if script == null:
        return Table.new()
    var cache: Dictionary = _event_tables if events else _rpc_tables
    if cache.has(script):
        return cache[script]
    var table := _scan(script, events)
    cache[script] = table
    return table


## Forgets the cached tables (a script reloaded in the editor).
static func clear_cache() -> void:
    _rpc_tables.clear()
    _event_tables.clear()


static func _scan(script: Script, events: bool) -> Table:
    var table := Table.new()
    var script_name := _script_name(script)
    var seen_names := {}
    var ids := {}
    # get_script_method_list lists the most derived script's methods first; an override is bound
    # once, as the most derived one.
    for info in script.get_script_method_list():
        var full: String = info.name
        if seen_names.has(full):
            continue
        seen_names[full] = true
        var name := ""
        var any_caller := false
        if events:
            if not full.begins_with(EVENT_PREFIX):
                continue
            name = full.substr(EVENT_PREFIX.length())
        elif full.begins_with(PUBLIC_RPC_PREFIX):
            name = full.substr(PUBLIC_RPC_PREFIX.length())
            any_caller = true
        elif full.begins_with(RPC_PREFIX):
            name = full.substr(RPC_PREFIX.length())
        else:
            continue
        var what := "%s.%s" % [script_name, full]
        if name == "":
            table.error = "%s needs a name after its prefix" % what
            return table
        var flags: int = info.flags
        if (flags & METHOD_FLAG_STATIC) != 0:
            table.error = "%s must not be static" % what
            return table
        if (flags & METHOD_FLAG_VARARG) != 0:
            table.error = "%s must not take variadic arguments" % what
            return table
        var method := Method.new()
        method.id = id_of(name)
        method.name = name
        method.method_name = StringName(full)
        method.any_caller = any_caller
        var parameters: Array = info.args
        for i in parameters.size():
            var parameter: Dictionary = parameters[i]
            var type: int = parameter.type
            if type == TYPE_OBJECT and parameter.class_name == _INFO_CLASS and i == parameters.size() - 1:
                method.has_info = true
                break
            if type == TYPE_NIL:
                table.error = "%s parameter %s needs a type (untyped and Variant parameters are not supported)" % [what, parameter.name]
                return table
            if not _VARIANT_ARGS.has(type):
                table.error = "%s has unsupported parameter type %s (%s)" % [what, type_string(type) if parameter.class_name == &"" else String(parameter.class_name), parameter.name]
                return table
            method.args.append(_VARIANT_ARGS[type])
            var is_enum := type == TYPE_INT and (int(parameter.usage) & PROPERTY_USAGE_CLASS_IS_ENUM) != 0
            method.arg_types.append(String(parameter.class_name) if is_enum else type_string(type))
        if ids.has(method.id):
            table.error = "Duplicate %s %d in %s (%s and %s)" % ["event code" if events else "RPC method ID", method.id, script_name, ids[method.id], full]
            return table
        ids[method.id] = full
        table.methods.append(method)
    return table


static func _script_name(script: Script) -> String:
    var global := script.get_global_name()
    if global != &"":
        return String(global)
    return script.resource_path.get_file() if script.resource_path != "" else "script"


# ---- Arguments ----

## Encodes a call's arguments by the method's parameters; null with last_error when they do
## not fit them (count, types, or more than Gs2SyncCodec.MAX_ARGS bytes).
static func encode(method: Method, values: Array) -> Variant:
    last_error = ""
    if values.size() != method.args.size():
        return _fail("RPC expects %d argument(s) but got %d" % [method.args.size(), values.size()])
    var w := PackedByteArray()
    for i in method.args.size():
        var value = _coerce(method.args[i], values[i], i)
        if last_error != "":
            return null
        _write(w, method.args[i], value)
        if w.size() > Gs2SyncCodec.MAX_ARGS:
            return _fail("RPC arguments exceed %d bytes" % Gs2SyncCodec.MAX_ARGS)
    return w


## Decodes received arguments (buffer[offset, offset + count)) for the method: the values to
## call it with (with info last when it takes one); null with last_error for arguments that do
## not fill its parameters exactly.
static func decode(method: Method, buffer: PackedByteArray, offset: int, count: int, info: Gs2NetworkRpcInfo) -> Variant:
    last_error = ""
    var r := _Reader.new(buffer, offset, count)
    var values := []
    for arg in method.args:
        values.append(r.read(arg))
        if r.error != "":
            return _fail(r.error)
    if not r.at_end():
        return _fail("Trailing RPC arguments")
    if method.has_info:
        values.append(info)
    return values


# A value of a parameter type: the value itself, or the conversion a direct call would make (an
# int for a float). Sets last_error when it is not one.
static func _coerce(arg: int, value: Variant, index: int) -> Variant:
    var type := typeof(value)
    if type == TYPE_NIL:
        _fail("RPC argument %d must not be null (%s)" % [index, _ARG_NAMES[arg]])
        return null
    match arg:
        Arg.FLOAT:
            if type == TYPE_INT or type == TYPE_FLOAT:
                return float(value)
        Arg.STRING:
            if type == TYPE_STRING or type == TYPE_STRING_NAME:
                return String(value)
        _:
            if _VARIANT_ARGS.get(type, -1) == arg:
                return value
    _fail("RPC argument %d must be %s but was %s" % [index, _ARG_NAMES[arg], type_string(type)])
    return null


static func _write(w: PackedByteArray, arg: int, value: Variant) -> void:
    match arg:
        Arg.BOOL:
            w.append(1 if value else 0)
        Arg.INT:
            _signed(w, value)
        Arg.FLOAT:
            var at := w.size()
            w.resize(at + 8)
            w.encode_double(at, value)
        Arg.STRING:
            _bytes(w, (value as String).to_utf8_buffer())
        Arg.BYTES:
            _bytes(w, value)
        Arg.VECTOR2:
            _singles(w, [value.x, value.y])
        Arg.VECTOR3:
            _singles(w, [value.x, value.y, value.z])
        Arg.VECTOR4, Arg.QUATERNION:
            _singles(w, [value.x, value.y, value.z, value.w])
        Arg.COLOR:
            _singles(w, [value.r, value.g, value.b, value.a])
        Arg.VECTOR2I:
            _signed(w, value.x)
            _signed(w, value.y)
        Arg.VECTOR3I:
            _signed(w, value.x)
            _signed(w, value.y)
            _signed(w, value.z)


static func _singles(w: PackedByteArray, components: Array) -> void:
    var at := w.size()
    w.resize(at + 4 * components.size())
    for c in components:
        w.encode_float(at, c)
        at += 4


static func _bytes(w: PackedByteArray, bytes: PackedByteArray) -> void:
    _unsigned(w, bytes.size())
    w.append_array(bytes)


# v as a varint of its 64 bits (7 bits per byte, least significant first; GDScript's >> keeps
# the sign, so the shifted-in bits are masked off).
static func _unsigned(w: PackedByteArray, v: int) -> void:
    while v < 0 or v >= 128:
        w.append((v & 127) | 128)
        v = (v >> 7) & 0x01FFFFFFFFFFFFFF
    w.append(v)


static func _signed(w: PackedByteArray, v: int) -> void:
    _unsigned(w, (v << 1) ^ (v >> 63))


static func _fail(message: String) -> Variant:
    last_error = message
    return null


# ---- Custom property values ----
# A property value carries its type's tag (Arg + 1) before it; no value (empty) deletes the
# property. Gs2SyncClient frames them with their key.

## Encodes a custom property value (null: an empty value, which deletes); null with last_error
## for an unsupported type.
static func encode_property_value(value: Variant) -> Variant:
    last_error = ""
    var w := PackedByteArray()
    if value == null:
        return w
    var type := typeof(value)
    if type == TYPE_STRING_NAME:
        value = String(value)
        type = TYPE_STRING
    if not _VARIANT_ARGS.has(type):
        return _fail("Unsupported property type " + type_string(type))
    var arg: int = _VARIANT_ARGS[type]
    w.append(arg + 1)
    _write(w, arg, value)
    if w.size() > Gs2SyncCodec.MAX_ARGS:
        return _fail("Property exceeds %d bytes" % Gs2SyncCodec.MAX_ARGS)
    return w


## Decodes a custom property value: null for an empty (deleted) one; null with last_error for
## one it cannot read (test last_error).
static func decode_property_value(buffer: PackedByteArray, offset: int, count: int) -> Variant:
    last_error = ""
    if count == 0:
        return null
    var r := _Reader.new(buffer, offset, count)
    var tag := r.byte() - 1
    if r.error != "" or tag < 0 or tag >= _ARG_NAMES.size():
        return _fail("Unknown property type")
    var value = r.read(tag)
    if r.error != "":
        return _fail(r.error)
    if not r.at_end():
        return _fail("Trailing property data")
    return value


class _Reader:
    extends RefCounted
    var buffer: PackedByteArray
    var at := 0
    var end := 0
    var error := ""

    func _init(bytes: PackedByteArray, offset: int, count: int) -> void:
        buffer = bytes
        at = offset
        end = offset + count

    func at_end() -> bool:
        return at == end

    func _need(count: int) -> bool:
        if error != "":
            return false
        if count > end - at:
            error = "Truncated RPC arguments"
            return false
        return true

    func byte() -> int:
        if not _need(1):
            return 0
        at += 1
        return buffer[at - 1]

    func unsigned() -> int:
        var value := 0
        var shift := 0
        while shift < 70:
            var b := byte()
            if error != "":
                return 0
            if shift == 63 and b > 1:
                error = "RPC varint overflow"
                return 0
            value |= (b & 127) << shift
            if b < 128:
                return value
            shift += 7
        error = "Invalid RPC varint"
        return 0

    func signed() -> int:
        var v := unsigned()
        return ((v >> 1) & 0x7FFFFFFFFFFFFFFF) ^ -(v & 1)

    func int32() -> int:
        var v := signed()
        if error == "" and not Gs2SyncInt.fits(v):
            error = "RPC integer out of range"
            return 0
        return v

    func single() -> float:
        if not _need(4):
            return 0.0
        at += 4
        return buffer.decode_float(at - 4)

    func length() -> int:
        var n := unsigned()
        if error != "":
            return 0
        if n < 0 or n > end - at:
            error = "Truncated RPC arguments"
            return 0
        return n

    func read(arg: int) -> Variant:
        match arg:
            Arg.BOOL:
                var b := byte()
                if error == "" and b > 1:
                    error = "Invalid RPC bool"
                return b == 1
            Arg.INT:
                return signed()
            Arg.FLOAT:
                if not _need(8):
                    return 0.0
                at += 8
                return buffer.decode_double(at - 8)
            Arg.STRING:
                var n := length()
                if error != "":
                    return ""
                var text = Gs2SyncClient.decode_utf8(buffer, at, at + n)
                if text == null:
                    error = "Invalid UTF-8 in RPC string"
                    return ""
                at += n
                return text
            Arg.BYTES:
                var n := length()
                if error != "":
                    return PackedByteArray()
                at += n
                return buffer.slice(at - n, at)
            Arg.VECTOR2:
                return Vector2(single(), single())
            Arg.VECTOR3:
                return Vector3(single(), single(), single())
            Arg.VECTOR4:
                return Vector4(single(), single(), single(), single())
            Arg.QUATERNION:
                return Quaternion(single(), single(), single(), single())
            Arg.COLOR:
                return Color(single(), single(), single(), single())
            Arg.VECTOR2I:
                return Vector2i(int32(), int32())
            Arg.VECTOR3I:
                return Vector3i(int32(), int32(), int32())
        error = "Unknown RPC argument type"
        return null
