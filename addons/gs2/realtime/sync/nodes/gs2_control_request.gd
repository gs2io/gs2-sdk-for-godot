# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The outcome of Gs2NetworkEntity.acquire_control (Unity's ControlRequest): SUCCEEDED once this
# client has control, or the reason it will not (see acquire_control). status is a
# Gs2SyncTypes.RequestStatus.
class_name Gs2ControlRequest
extends Gs2NetworkRequest


## The room's answer to the lease request (when REFUSED: the reason, e.g. LEASE_BUSY).
var result := 0


## For the entity: completes the request once.
func complete(request_status: int, command_result: int) -> bool:
    if is_done():
        return false
    result = command_result
    return _finish(request_status)
