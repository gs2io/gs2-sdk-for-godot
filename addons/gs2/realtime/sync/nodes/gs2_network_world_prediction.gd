# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Client prediction of a Gs2NetworkWorld's simulated objects (Unity's NetworkWorld.Prediction.cs).
# GDScript has no partial classes, so the part lives in this helper, owned by the world; the
# world is the Gs2PredictionRoom host (its _prediction_* methods call the ones here) and games
# use the world's API (register_prediction, confirmed_tick, predicted_spawned).
#
# The room rules mark the method that moves one object with @predict; the compiler emits it
# as GDScript (<rules>_prediction.gd), whose register function calls register_prediction. For
# each simulated object this client owns, the world then runs that step once per tick with this
# client's inputs, from the room's state at its latest clock (server_tick) up to input_tick.
# Every new clock starts again from the room's state, so a prediction the room disagreed with
# is corrected within one round trip; the difference is reported as the object's
# prediction_error for presentation to fade out.
#
# A failed run (Gs2PredictionRoom.fail: an unknown object, an overflow, ...) stops predicting,
# as Unity does when a [Predict] method throws: the room's state is shown until the next
# confirmed state or registration retries.
class_name Gs2NetworkWorldPrediction
extends RefCounted


## Ticks of inputs kept for re-simulation. When input_tick is further than this ahead of
## confirmed_tick, predicted objects show the room's state instead.
const WINDOW = 64
const _PREDICTED_SPAWN_BIT = 1 << 31

# UNCONFIRMED: no clock yet (nothing to predict from). PREDICTING: from the latest confirmed
# state. FAILED: a step failed; the room's state is shown until the next confirmed state or
# registration retries.
enum _Phase { UNCONFIRMED, PREDICTING, FAILED }
# A predicted spawn's instance: PREDICTED made by the latest prediction (moves with it);
# WAITING no longer predicted (its tick is confirmed): frozen, waits for the room.
enum _Shown { PREDICTED, WAITING }


class _InputFrame:
    extends RefCounted
    var tick := 0
    var mask := 0
    var values := PackedInt32Array()

    func value(slot: int) -> int:
        return values[slot] if (mask & (1 << slot)) != 0 else 0


# One object's fields in the confirmed state: each value, and the state version it is known as
# of when it has one (a spawn's initial value has none). A late update older than that version
# changes nothing.
class _Confirmed:
    extends RefCounted
    var values := PackedInt32Array()
    var versions := PackedInt64Array()
    var versioned_mask := 0

    func _init() -> void:
        values.resize(32)
        versions.resize(32)

    func is_versioned(field: int) -> bool:
        return (versioned_mask & (1 << field)) != 0

    func version(field: int) -> int:
        return versions[field]

    # The value is known as of a version newer than state: an update of state is older than
    # what the confirmed state holds.
    func knows_newer_than(field: int, state: int) -> bool:
        return is_versioned(field) and Gs2SyncInt.serial_diff(state, versions[field]) < 0

    func set_value(field: int, value: int, at: int, versioned: bool) -> void:
        values[field] = value
        versions[field] = at
        if versioned:
            versioned_mask |= 1 << field
        else:
            versioned_mask &= ~(1 << field)


# The prediction's working copy of a room object's values.
class _Values:
    extends RefCounted
    var values := PackedInt32Array()


# An object that a prediction spawned with spawn_owned. Local IDs are negative (-1 for the first
# spawn of a run); keys match the room's record request.
class _LocalSpawn:
    extends RefCounted
    var key := 0
    var prefab := 0
    var spawn_tick := 0
    var owner := 0
    var mine := false
    var removed := false
    var values := PackedInt32Array()
    var previous := PackedInt32Array()

    # This client's spawn, still made by the prediction: the room's object for it (same prefab
    # and key) takes over its instance.
    func awaits_room() -> bool:
        return mine and not removed and key != 0


# The instance shown for a predicted spawn, from the prediction that makes it until the room's
# object takes it over (sync_spawned), the prediction stops making it while its tick is
# unconfirmed (a misprediction), or the room's spawn does not come in time. Identified by
# (prefab, key): keys count spawns per owner and prefab, so two prefabs spawned in one tick
# share a key.
class _ShownSpawn:
    extends RefCounted
    var entity: Gs2NetworkEntity = null
    var motions: Array[Node] = []
    var spawn_tick := 0
    var prefab := 0
    var state: int = _Shown.PREDICTED
    var values := PackedInt32Array()
    var previous := PackedInt32Array()


## The registered steps by prefab, and the prefabs in registration order: each tick runs one
## prefab's prediction over all its objects before the next prefab's, as the rules' on_tick
## runs the @predict functions.
var predictions: Dictionary = {} # prefab -> Callable(object_id, tick)
var order: Array[int] = []
## The tick of the room state that prediction starts from (the latest clock).
var confirmed_tick := 0
## The prediction is recomputed on the next frame (inputs, state or registrations changed).
var dirty := false

var _world: Gs2NetworkWorld
var _frames: Array = [] # WINDOW entries: _InputFrame or null
# Room state of simulated objects at confirmed_tick: the values of state versions up to the
# clock's (_confirmed_state). Updates and clocks travel over UDP and WebSocket, so a value of
# that state may arrive after the clock and a later one before it.
var _confirmed: Dictionary = {} # object ID -> _Confirmed
var _confirmed_state := 0
var _scratch: Dictionary = {} # object ID -> _Values
var _prefab_objects: Dictionary = {} # prefab -> Array[int]
var _predicted_objects: Array[Gs2NetworkObject] = []
var _predicted_tick := 0
var _predicting_tick := 0
var _phase: int = _Phase.UNCONFIRMED
var _local_spawns: Array[_LocalSpawn] = []
var _spawn_counts: Dictionary = {} # owner << 32 | prefab -> count
var _removals: Dictionary = {} # object ID -> true
var _shown: Dictionary = {} # spawn slot -> _ShownSpawn
# The latest prediction's own spawns that no room object has taken over yet.
var _unmatched: Dictionary = {} # spawn slot -> _LocalSpawn
# Nodes this world hid on objects the prediction despawned.
var _hidden: Dictionary = {} # Gs2NetworkObject -> Array[Node]
var _corrections: Array[Gs2NetworkObject] = []
var _current_frame: _InputFrame = null
var _prefab_lists_dirty := false


func _init(world: Gs2NetworkWorld) -> void:
    _world = world
    _frames.resize(WINDOW)


static func _after(a: int, b: int) -> bool:
    return Gs2SyncInt.serial_diff(a, b) > 0


# State versions are serial numbers: a is not older than b.
static func _not_older(a: int, b: int) -> bool:
    return Gs2SyncInt.serial_diff(a, b) >= 0


static func _spawn_slot(prefab: int, key: int) -> int:
    return prefab << 32 | key


static func _spawn_key(tick: int, n: int) -> int:
    return 0 if n >= 32 else _PREDICTED_SPAWN_BIT | (tick & ((1 << 26) - 1)) << 5 | n


static func _zeros() -> PackedInt32Array:
    var values := PackedInt32Array()
    values.resize(32)
    return values


# ---- Registration ----

func register(prefab: int, step: Callable) -> void:
    if not predictions.has(prefab):
        order.append(prefab)
    predictions[prefab] = step
    dirty = true
    if _phase == _Phase.FAILED:
        _phase = _Phase.PREDICTING


func unregister(prefab: int) -> void:
    predictions.erase(prefab)
    order.erase(prefab)
    dirty = true


# ---- State ----

func reset() -> void:
    for o in _predicted_objects:
        o.is_predicted = false
    _predicted_objects.clear()
    _local_spawns.clear()
    _unmatched.clear()
    _removals.clear()
    _corrections.clear()
    _scratch.clear()
    _confirmed.clear()
    _confirmed_state = 0
    _frames.fill(null)
    _phase = _Phase.UNCONFIRMED
    _reset_spawns()
    confirmed_tick = 0
    _predicted_tick = 0
    dirty = true
    var client := _world._client
    if client == null:
        return
    for o in client.objects():
        o.is_predicted = false


func record_input(tick: int, input: Gs2SlotValues) -> void:
    var at := tick % WINDOW
    var frame: _InputFrame = _frames[at]
    if frame == null:
        frame = _InputFrame.new()
        _frames[at] = frame
    frame.tick = tick
    frame.mask = input.mask
    frame.values = input.to_array()
    dirty = true


func _input_at(tick: int) -> _InputFrame:
    # Like the room, a tick without input repeats the previous one.
    for back in WINDOW:
        var at := Gs2SyncInt.u32(tick - back)
        var frame: _InputFrame = _frames[at % WINDOW]
        if frame != null and frame.tick == at:
            return frame
    return null


func confirm(tick: int, state: int) -> void:
    if _phase != _Phase.UNCONFIRMED and not _after(tick, confirmed_tick):
        return # an older clock overtaken by a newer one
    _phase = _Phase.PREDICTING # also retries a failed prediction
    confirmed_tick = tick
    _confirmed_state = state
    dirty = true
    var client := _world._client
    for id in _confirmed.keys():
        if client.find(id) == null:
            _confirmed.erase(id)
    for o in client.objects():
        if not o.kind().simulated:
            continue
        var known := _confirmed.has(o.id)
        var fields: _Confirmed = _confirmed[o.id] if known else _Confirmed.new()
        if not known:
            _confirmed[o.id] = fields
        var current := o.get_values()
        for f in 32:
            var confirmed_versioned := known and fields.is_versioned(f)
            if o.is_newer(f, state):
                # The value overtook the clock: it belongs to a later tick. Use the value it
                # replaced, unless the earlier confirmed value is newer. A versioned confirmed
                # value is newer than a spawn's initial one.
                var prior_usable := o.has_prior_as_of(f, state) and (not confirmed_versioned or (o.is_prior_versioned(f) and _not_older(o.prior_version(f), fields.version(f))))
                if prior_usable:
                    fields.set_value(f, o.prior_value(f), o.prior_version(f), o.is_prior_versioned(f))
                    continue
                if known:
                    continue # keep the earlier confirmed value
            var versioned := o.is_known(f)
            fields.set_value(f, current[f], o.known_version_as_of(f, state) if versioned else 0, versioned)


# A value of the confirmed state that arrived after its clock (sent over WebSocket while the
# clock took UDP, or a reliable resend): complete the confirmed state and predict again from it.
func on_update_received(o: Gs2NetworkObject, r: Gs2SyncRecord, state: int) -> void:
    var part_of_confirmed_state := _phase != _Phase.UNCONFIRMED and not _after(state, _confirmed_state)
    if not part_of_confirmed_state or not _confirmed.has(o.id):
        return
    var fields: _Confirmed = _confirmed[o.id]
    var values := r.values
    for f in 32:
        if not r.has(f) or fields.knows_newer_than(f, state):
            continue
        var changed: bool = fields.values[f] != values[f]
        fields.set_value(f, values[f], state, true) # known as of this update now
        if changed:
            dirty = true


# The object's confirmed values, or its latest values outside the confirmed state (copies).
func _confirmed_values(o: Gs2NetworkObject) -> PackedInt32Array:
    if _confirmed.has(o.id):
        return _confirmed[o.id].values.duplicate()
    return o.get_values()


# ---- Predicted spawns ----

## For the world: hands a shown predicted spawn's instance to the room's object (null when none
## is shown, or the game freed it).
func take_shown_spawn(prefab: int, key: int) -> Gs2NetworkEntity:
    var slot := _spawn_slot(prefab, key)
    if not _shown.has(slot):
        return null
    var shown: _ShownSpawn = _shown[slot]
    _shown.erase(slot)
    return shown.entity if is_instance_valid(shown.entity) and not shown.entity.is_queued_for_deletion() else null


func _reset_spawns() -> void:
    for shown in _shown.values():
        if is_instance_valid(shown.entity):
            Gs2NetworkWorld._discard(shown.entity)
    _shown.clear()
    for nodes in _hidden.values():
        _show_again(nodes)
    _hidden.clear()


static func _show_again(nodes: Array) -> void:
    for node in nodes:
        if is_instance_valid(node):
            node.visible = true


# ---- Each frame ----

func service() -> void:
    if dirty:
        dirty = false
        _predict()
    var tick := _world._tick
    # While sampling is paused the predicted tick does not advance: hold the newest.
    var alpha := 1.0 if tick.paused_ticks > 0 else clampf(tick.tick_phase, 0.0, 1.0)
    for o in _predicted_objects.duplicate():
        o.notify_predicted(alpha)
    for shown in _shown.values():
        if not is_instance_valid(shown.entity):
            continue
        var progress := alpha if shown.state == _Shown.PREDICTED else 1.0
        for motion in shown.motions:
            if is_instance_valid(motion):
                motion._show_unbound(shown.entity, shown.previous, shown.values, progress)


func _predict() -> void:
    var client := _world._client
    var tick := _world._tick
    var input_tick := tick.input_tick
    # is_predicted stays set on objects predicted before: _correct compares with them.
    var active := not predictions.is_empty() and tick.started() and _phase != _Phase.UNCONFIRMED
    for o in _predicted_objects:
        var still_predicted := active and (_predictable(o) or _unconfirmed(o))
        if not still_predicted:
            o.is_predicted = false
    _predicted_objects.clear()
    _unmatched.clear()
    _local_spawns.clear()
    _removals.clear()
    if not active:
        _update_shown_spawns()
        _update_hidden()
        return
    for o in client.objects():
        if _predictable(o):
            _predicted_objects.append(o)
    _predicted_objects.sort_custom(func(a: Gs2NetworkObject, b: Gs2NetworkObject) -> bool: return a.id < b.id)
    var span := Gs2SyncInt.serial_diff(input_tick, confirmed_tick)
    var old_tick := _predicted_tick
    # The earlier prediction's tick is re-predicted in this run (after the confirmed tick, not
    # after input_tick): compare the two for corrections.
    var repredicts_old_tick := _predicted_tick != 0 and _after(old_tick, confirmed_tick) and not _after(old_tick, input_tick)
    var nothing_to_predict := span <= 0 or span > WINDOW or _phase == _Phase.FAILED
    if nothing_to_predict:
        # Show the room's state as the prediction.
        for o in _predicted_objects:
            var values := _confirmed_values(o)
            o.set_prediction(values, values)
            o.is_predicted = true
        _predicted_tick = 0
        _update_shown_spawns()
        _update_hidden()
        return
    _scratch.clear()
    _prefab_lists_dirty = true
    _corrections.clear()
    Gs2PredictionRoom.begin(_world)
    var t := Gs2SyncInt.u32(confirmed_tick + 1)
    while not _after(t, input_tick) and not Gs2PredictionRoom.failed():
        if t == input_tick:
            for o in _predicted_objects:
                if not _removals.has(o.id):
                    o.set_previous_predicted(_values(o.id).values)
            for spawn in _local_spawns:
                spawn.previous = spawn.values.duplicate()
        _predicting_tick = t
        _current_frame = _input_at(t)
        _spawn_counts.clear()
        for prefab in order:
            _predict_prefab(prefab, t)
            if Gs2PredictionRoom.failed():
                break
        if not Gs2PredictionRoom.failed() and repredicts_old_tick and t == old_tick:
            for o in _predicted_objects:
                if not _removals.has(o.id):
                    _correct(o, _values(o.id).values)
        t = Gs2SyncInt.u32(t + 1)
    var failure := Gs2PredictionRoom.end()
    _current_frame = null
    if failure != "":
        # The same function failing in the room would fail the room's on_tick; stop predicting
        # rather than show a state the room cannot reach.
        _phase = _Phase.FAILED
        push_error("Prediction failed: " + failure)
        for o in _predicted_objects:
            o.is_predicted = false
        _predicted_objects.clear()
        _local_spawns.clear()
        _corrections.clear()
        _removals.clear()
        _update_shown_spawns()
        _update_hidden()
        dirty = true # show the room's state from the next frame
        return
    # Observers run outside the prediction, so they cannot disturb it. A handler's script error
    # stops that handler only.
    var corrected := _corrections.duplicate()
    _corrections.clear()
    for o in corrected:
        o.notify_corrected()
    for o in _predicted_objects:
        if not _removals.has(o.id):
            o.set_predicted(_values(o.id).values)
        o.is_predicted = true
    _predicted_tick = input_tick
    # The room's objects that a prediction spawned, before their spawn tick is confirmed, show
    # that prediction (they took over its instance).
    _unmatched.clear()
    for spawn in _local_spawns:
        if spawn.awaits_room():
            _unmatched[_spawn_slot(spawn.prefab, spawn.key)] = spawn
    for o in client.objects():
        var slot := _spawn_slot(o.prefab, o.request)
        if not _unconfirmed(o) or not _unmatched.has(slot):
            continue
        var spawn: _LocalSpawn = _unmatched[slot]
        o.set_prediction(spawn.values, spawn.values if spawn.spawn_tick == input_tick else spawn.previous)
        o.is_predicted = true
        _predicted_objects.append(o)
        _unmatched.erase(slot)
    _update_shown_spawns()
    _update_hidden()


# One prefab's step of a tick: the room's objects in ID order, then the predicted spawns of that
# prefab made so far (an earlier prefab's step may have spawned them this tick; the room's loop
# counts them too).
func _predict_prefab(prefab: int, tick: int) -> void:
    var step: Callable = predictions[prefab]
    var step_tick := Gs2SyncInt.i32(tick)
    for o in _predicted_objects:
        if o.prefab == prefab and not _removals.has(o.id):
            step.call(Gs2SyncInt.i32(o.id), step_tick)
            if Gs2PredictionRoom.failed():
                return
    var spawned := _local_spawns.size()
    for i in spawned:
        if _local_spawns[i].prefab == prefab and not _local_spawns[i].removed:
            step.call(-(i + 1), step_tick)
            if Gs2PredictionRoom.failed():
                return


# Own simulated objects spawned by a prediction whose spawn tick the room has not confirmed yet.
func _unconfirmed(o: Gs2NetworkObject) -> bool:
    return _is_live_simulated_of_mine(o) and o.has_predicted_spawn_key() and not _confirmed.has(o.id)


# Shows the latest prediction's spawns that the room has not delivered yet, and ends the shown
# spawns it no longer makes.
func _update_shown_spawns() -> void:
    var input_tick := _world._tick.input_tick
    for shown in _shown.values():
        if shown.state == _Shown.PREDICTED:
            shown.state = _Shown.WAITING
    for slot in _unmatched:
        var spawn: _LocalSpawn = _unmatched[slot]
        var shown: _ShownSpawn = _shown.get(slot)
        var start := spawn.values if spawn.spawn_tick == input_tick else spawn.previous
        if shown == null:
            if not _world._catalog.has(spawn.prefab):
                continue
            var entity := _world._create_instance(_world._catalog[spawn.prefab])
            entity.begin_placeholder()
            shown = _ShownSpawn.new()
            shown.entity = entity
            shown.spawn_tick = spawn.spawn_tick
            shown.prefab = spawn.prefab
            for node in entity.scope_nodes():
                if node.has_method(&"_show_unbound"):
                    shown.motions.append(node)
            _shown[slot] = shown
            shown.previous = start.duplicate()
            shown.values = spawn.values.duplicate()
            for motion in shown.motions:
                motion._show_unbound(entity, shown.values, shown.values, 1.0)
            # A handler's script error stops that handler only.
            _world.predicted_spawned.emit(entity)
        else:
            shown.previous = start.duplicate()
            shown.values = spawn.values.duplicate()
        shown.state = _Shown.PREDICTED
    var ended: Array = []
    var rate := _world._client.tick_rate if _world._client != null else 0
    for slot in _shown:
        var shown: _ShownSpawn = _shown[slot]
        if not is_instance_valid(shown.entity) or shown.entity.is_queued_for_deletion():
            ended.append(slot) # freed by the game
            continue
        if shown.state == _Shown.PREDICTED:
            continue
        # Not predicted any more: a misprediction while its tick is unconfirmed; otherwise wait
        # briefly for the room's spawn message.
        var age := Gs2SyncInt.serial_diff(confirmed_tick, shown.spawn_tick)
        @warning_ignore("integer_division")
        var patience := maxi(1, rate / 2)
        if age < 0 or age > patience:
            ended.append(slot)
            Gs2NetworkWorld._discard(shown.entity)
    for slot in ended:
        _shown.erase(slot)


# Own objects that the prediction despawned are hidden until the room agrees. Only nodes that
# were visible are hidden (the instance root, when it is a CanvasItem or Node3D), and only those
# are shown again.
func _update_hidden() -> void:
    var client := _world._client
    if client == null:
        return
    for o in client.objects():
        var remove := _removals.has(o.id)
        o.predicted_removed = remove
        var entity: Gs2NetworkEntity = _world.find(o.id) if remove and not _hidden.has(o) else null
        if entity == null:
            continue # not instantiated yet: retried at the next prediction
        var hidden_nodes: Array[Node] = []
        var root: Node = entity.instance_root if is_instance_valid(entity.instance_root) else entity.get_parent()
        if (root is CanvasItem or root is Node3D) and root.visible:
            root.visible = false
            hidden_nodes.append(root)
        _hidden[o] = hidden_nodes
    var released: Array = []
    for o in _hidden:
        if not o.predicted_removed or client.find(o.id) != o:
            released.append(o)
    for o in released:
        _show_again(_hidden[o])
        _hidden.erase(o)


# A simulated object this client owns, still the client's current copy (not one a new snapshot
# replaced).
func _is_live_simulated_of_mine(o: Gs2NetworkObject) -> bool:
    return o.simulated_for_me() and _world._client.find(o.id) == o


func _predictable(o: Gs2NetworkObject) -> bool:
    # Only objects in the confirmed state: one spawned after the latest clock has newer values
    # than that state and would be stepped twice.
    return _is_live_simulated_of_mine(o) and predictions.has(o.prefab) and _confirmed.has(o.id)


# Compares the earlier prediction for a tick with the new one for the same tick.
func _correct(o: Gs2NetworkObject, values: PackedInt32Array) -> void:
    if not o.is_predicted:
        return # first prediction of this object: nothing was shown
    if o.measure_prediction_error(values):
        _corrections.append(o)


# ---- The Gs2PredictionRoom host (the world forwards its _prediction_* methods here) ----
# Where Unity's NetworkWorld throws, these fail the run (Gs2PredictionRoom.fail) and return 0.

static func _unknown(object_id: int) -> void:
    Gs2PredictionRoom.fail("Unknown object %d" % object_id)


# The local spawn of a negative ID, or null after failing the run.
func _local(object_id: int) -> _LocalSpawn:
    var index := -object_id - 1
    if index >= _local_spawns.size() or _local_spawns[index].removed:
        _unknown(object_id)
        return null
    return _local_spawns[index]


# The room object of a positive ID, or null after failing the run.
func _known(object_id: int) -> Gs2NetworkObject:
    var o := _world._client.find(Gs2SyncInt.u32(object_id))
    if o == null or _removals.has(o.id):
        _unknown(object_id)
        return null
    return o


# The values the prediction reads for a room object (an object with .values: the working copy,
# the confirmed state, or a copy of the room's latest values outside it); null after failing.
func _values(id: int) -> Object:
    if _removals.has(id):
        _unknown(id)
        return null
    if _scratch.has(id):
        return _scratch[id]
    if _confirmed.has(id):
        return _confirmed[id]
    # An object outside the confirmed state: this prediction works on a copy of the room's
    # latest values.
    var o := _world._client.find(id)
    if o == null:
        _unknown(id)
        return null
    var copy := _Values.new()
    copy.values = o.get_values()
    _scratch[id] = copy
    return copy


# The prediction's own copy of a room object's values, made on its first write.
func _working_values(id: int) -> _Values:
    if _scratch.has(id):
        return _scratch[id]
    var source := _values(id)
    if source == null:
        return null
    var copy := _Values.new()
    copy.values = source.values.duplicate()
    _scratch[id] = copy
    return copy


# A room object's field, checked against the fields the object has.
func _room_field(o: Gs2NetworkObject, field: int) -> bool:
    if o.has_field(field):
        return true
    Gs2PredictionRoom.fail("Field %d is not synchronized for prefab %d" % [field, o.prefab])
    return false


static func _local_field(field: int) -> bool:
    if field >= 0 and field < 32:
        return true
    Gs2PredictionRoom.fail("Field %d is out of range" % field)
    return false


func host_get(object_id: int, field: int) -> int:
    if object_id < 0:
        var spawn := _local(object_id)
        return spawn.values[field] if spawn != null and _local_field(field) else 0
    var o := _known(object_id)
    if o == null or not _room_field(o, field):
        return 0
    var source := _values(o.id)
    return source.values[field] if source != null else 0


func host_set(object_id: int, field: int, value: int) -> void:
    if object_id < 0:
        var spawn := _local(object_id)
        if spawn != null and _local_field(field):
            spawn.values[field] = value
        return
    var o := _known(object_id)
    if o == null or not _room_field(o, field):
        return
    var working := _working_values(o.id)
    if working != null:
        working.values[field] = value


func host_input(object_id: int, field: int) -> int:
    var mine := false
    if object_id < 0:
        var spawn := _local(object_id)
        if spawn == null:
            return 0
        mine = spawn.mine
    else:
        var o := _known(object_id)
        if o == null:
            return 0
        if not o.kind().simulated:
            Gs2PredictionRoom.fail("Input requires a simulated object")
            return 0
        mine = o.is_mine()
    var slot := field >= 0 and field < 32
    return _current_frame.value(field) if mine and slot and _current_frame != null else 0


func host_spawn_owned(prefab: int, owner_object_id: int, x: int, y: int, z: int) -> int:
    if prefab <= 0:
        Gs2PredictionRoom.fail("Specified argument was out of the range of valid values. (Parameter 'prefab')")
        return 0
    var me := _world._client.connection_id
    var owner := 0
    if owner_object_id < 0:
        var spawn := _local(owner_object_id)
        if spawn == null:
            return 0
        owner = me if spawn.mine else 0
    else:
        var o := _known(owner_object_id)
        if o == null:
            return 0
        if not (o.kind().owned and o.has_holder()):
            Gs2PredictionRoom.fail("SpawnOwned requires an object owned by a member")
            return 0
        owner = o.owner_id
    # Counted per owner and prefab like the room, so the n-th spawn has its key.
    var count_key := owner << 32 | Gs2SyncInt.u32(prefab)
    var n: int = _spawn_counts.get(count_key, 0)
    _spawn_counts[count_key] = n + 1
    var created := _LocalSpawn.new()
    created.prefab = prefab
    created.spawn_tick = _predicting_tick
    created.owner = owner
    created.mine = owner == me
    created.key = _spawn_key(_predicting_tick, n) if created.mine else 0
    created.removed = false
    var values := _zeros()
    # Fields with a default start with it, as in the room.
    if _world._catalog.has(prefab):
        var schema: Gs2NetworkSchema = _world._catalog[prefab].entity.schema
        if schema != null:
            values = schema.apply_defaults(values)
    values[0] = x
    values[1] = y
    values[2] = z
    created.values = values
    created.previous = values.duplicate()
    _local_spawns.append(created)
    _prefab_lists_dirty = true
    return -_local_spawns.size()


func host_prefab_of(object_id: int) -> int:
    if object_id < 0:
        var spawn := _local(object_id)
        return Gs2SyncInt.i32(spawn.prefab) if spawn != null else 0
    var o := _known(object_id)
    return Gs2SyncInt.i32(o.prefab) if o != null else 0


func host_owner_of(object_id: int) -> int:
    if object_id < 0:
        var spawn := _local(object_id)
        return Gs2SyncInt.i32(spawn.owner) if spawn != null else 0
    var o := _known(object_id)
    return Gs2SyncInt.i32(o.owner_id) if o != null else 0


# The first object of the prefab (room objects by ID, then this prediction's spawns) whose
# holder is the connection, or 0.
func host_find_owned(prefab: int, connection_id: int) -> int:
    if connection_id <= 0:
        return 0
    for id in host_objects(prefab):
        var holder := host_owner_of(Gs2SyncInt.i32(id))
        if Gs2PredictionRoom.failed():
            return 0
        if Gs2SyncInt.u32(holder) == connection_id:
            return Gs2SyncInt.i32(id)
    return 0


# An object the prediction can address: a room object it has not despawned, or one of its own
# spawns (negative IDs) it has not despawned. 0 is none.
func host_exists(object_id: int) -> bool:
    if object_id < 0:
        var index := -object_id - 1
        return index < _local_spawns.size() and not _local_spawns[index].removed
    var o: Gs2NetworkObject = _world._client.find(object_id) if object_id != 0 else null
    return o != null and not _removals.has(o.id)


func host_despawn(object_id: int) -> void:
    if object_id < 0:
        var spawn := _local(object_id)
        if spawn != null:
            spawn.removed = true
    else:
        var o := _known(object_id)
        if o == null:
            return
        if o.kind().holder_despawns:
            Gs2PredictionRoom.fail("Player objects cannot be despawned by the rules")
            return
        _removals[o.id] = true
    _prefab_lists_dirty = true


# The prefab's objects: the room's (by ID; simulated ones only from the confirmed state) and
# then this prediction's spawns (negative IDs), as their room IDs would be higher.
func host_objects(prefab: int) -> Array[int]:
    if _prefab_lists_dirty:
        _prefab_lists_dirty = false
        _prefab_objects.clear()
        for o in _world._client.objects():
            # Simulated objects belong to the confirmed state; later ones (such as the room's
            # copy of a predicted spawn) would be counted twice.
            var removed_by_prediction := _removals.has(o.id)
            var simulated_after_clock := o.kind().simulated and not _confirmed.has(o.id)
            if removed_by_prediction or simulated_after_clock:
                continue
            _list_of(o.prefab).append(o.id)
        for list in _prefab_objects.values():
            list.sort()
        for i in _local_spawns.size():
            if not _local_spawns[i].removed:
                _list_of(_local_spawns[i].prefab).append(-(i + 1))
    var ids: Array[int] = _list_of(Gs2SyncInt.u32(prefab))
    return ids


func _list_of(prefab: int) -> Array[int]:
    if not _prefab_objects.has(prefab):
        var list: Array[int] = []
        _prefab_objects[prefab] = list
    return _prefab_objects[prefab]
