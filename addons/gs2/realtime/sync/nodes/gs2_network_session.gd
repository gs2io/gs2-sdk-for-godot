# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Connects a Gs2NetworkWorld to a GS2-Realtime room (Unity's NetworkSession): opens the
# Gs2RealtimeSession, attaches the world, sends its packets in order, delivers received messages
# with the room server's clock (receive_at), uses the UDP side channel for state updates where
# the room offers one (not on the Web), and detaches the world when the session ends.
#
#     # Connect once (_ready), not before each connect_room: the signals persist across
#     # reconnects, so connecting per connection repeats the handlers.
#     session.room_ready.connect(func() -> void: world.instantiate(prefab_id, position, rotation))
#     session.disconnected.connect(func(reason: String) -> void: show_title(reason))
#     # Each (re)connection:
#     session.connect_room(access_token, ip_address, port, encryption_key)
#
# The world is the exported world (a node reference), or else the parent or the first child
# that is a Gs2NetworkWorld. Order of work: the session's messages arrive at the start of the
# frame (the transport's dispatch on SceneTree.process_frame) and its UDP datagrams in its
# _process (process_priority -100), before the game's _process and the world's (100), which
# services the objects and flushes. It processes while the tree is paused (PROCESS_MODE_ALWAYS).
#
# Packets go straight to the WebSocket while its outbound buffer has room (session.can_send);
# otherwise the world's client keeps them in its outbox, in order, and offers them again
# (Unity queues up to 32 packets for its sending coroutine instead).
#
# Ending: the transport's own close does not raise its closed signal, so the session ends
# itself (disconnected) after disconnect_room, a failed send or decode, and when it is disabled
# (process_mode DISABLED) or leaves the tree (Unity's OnDisable); the room closing it raises
# closed. Freeing the node releases the connection without disconnected (Unity's OnDestroy).
#
# Errors (D2): connect_room returns false with last_error (Unity throws).
class_name Gs2NetworkSession
extends Node


## The connection state (Unity's NetworkSessionState).
enum State {
    DISCONNECTED,
    ## Opening the room's WebSocket.
    CONNECTING,
    ## Connected; the room's snapshot is being applied.
    SYNCHRONIZING,
    ## The snapshot is applied: spawn, send and read the room.
    READY,
}

## The world attached: connect to world.client's signals here; no room message has been
## applied yet.
signal attached(client: Gs2SyncClient)
## The room's snapshot is applied (also after a new snapshot): the game may spawn, send and read
## the room. Unity's Ready (ready is Node's).
signal room_ready
## The session ended (closed by either side, failed to connect, or failed to send or decode),
## with a readable reason. The world is detached (its objects removed) first.
signal disconnected(reason: String)

## The world this session connects (null: the parent or the first child Gs2NetworkWorld).
@export var world: Gs2NetworkWorld
## Sends periodic state updates over UDP when the room answers (never on the Web).
@export var use_udp := true

## The connection state.
var state: State:
    get: return _state
    set(_v): _misuse("state is read-only")
## The open Gs2RealtimeSession (null while disconnected), e.g. for player join / leave signals.
var session: Gs2RealtimeSession:
    get: return _connection.session if _connection != null else null
    set(_v): _misuse("session is read-only")
## Why the latest connect_room failed, when it did: the transport's error (a Gs2Exception whose
## status_code carries the room's answer, e.g. an invalid access token; 0 when no room answered).
var connection_error: Variant:
    get: return _connection_error
    set(_v): _misuse("connection_error is read-only")
## Total bytes of the world's packets handed to the transport.
var sent_bytes: int:
    get: return _sent_bytes
    set(_v): _misuse("sent_bytes is read-only")
## Bytes of the latest packet handed to the transport.
var last_packet_bytes: int:
    get: return _last_packet_bytes
    set(_v): _misuse("last_packet_bytes is read-only")
## Why the last call failed, or "".
var last_error := ""

var _state: State = State.DISCONNECTED
var _connection: _Connection = null
var _connection_error: Variant = null
var _sent_bytes := 0
var _last_packet_bytes := 0


# One connection and everything that runs for it. It ends once (_end); callbacks of an ended
# connection do nothing, so a reconnect never sees the previous connection's traffic. Its
# coroutines run here, not on the node, so a node freed meanwhile is not resumed.
class _Connection:
    extends RefCounted
    var session: Gs2RealtimeSession
    var udp: Gs2RealtimeUdpChannel = null
    var error := "" # the latest error the session reported, for the disconnect reason
    var ended := false
    var _owner: WeakRef

    func _init(owner: Gs2NetworkSession, opening: Gs2RealtimeSession) -> void:
        _owner = weakref(owner)
        session = opening

    func owner_session() -> Gs2NetworkSession:
        return _owner.get_ref() as Gs2NetworkSession

    func open() -> void:
        # Not dispatching yet: the transport keeps the messages that arrive during Hello (the
        # snapshot) until the world subscribed.
        var result = await session.connect_session()
        var owner := owner_session()
        if ended or owner == null:
            return # disconnected meanwhile
        owner._opened(self, result)

    func close_then_end(reason: String) -> void:
        if ended:
            return
        await session.close()
        var owner := owner_session()
        if owner != null:
            owner._end(self, reason)

    func release() -> void:
        if udp != null:
            udp.close()
            udp = null
        # The session's signals hold this connection (bound): drop them so neither outlives
        # the other.
        for signal_name in [&"error_received", &"general_error", &"closed", &"message_received_with_metadata"]:
            for connection in session.get_signal_connection_list(signal_name):
                session.disconnect(signal_name, connection["callable"])
        session.close() # also stops the transport's dispatch; not awaited


func _init() -> void:
    process_mode = PROCESS_MODE_ALWAYS
    process_priority = -100


func _notification(what: int) -> void:
    match what:
        NOTIFICATION_DISABLED:
            # Disabling the node stops its processing (the UDP channel): end the session rather
            # than look Ready while nothing moves.
            if _connection != null:
                _end(_connection, "Disabled")
        NOTIFICATION_EXIT_TREE:
            if _connection != null:
                _end(_connection, "Removed from the tree")
        NOTIFICATION_PREDELETE:
            var c := _connection
            _connection = null
            if c != null:
                c.ended = true
                c.release()


## The world this session connects: world, or the parent or first child Gs2NetworkWorld.
func get_world() -> Gs2NetworkWorld:
    if is_instance_valid(world):
        return world
    var parent := get_parent()
    if parent is Gs2NetworkWorld:
        return parent
    for child in get_children():
        if child is Gs2NetworkWorld:
            return child
    return null


## True while state updates travel over UDP (always false on the Web).
func udp_active() -> bool:
    return _connection != null and _connection.udp != null and _connection.udp.is_active()


## Connects to the room that GS2-Realtime room creation reported; follow state or the signals.
## False with last_error when not DISCONNECTED, the node is not in the tree or is disabled,
## there is no world, or the settings are invalid (nothing changes then, so it may be called
## again).
func connect_room(access_token: String, ip_address: String, port: int, encryption_key: String, profile: PackedByteArray = PackedByteArray()) -> bool:
    last_error = ""
    if _state != State.DISCONNECTED:
        _misuse("Disconnect before connecting again")
        return false
    if not is_inside_tree() or not can_process():
        _misuse("connect_room needs a Gs2NetworkSession in the tree and not disabled")
        return false
    if get_world() == null:
        _misuse("Gs2NetworkSession needs a Gs2NetworkWorld (world, the parent or a child)")
        return false
    # Invalid settings fail here, before any state changes, so connect_room may be retried.
    if access_token == "" or ip_address == "" or port <= 0 or port > 65535 or encryption_key == "":
        _misuse("Invalid connection settings: an access token, an IP address, a port (1..65535) and an encryption key are required")
        return false
    var opening := _Connection.new(self, Gs2RealtimeSession.new(access_token, ip_address, port, encryption_key, profile))
    opening.session.error_received.connect(_on_session_error.bind(opening))
    opening.session.general_error.connect(_on_general_error.bind(opening))
    opening.session.closed.connect(_on_closed.bind(opening))
    _connection = opening
    _state = State.CONNECTING
    _connection_error = null
    opening.open()
    return true


## Closes the session; disconnected follows. Await it to wait for the close. Does nothing when
## not connected.
func disconnect_room() -> void:
    if _connection == null:
        return
    await _connection.close_then_end("Disconnected")


func _opened(c: _Connection, result: Variant) -> void:
    var failed_error = result.error if result != null else null
    var connected: bool = result != null and failed_error == null and c.session.connected
    if not connected:
        _connection_error = failed_error
        var why := _describe(failed_error)
        if why == "":
            why = c.error if c.error != "" else "no answer"
        _end(c, "Connection failed: " + why)
        return
    # An invalid world (its prefab catalog, for example) ends the session.
    var target := get_world()
    if target == null:
        _end(c, "Attach failed: no Gs2NetworkWorld")
        return
    if not target.attach(c.session.my_connection_id, _enqueue.bind(c)):
        _end(c, "Attach failed: " + target.last_error)
        return
    # The client lives as long as this connection, so nothing has to disconnect.
    var client := target.client
    client.snapshot_started.connect(func() -> void:
        if not c.ended:
            _state = State.SYNCHRONIZING)
    client.snapshot_completed.connect(_on_snapshot_completed.bind(c))
    # A handler's script error stops that handler only.
    attached.emit(client)
    # An attached handler may have ended the session (disabled this node, disconnected).
    if c.ended:
        return
    c.session.message_received_with_metadata.connect(_on_message.bind(c))
    if use_udp and c.session.udp_secret != 0 and Gs2RealtimeUdpChannel.is_supported():
        var channel := Gs2RealtimeUdpChannel.for_session(c.session)
        if channel.is_valid():
            c.udp = channel
        else:
            push_warning("UDP unavailable: " + channel.last_error)
    _state = State.SYNCHRONIZING
    c.session.dispatch()


func _on_snapshot_completed(c: _Connection) -> void:
    if c.ended:
        return
    _state = State.READY
    # The game's handler is not part of decoding the packet: its script error stops that
    # handler only.
    room_ready.emit()


# The world's reliable sender: straight to the WebSocket while its buffer has room; false keeps
# the packet in the client's outbox (backpressure).
func _enqueue(data: PackedByteArray, count: int, c: _Connection) -> bool:
    if c.ended or not c.session.connected or not c.session.can_send(count):
        return false
    var result: Gs2AsyncResult = c.session.send_message(data.slice(0, count) if count < data.size() else data)
    if result.error != null:
        # Not from inside the world's flush: end once it returned.
        c.close_then_end.call_deferred("Send failed")
        return false
    _sent_bytes += count
    _last_packet_bytes = count
    return true


func _on_message(data: PackedByteArray, metadata: Gs2RealtimeMessageMetadata, c: _Connection) -> void:
    _deliver(c, data, metadata.life_time_milli_seconds)


func _deliver(c: _Connection, data: PackedByteArray, server_milliseconds: int) -> void:
    var target := get_world()
    if c.ended or target == null or target.client == null:
        return
    if not target.receive_at(data, server_milliseconds):
        c.close_then_end("Decode failed: " + target.last_error)


# Before the world's update, so datagrams received this frame are applied before the world
# services its objects.
func _process(_delta: float) -> void:
    var c := _connection
    var target := get_world()
    if c == null or c.udp == null or target == null or target.client == null:
        return
    c.udp.poll(func(data: PackedByteArray, milliseconds: int) -> void: _deliver(c, data, milliseconds))
    if not c.ended and target.client != null:
        target.unreliable = c.udp.try_send if c.udp.is_active() else Callable()


func _on_session_error(error: Variant, c: _Connection) -> void:
    c.error = "Room error %d" % int(error.status_code) if error != null and "status_code" in error else "Room error"


func _on_general_error(error: Variant, c: _Connection) -> void:
    var why := _describe(error)
    c.error = why if why != "" else "Transport error"


func _on_closed(c: _Connection) -> void:
    _end(c, c.error if c.error != "" else "Closed by the room")


# A readable message of a transport error ("" for none).
static func _describe(error: Variant) -> String:
    if error == null:
        return ""
    if error is Gs2Exception:
        var e: Gs2Exception = error
        for request_error in e.errors:
            if request_error != null and request_error.message != null and str(request_error.message) != "":
                return str(request_error.message)
        return "status %d" % e.status_code
    return str(error)


func _end(c: _Connection, reason: String) -> void:
    if c.ended:
        return
    c.ended = true
    if _connection == c:
        _connection = null
    var target := get_world()
    if target != null: # freed first when the scene is freed
        target.detach()
    c.release()
    _state = State.DISCONNECTED
    disconnected.emit(reason)


func _misuse(message: String) -> void:
    last_error = message
    push_error(message)
