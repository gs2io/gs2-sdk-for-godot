# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The outcome of one Gs2NetworkWorld.spawn or instantiate (Unity's SpawnRequest). status is a
# Gs2SpawnRequest.SpawnStatus.
class_name Gs2SpawnRequest
extends Gs2NetworkRequest


## The state of a spawn request (Unity's SpawnStatus).
enum SpawnStatus {
    ## Waiting for the room.
    PENDING,
    ## The room confirmed it; entity is the instance.
    SPAWNED,
    ## The room refused it; rejection gives the reason.
    REJECTED,
    ## The transport refused the packet; nothing reached the room.
    NOT_SENT,
    ## No answer will come: the world detached, or the room was rejoined.
    ABANDONED,
}

## The confirmed instance (SPAWNED; null once despawned or freed).
var entity: Gs2NetworkEntity:
    get: return _entity if is_instance_valid(_entity) else null
    set(_v): push_error("A spawn request's entity is read-only")
## The room's reason when REJECTED (a Gs2SyncTypes.CommandResult or a rules code).
var rejection := 0

var _entity: Gs2NetworkEntity = null


## For the world: completes the request once.
func complete(request_status: int, spawned: Gs2NetworkEntity = null, refusal: int = 0) -> bool:
    if is_done():
        return false
    _entity = spawned
    rejection = refusal
    return _finish(request_status)


## The status's name (SPAWNED, ...).
static func status_name(spawn_status: int) -> String:
    var key = SpawnStatus.find_key(spawn_status)
    return str(spawn_status) if key == null else String(key)
