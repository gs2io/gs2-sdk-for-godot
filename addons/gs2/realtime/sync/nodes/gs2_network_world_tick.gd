# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The tick clock of a Gs2NetworkWorld (Unity's NetworkWorld.Tick.cs); the world's tick API
# (server_tick, input_tick, set_input, ...) reads and drives it. GDScript has no partial
# classes, so the part lives in this helper, owned by the world; games use the world's API.
#
# Ticking rooms (define_tick_rate in the room rules) run a fixed-rate simulation: each tick the
# rules read every member's input and write the simulated objects. This client stamps its input
# with the tick the room should apply it at (input_tick) and keeps that tick slightly ahead of
# the room, so that inputs arrive input_lead_ticks before they are needed. Simulated objects
# are shown from the room's state, interpolated like other remote objects, or predicted
# (Gs2NetworkWorldPrediction).
class_name Gs2NetworkWorldTick
extends RefCounted


# Following the room's clock: STOPPED until the first clock; SETTLING ignores the clocks sent
# before the room saw a jump of input_tick; MEASURING takes the next lead as it is; FOLLOWING
# smooths the lead and steers input_tick towards it.
enum _Phase { STOPPED, SETTLING, MEASURING, FOLLOWING }

## The step the room completed last, as of its latest clock (uint32).
var server_tick := 0
## The tick inputs are stamped with (uint32).
var input_tick := 0
## Measured lead (smoothed): ticks between the room's tick and the newest input it had received
## from this client.
var input_lead := 0.0
## Server time of the latest clock (NAN without timestamps).
var clock_server_time := NAN
## The held input (32 slots).
var input := Gs2SlotValues.new()
## Progress (0..1+) towards the next tick, and ticks left unsampled so that input_tick falls
## back; the prediction reads both.
var tick_phase := 0.0
var paused_ticks := 0

var _world: Gs2NetworkWorld
var _phase: int = _Phase.STOPPED
var _settling_clocks := 0
var _tick_scale := 1.0
var _next_send_warning := 0.0


func _init(world: Gs2NetworkWorld) -> void:
    _world = world


## True once the room's first clock arrived.
func started() -> bool:
    return _phase != _Phase.STOPPED


func reset() -> void:
    _phase = _Phase.STOPPED
    tick_phase = 0.0
    _tick_scale = 1.0
    paused_ticks = 0
    _settling_clocks = 0
    input_lead = 0.0
    server_tick = 0
    input_tick = 0
    clock_server_time = NAN


static func _after(a: int, b: int) -> bool:
    return Gs2SyncInt.serial_diff(a, b) > 0


static func _before(a: int, b: int) -> bool:
    return Gs2SyncInt.serial_diff(a, b) < 0


## The room's clock: it completed tick, runs rate ticks per second and had received this
## client's inputs up to latest (0: none yet).
func on_clock(tick: int, rate: int, latest: int) -> void:
    # Clocks travel unreliably: one overtaken by a newer clock is stale.
    if started() and _before(tick, server_tick):
        return
    clock_server_time = _world.received_server_time
    server_tick = tick
    _world._prediction.confirm(tick, _world._client.clock_state)
    # Start a little ahead (100 ms worth of ticks); the measured lead corrects it within a
    # second.
    var start := Gs2SyncInt.u32(tick + _world.input_lead_ticks + ceili(rate / 10.0))
    if _phase == _Phase.STOPPED:
        input_tick = start
        _phase = _Phase.MEASURING
        return
    if not _after(input_tick, tick):
        # Behind the room itself (e.g. after long frames while no input was sent): every input
        # would arrive too late. Restart ahead.
        input_tick = start
        paused_ticks = 0
        _settle(rate)
        return
    if latest == 0:
        return # no input received yet
    if _phase == _Phase.SETTLING:
        _settling_clocks -= 1
        if _settling_clocks <= 0:
            _phase = _Phase.MEASURING
        return
    var lead := float(Gs2SyncInt.serial_diff(latest, tick))
    input_lead = input_lead + (lead - input_lead) * 0.1 if _phase == _Phase.FOLLOWING else lead
    _phase = _Phase.FOLLOWING
    var error := _world.input_lead_ticks - input_lead
    if absf(error) > rate * 0.5:
        # More than half a second off (a stall or a latency change): jump. Inputs only move
        # forward, so falling back means skipping tick sampling.
        var ticks := roundi(error)
        if ticks > 0:
            input_tick = Gs2SyncInt.u32(input_tick + ticks)
        else:
            paused_ticks = -ticks
        _settle(rate)
        return
    # Otherwise run up to 10% faster or slower until the lead matches.
    _tick_scale = 1.0 + clampf(error * 0.02, -0.1, 0.1)


# After input_tick jumped: ignore the clocks of half a second, then measure afresh.
func _settle(rate: int) -> void:
    @warning_ignore("integer_division")
    _settling_clocks = rate / 2
    _phase = _Phase.SETTLING if _settling_clocks > 0 else _Phase.MEASURING
    _tick_scale = 1.0


## Advances the input clock by delta real seconds: samples and sends the input of each tick
## (at most 4 per frame).
func service(delta: float) -> void:
    var client := _world._client
    if not started() or client.tick_rate == 0:
        return
    tick_phase += delta * client.tick_rate * _tick_scale
    var steps := 0
    while tick_phase >= 1.0:
        if steps == 4:
            tick_phase = 0.0 # a long frame: the clock feedback recovers the lead
            break
        steps += 1
        tick_phase -= 1.0
        if paused_ticks > 0:
            paused_ticks -= 1
            continue
        input_tick = Gs2SyncInt.u32(input_tick + 1)
        # A handler's script error stops that handler only; the tick's input is still recorded
        # and sent.
        _world.input_sampling.emit(input_tick)
        if _world._client == null:
            return # a handler detached the world
        _world._prediction.record_input(input_tick, input)
        var sent := not _owns_simulated_object() or client.send_input(input_tick, input, _view_lag())
        var now := Gs2NetworkWorld._now()
        if not sent and now >= _next_send_warning:
            _next_send_warning = now + 1.0
            push_warning("Input for tick %d was not sent (transport busy)" % input_tick)


## The (fractional) room tick of the remote objects on screen: server_tick moved back by the
## world's view_delay when it receives server timestamps.
func view_tick() -> float:
    var rate := _world._client.tick_rate if _world._client != null else 0
    var timed := not is_nan(clock_server_time) and _world.has_server_time()
    if not timed or rate == 0:
        return server_tick
    return server_tick + (_world.server_time() - _world.view_delay - clock_server_time) * rate


# input_tick - view_tick in 1/16 ticks, at most one second (the room clamps further).
func _view_lag() -> int:
    var lag := (input_tick - view_tick()) * 16.0
    return roundi(maxf(0.0, minf(lag, _world._client.tick_rate * 16.0)))


func _owns_simulated_object() -> bool:
    for o in _world._client.objects():
        if o.simulated_for_me():
            return true
    return false
