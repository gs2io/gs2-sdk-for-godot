# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# A request the room answers once (Unity's NetworkRequest): pending (status 0) until it
# completes, then completed is emitted once. Wait for it with await request.wait(), which
# returns at once when it is already done, or with on_completed. The world completes requests
# outside network callbacks, so their handlers may send. Gs2CommandRequest, Gs2SpawnRequest and
# Gs2ControlRequest add the outcome.
class_name Gs2NetworkRequest
extends RefCounted


## Raised once when the request completes, with the request.
signal completed(request: Gs2NetworkRequest)

## The request ID (0 when it was not sent, or for a control request).
var id: int:
    get: return _id
    set(_v): push_error("A request's ID is read-only")
## The outcome (the derived class's status enum); 0 while pending.
var status: int:
    get: return _status
    set(_v): push_error("A request's status is read-only")

var _id := 0
var _status := 0


func _init(request_id: int = 0) -> void:
    _id = request_id


## True once the request completed.
func is_done() -> bool:
    return _status != 0


## Unity's keepWaiting: true while pending.
func keep_waiting() -> bool:
    return _status == 0


## Runs callback(request) once the request completes, at once if it already has.
func on_completed(callback: Callable) -> void:
    if not callback.is_valid():
        push_error("on_completed needs a valid Callable")
        return
    if is_done():
        callback.call(self)
    else:
        completed.connect(callback, CONNECT_ONE_SHOT)


## Waits until the request completes (await request.wait()); returns this request, at once when
## it is already done.
func wait() -> Gs2NetworkRequest:
    if not is_done():
        await completed
    return self


# Completes the request once; false when it already was. The derived request sets its results
# before calling this.
func _finish(new_status: int) -> bool:
    if is_done():
        return false
    _status = new_status
    completed.emit(self)
    return true
