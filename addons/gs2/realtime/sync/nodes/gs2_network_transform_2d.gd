# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Synchronizes a Node2D's global position and rotation (Unity's NetworkTransform for 2D games):
# a child of the prefab's root next to its Gs2NetworkEntity, moving target (the root by
# default). See Gs2NetworkTransform for the roles (owner, remote, predicted).
#
# Fields: global_position.x / .y travel as PositionX / PositionY (slots 0 / 1 without a
# schema) and global_rotation as RotationZ (slot 5), in degrees normalized to 0..360 (fposmod).
# The Y axis is not flipped: values are Godot's (Y down), so rules see the screen's
# coordinates. The standard position precision is 0.01; prefer a schema with precision 1 or
# 0.1 for pixel units.
class_name Gs2NetworkTransform2D
extends Gs2NetworkTransform


## Synchronized position axes. Set before binding.
@export_flags("X", "Y") var position_axes := 3:
    set(value):
        position_axes = value & 3
## Synchronizes the rotation (RotationZ). Set before binding.
@export var sync_rotation := true


func _position_axes() -> int:
    return position_axes & 3


func _rotation_axes() -> int:
    return 4 if sync_rotation else 0


func _accepts(node: Node) -> bool:
    return node is Node2D


func _target_kind() -> String:
    return "Node2D"


# World space; outside the tree (an instance being spawned, before the world adds it) the
# node's own position and rotation, which become its world pose under the world's origin.
func _get_position(node: Node) -> Vector3:
    var body := node as Node2D
    var p: Vector2 = body.global_position if body.is_inside_tree() else body.position
    return Vector3(p.x, p.y, 0)


func _set_position(node: Node, position: Vector3) -> void:
    var body := node as Node2D
    if body.is_inside_tree():
        body.global_position = Vector2(position.x, position.y)
    else:
        body.position = Vector2(position.x, position.y)


func _get_euler(node: Node) -> Vector3:
    var body := node as Node2D
    return Vector3(0, 0, fposmod(rad_to_deg(body.global_rotation if body.is_inside_tree() else body.rotation), 360.0))


func _set_euler(node: Node, euler: Vector3) -> void:
    var body := node as Node2D
    if body.is_inside_tree():
        body.global_rotation = deg_to_rad(euler.z)
    else:
        body.rotation = deg_to_rad(euler.z)


func _spawn_pose(position: Variant, rotation: Variant) -> Variant:
    var p := Vector3.ZERO
    if position is Vector2:
        p = Vector3(position.x, position.y, 0)
    elif position is Vector3:
        p = position
    elif position != null:
        last_error = "A 2D spawn position is a Vector2"
        return null
    var degrees := 0.0
    if rotation is float or rotation is int:
        degrees = rad_to_deg(float(rotation))
    elif rotation != null:
        last_error = "A 2D spawn rotation is an angle in radians"
        return null
    return [p, Vector3(0, 0, degrees)]
