# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Ties a prefab instance to one object of the room (Unity's NetworkEntity): synchronized fields,
# RPCs, ownership and control. The Gs2NetworkWorld that instantiates the prefab binds and unbinds
# it.
#
# Layout (D1): the entity is a direct child of the prefab's root (as a MultiplayerSynchronizer),
# so the root stays any node type (CharacterBody3D, ...). It acts on target (its parent by
# default). Its scope is the subtree of its parent, without the subtree of another
# Gs2NetworkEntity nested in it (that one's parent and below); the entity finds in its scope:
#   RPC methods        net_rpc_<name> / net_rpc_public_<name> (see Gs2NetworkRpc)
#   _network_bind(entity) / _network_unbind(entity)
#                      Unity's INetworkBinding: called when the entity binds (a false return
#                      refuses the object; the node's last_error says why) and unbinds
#   _network_write(entity) / _network_read(entity, changed_fields)
#                      Unity's INetworkObservable: the writer (owner or lease holder) writes
#                      fields with set_int / set_float / set_bool right before each batched
#                      send; other clients read them when updates arrive (changed_fields is a
#                      slot mask, test it with has_changed)
#   _network_tick(entity)
#                      Unity's INetworkTick: each world update while bound
#
# Control: controlled_nodes are processed (process_mode INHERIT) only while this client has
# control and DISABLED otherwise (Unity's controlled behaviours). The entity is "active" (Unity's
# isActiveAndEnabled) while it is in the tree and not disabled by its own or an inherited
# process_mode (pausing does not count).
#
# Errors (D2): calls Unity throws from return false / 0 / null with last_error and push_error.
class_name Gs2NetworkEntity
extends Node


## Raised with the new has_control when it changes.
signal control_changed(controlled: bool)
## Raised with the room's result (a Gs2SyncTypes.CommandResult) for each lease request.
signal command_completed(result: int)
## Raised when the room confirms a new owner of a player or simulated object; is_mine and the
## controlled nodes are already updated.
signal ownership_changed(entity: Gs2NetworkEntity)
## Raised when a synchronized field changes (and for every field when the entity binds), with
## the field's name and value (int, bool, or float scaled by its precision); the room's state,
## as property bindings show it.
signal field_changed(field_name: String, value: Variant)

## Calls queued at most on an Instantiate the room has not confirmed.
const MAX_PENDING_RPCS = 256

enum _Phase { UNBOUND, PLACEHOLDER, BOUND }
const _NOT_BOUND = "Entity is not bound to a network object"

## The node the entity acts on (transforms, property bindings without a target).
@export var target: NodePath = NodePath("..")
## The schema of the object's fields; null means only the standard Position / Rotation fields.
## Refused while bound.
@export var schema: Gs2NetworkSchema:
    set(value):
        if _object != null:
            _misuse("Unbind before changing schema")
            return
        schema = value
## Fields shown on nodes when they change. Refused while bound.
@export var property_bindings: Array[Gs2NetworkPropertyBinding] = []:
    set(value):
        if _object != null:
            _misuse("Unbind before changing bindings")
            return
        property_bindings = value

@export_group("Control")
## Calls request_control when enabled (for a leased object: acquires its lease).
@export var acquire_on_enable := false
## Renews a held lease before it expires while control is requested.
@export var auto_renew := true
## Gameplay nodes processed only while this client has control (has_control). Network nodes are
## refused.
@export var controlled_nodes: Array[NodePath] = []

## The room's object this entity is bound to; null while unbound and before the room confirms
## an instantiate. Unity's Object.
var network_object: Gs2NetworkObject:
    get: return _object
    set(_v): _misuse("network_object is read-only")
## The world that created this instance (null while unbound).
var world: Gs2NetworkWorld:
    get: return _world
    set(_v): _misuse("world is read-only")
## The world's sync client (null while unbound).
var client: Gs2SyncClient:
    get: return _client
    set(_v): _misuse("client is read-only")
## True while this client controls the object and the controlled nodes are enabled.
var has_control: bool:
    get: return _has_control
    set(_v): _misuse("has_control is read-only")
## The room's result for the last answered lease request.
var last_result := 0
## Connection ID of the holder (owner, or the member holding the lease); 0 when free, for a
## server object, or while unbound. Unity's OwnerId.
var owner_id: int:
    get: return _object.owner_id if _object != null else 0
    set(_v): _misuse("owner_id is read-only")
## The bound object's mode (Gs2SyncTypes.ObjectMode); PLAYER while unbound.
var mode: int:
    get: return _object.mode if _object != null else Gs2SyncTypes.ObjectMode.PLAYER
    set(_v): _misuse("mode is read-only")
## Interest group (like PhotonView.Group): updates and calls of this object reach members
## subscribed to it; 0 reaches everyone.
var group: int:
    get: return _object.group if _object != null else 0
    set(_v): _misuse("group is read-only; call set_group")
## The room's answer to the instantiate that created this instance (null for instances the
## world created for the room's objects).
var spawn_request: Gs2SpawnRequest = null
## True while a confirmed placeholder binds: nodes keep the local pose (for transforms).
var binding_placeholder := false
## Why the last call failed, or "".
var last_error := ""
## For the world: the instance root it created (the prefab's root).
var instance_root: Node = null

var _object: Gs2NetworkObject = null
var _world: Gs2NetworkWorld = null
var _client: Gs2SyncClient = null
var _phase: int = _Phase.UNBOUND
var _has_control := false
var _control: _Control = _NoControl.new()
var _bindings: Array[Node] = []
var _ticks: Array[Node] = []
var _observables: Array[Node] = []
var _property_fields: Array[Gs2NetworkSchemaField] = []
# RPCs: [node, Gs2NetworkRpc.Method] by method ID, and by name (null when shared by several
# nodes: call those by ID). null until built.
var _rpc_by_id = null
var _rpc_by_name = null
var _rpc_error := ""
# Calls made on an Instantiate the room has not confirmed yet (no object ID to address): sent,
# in order, when it confirms. Each is [method, target byte, recipient, args].
var _pending_rpcs: Array = []
# destroying: destroy was taken, so no more RPCs; the despawn follows queued calls.
# despawn_sent: the client took the despawn; until then it is retried.
var _destroying := false
var _despawn_sent := false
var _deleting := false


func _notification(what: int) -> void:
    match what:
        NOTIFICATION_ENTER_TREE:
            _on_enable()
        NOTIFICATION_ENABLED:
            _on_enable.call_deferred()
        NOTIFICATION_EXIT_TREE:
            release_control()
        NOTIFICATION_DISABLED:
            release_control.call_deferred()
        NOTIFICATION_PREDELETE:
            _deleting = true
            unbind()


# Control follows the node's state at once (Unity's OnEnable / OnDisable).
func _on_enable() -> void:
    if _deleting:
        return
    if acquire_on_enable:
        request_control()
    else:
        _refresh_control()


## The node the entity acts on (target), or null.
func get_target() -> Node:
    return get_node_or_null(target)


## True while active: in the tree and not disabled by a process_mode (Unity's
## isActiveAndEnabled).
func is_active() -> bool:
    if not is_inside_tree():
        return false
    var node: Node = self
    while node != null:
        match node.process_mode:
            PROCESS_MODE_DISABLED:
                return false
            PROCESS_MODE_INHERIT:
                node = node.get_parent()
            _:
                return true
    return true


func _bound() -> bool:
    return _phase == _Phase.BOUND


# Bound, and this client holds the object (once the room's state is applied).
func _held_here() -> bool:
    return _bound() and _client.controls(_object.id)


# Bound, and this client sends the object's field values.
func _writable_here() -> bool:
    return _bound() and _client.can_write(_object.id)


# Bound to a leased object whose lease this client holds.
func _lease_held_here() -> bool:
    return _bound() and _client.room_ready and _object.lease_held_by_me()


# Bound to an object no member owns (leased or server): it takes no RPCs.
func _bound_to_shared() -> bool:
    return _bound() and not _object.kind().owned


## True when bound to an object of the prefab (false before the room confirms an instantiate).
func is_prefab(prefab: int) -> bool:
    return _bound() and _object.prefab == prefab


## True once bound to the room's object; fields can be read and written only then.
func is_spawned() -> bool:
    return _object != null


## True while a lease request waits for the room's answer.
func is_requesting() -> bool:
    return _control.is_requesting()


## True while this client holds the object: owns a player or simulated object, holds a leased
## object's lease, or made an instantiate the room has not confirmed yet. Server objects are
## never mine.
func is_mine() -> bool:
    return _phase == _Phase.PLACEHOLDER or (_bound() and _object.is_mine())


# The name messages use: the prefab instance's.
func _display_name() -> String:
    var parent := get_parent()
    return String(parent.name) if parent != null else String(name)


# ---- Synchronized fields ----

func _require_field(field_name: String, type: int) -> Gs2NetworkSchemaField:
    # Values exist only once the room confirms the object: an instantiated entity may send
    # RPCs before that, but its fields wait for is_spawned.
    if _object == null:
        if _phase == _Phase.PLACEHOLDER:
            _misuse("Field %s is not available yet: the room has not confirmed this instantiate (is_spawned is false); set fields once it has, e.g. in Gs2NetworkWorld.spawned" % field_name)
        else:
            _misuse("Field %s is not available: the entity is not bound to a network object" % field_name)
        return null
    var field := Gs2NetworkSchema.resolve(schema, field_name)
    if field == null:
        _misuse("No network field %s%s" % [field_name, (" in schema " + schema.display_name()) if schema != null else " (no schema: only the standard Position/Rotation fields)"])
        return null
    if field.type != type:
        _misuse("Network field %s is %s, not %s" % [field_name, Gs2NetworkSchemaField.type_name(field.type), Gs2NetworkSchemaField.type_name(type)])
        return null
    if not _object.has_field(field.slot):
        _misuse("Network field %s is not among the fields the room enabled for prefab %d" % [field_name, _object.prefab])
        return null
    return field


## True when the named field is among changed_fields (from _network_read); false for an unknown
## name.
func has_changed(field_name: String, changed_fields: int) -> bool:
    var field := Gs2NetworkSchema.resolve(schema, field_name)
    return field != null and (changed_fields & (1 << field.slot)) != 0


## Reads the value this client sees: the writer (owner or lease holder) reads its own latest
## set of the field, sent or not, so read-modify-write works between sends; other clients, and
## fields the writer has not set, read the room's latest state. 0 with last_error until the
## room confirms the object (is_spawned) or for an unknown field.
func get_int(field_name: String) -> int:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.INT)
    return _read(field) if field != null else 0


## Reads a BOOL field; see get_int.
func get_bool(field_name: String) -> bool:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.BOOL)
    return field != null and _read(field) != 0


## Reads a FLOAT field, scaled by its precision; see get_int.
func get_float(field_name: String) -> float:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.FLOAT)
    return _read(field) * field.precision if field != null else 0.0


## Reads the room's latest state of the field; for the writer it does not include its own
## unconfirmed writes.
func get_confirmed_int(field_name: String) -> int:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.INT)
    return _object.value(field.slot) if field != null else 0


## Reads the room's latest state of a BOOL field; see get_confirmed_int.
func get_confirmed_bool(field_name: String) -> bool:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.BOOL)
    return field != null and _object.value(field.slot) != 0


## Reads the room's latest state of a FLOAT field; see get_confirmed_int.
func get_confirmed_float(field_name: String) -> float:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.FLOAT)
    return _object.value(field.slot) * field.precision if field != null else 0.0


func _read(field: Gs2NetworkSchemaField) -> int:
    if _writable_here() and _object.has_written(field.slot):
        return _object.written_value(field.slot)
    return _object.value(field.slot)


## Writes a field for the owner or lease holder to send at the world's send rate. False with
## last_error until the room confirms the object (is_spawned), for an unknown field, or without
## write authority.
func set_int(field_name: String, value: int) -> bool:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.INT)
    return field != null and _set_slot(field.slot, value)


## Writes a BOOL field; see set_int.
func set_bool(field_name: String, value: bool) -> bool:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.BOOL)
    return field != null and _set_slot(field.slot, 1 if value else 0)


## Writes a FLOAT field, quantized to its precision; see set_int.
func set_float(field_name: String, value: float) -> bool:
    last_error = ""
    var field := _require_field(field_name, Gs2NetworkSchemaField.ValueType.FLOAT)
    if field == null:
        return false
    var wire := Gs2SyncCodec.quantize(value, field.precision)
    if Gs2SyncCodec.last_error != "":
        _misuse("Network field %s cannot hold %s" % [field_name, str(value)])
        return false
    return _set_slot(field.slot, wire)


func _set_slot(slot: int, value: int) -> bool:
    if _client.set_field(_object.id, slot, value):
        return true
    last_error = _client.last_error
    return false


func _bind_properties() -> bool:
    if schema != null and not schema.describes(_object):
        return _fail("Object does not match its network schema")
    _property_fields.clear()
    for binding in property_bindings:
        var field_name := binding.field if binding != null else ""
        var field := Gs2NetworkSchema.resolve(schema, field_name)
        if field == null:
            return _fail("Unknown network field: " + field_name)
        if not _object.has_field(field.slot):
            return _fail("Field is not enabled by the server: " + field_name)
        _property_fields.append(field)
    return true


func _publish_properties(changed_fields: int) -> void:
    for i in _property_fields.size():
        var field := _property_fields[i]
        if (changed_fields & (1 << field.slot)) == 0:
            continue
        var binding := property_bindings[i]
        var node := get_target() if binding.target.is_empty() else get_node_or_null(binding.target)
        binding.publish(node, Gs2NetworkPropertyBinding.value_of(field, _object.value(field.slot)))
    if not field_changed.has_connections():
        return
    for field in Gs2NetworkSchema.fields_of(schema):
        if (changed_fields & (1 << field.slot)) != 0 and _object.has_field(field.slot):
            field_changed.emit(field.field_name, Gs2NetworkPropertyBinding.value_of(field, _object.value(field.slot)))


func _on_changed(changed_fields: int) -> void:
    _publish_properties(changed_fields)
    _read_observables(changed_fields)


func _read_observables(changed_fields: int) -> void:
    if is_mine():
        return
    for node in _observables:
        if is_instance_valid(node) and node.has_method(&"_network_read"):
            node._network_read(self, changed_fields)


## For the world: right before each batched send.
func write_observables() -> void:
    if _observables.is_empty() or not _writable_here():
        return
    for node in _observables:
        if is_instance_valid(node) and node.has_method(&"_network_write"):
            node._network_write(self)


# ---- Scope ----

## The nodes of this entity's scope (see above), without the entity itself.
func scope_nodes() -> Array[Node]:
    var result: Array[Node] = []
    var root := get_parent()
    if root == null:
        return result
    _collect(root, root, result)
    return result


func _collect(node: Node, root: Node, result: Array[Node]) -> void:
    if node != root:
        for child in node.get_children():
            if child is Gs2NetworkEntity:
                return # a nested entity's: it has its own replicated identity
    if node != self:
        result.append(node)
    for child in node.get_children():
        if child == self or not (child is Gs2NetworkEntity):
            _collect(child, root, result)


# ---- Remote procedure calls ----

# Collects the RPC methods of this entity's scope; false with _rpc_error when they cannot bind.
func _build_rpc_table() -> bool:
    var by_id := {}
    var by_name := {}
    _rpc_error = ""
    for node in scope_nodes():
        var table := Gs2NetworkRpc.table_of(node.get_script())
        if table.error != "":
            _rpc_error = table.error
            return false
        for method in table.methods:
            if by_id.has(method.id):
                _rpc_error = "RPC method ID %d is declared by more than one node of %s" % [method.id, _display_name()]
                return false
            var handler := [node, method]
            by_id[method.id] = handler
            # A name shared by several nodes can only be called by ID.
            by_name[method.name] = null if by_name.has(method.name) else handler
    _rpc_by_id = by_id
    _rpc_by_name = by_name
    return true


# The [node, method] of an RPC ID; null when there is none, or with _rpc_error when the scope
# cannot bind.
func _find_rpc(method: int) -> Variant:
    if _rpc_by_id == null and not _build_rpc_table():
        return null
    var handler = _rpc_by_id.get(method)
    if handler != null and is_instance_valid(handler[0]):
        return handler
    # Nodes may be added after spawning; look again once before failing.
    if not _build_rpc_table():
        return null
    return _rpc_by_id.get(method)


## Lists the RPC methods of this entity's scope, sorted by ID: dictionaries {id, name, node,
## any_caller, parameters (type names)}. Works on instances outside the tree too.
func describe_rpcs() -> Array[Dictionary]:
    var result: Array[Dictionary] = []
    for node in scope_nodes():
        for method in Gs2NetworkRpc.table_of(node.get_script()).methods:
            result.append({id = method.id, name = method.name, node = node, any_caller = method.any_caller, parameters = method.arg_types.duplicate()})
    result.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a.id < b.id)
    return result


## The ID of the RPC method with this name (without its prefix); 0 with last_error when no node
## declares it, or several do (call it by ID then). Unity's RpcId.
func rpc_method_id(method_name: String) -> int:
    last_error = ""
    if (_rpc_by_name == null or not _rpc_by_name.has(method_name)) and not _build_rpc_table():
        _misuse(_rpc_error)
        return 0
    if not _rpc_by_name.has(method_name):
        _misuse("No RPC method named %s on %s" % [method_name, _display_name()])
        return 0
    var handler = _rpc_by_name[method_name]
    if handler == null:
        _misuse("Several nodes of %s declare RPC %s; call it by ID" % [_display_name(), method_name])
        return 0
    return handler[1].id


func _resolve_method(method: Variant) -> int:
    match typeof(method):
        TYPE_INT:
            return method
        TYPE_STRING, TYPE_STRING_NAME:
            return rpc_method_id(String(method))
    _misuse("An RPC method is a name or an ID")
    return 0


## Calls an RPC method (its name without the prefix, or its ID) on the receivers selected by
## rpc_target (Gs2SyncTypes.RpcTarget), in call order with every other command of this client.
## On an unconfirmed instantiate the call waits for the room's confirmation. Only player and
## simulated objects take RPCs. Returns false when the outbox (or the confirmation queue) is
## full or after destroy (last_error empty), or for a misuse (last_error set). Unity's Rpc.
func send_rpc(method: Variant, rpc_target: int, ...args: Array) -> bool:
    last_error = ""
    var id := _resolve_method(method)
    if id == 0:
        return false
    if not Gs2SyncCodec.is_unaddressed(rpc_target):
        _misuse("target is not an RpcTarget (one player goes with rpc_to)")
        return false
    return _send(id, rpc_target, 0, args)


## Calls the method on one room member only (by connection ID), like Photon's RPC(name,
## Player, ...). A member that already left receives nothing. Unity's RpcTo.
func rpc_to(method: Variant, connection_id: int, ...args: Array) -> bool:
    last_error = ""
    var id := _resolve_method(method)
    if id == 0:
        return false
    if connection_id <= 0 or connection_id > 0xFFFFFFFF:
        _misuse("A player is a connection ID (not 0)")
        return false
    return _send(id, Gs2SyncCodec.TARGET_PLAYER, connection_id, args)


func _send(method: int, rpc_target: int, recipient: int, args: Array) -> bool:
    if _phase == _Phase.UNBOUND:
        _misuse(_NOT_BOUND)
        return false
    if _bound_to_shared():
        _misuse("RPCs target player and simulated objects; shared objects change through Gs2SharedObject.interact or a lease")
        return false
    var handler = _find_rpc(method)
    if handler == null:
        _misuse(_rpc_error if _rpc_error != "" else "No RPC method %d on %s" % [method, _display_name()])
        return false
    # Who may call is decided by the room: with an object catalog, only the owner unless the
    # method is public; without one, anyone.
    var encoded = Gs2NetworkRpc.encode(handler[1], args)
    if encoded == null:
        _misuse(Gs2NetworkRpc.last_error)
        return false
    if _destroying:
        return false
    # Calls queued before the room confirmed this instantiate go first: a later call waits
    # behind any the outbox has not taken yet.
    if _bound() and _pending_rpcs.is_empty():
        if _client.send_rpc_target(_object.id, method, rpc_target, recipient, encoded, encoded.size()):
            return true
        last_error = _client.last_error
        return false
    if _pending_rpcs.size() >= MAX_PENDING_RPCS:
        return false
    _pending_rpcs.append([method, rpc_target, recipient, encoded])
    if _bound():
        _send_queued() # behind the waiting calls, in order
    return true


## For the world: decodes a received call now (its arguments borrow the received packet) and
## returns the call to run after the packet is applied; an invalid Callable for malformed or
## unknown calls, which are reported and dropped.
func prepare_rpc(method: int, sender: int, args: PackedByteArray, offset: int, count: int) -> Callable:
    var handler = _find_rpc(method)
    if handler == null:
        if _rpc_error != "":
            push_error(_rpc_error)
        else:
            push_warning("Dropped RPC %d: no RPC method %d on %s" % [method, method, _display_name()])
        return Callable()
    var info := Gs2NetworkRpcInfo.new(self, method, sender, _client != null and sender == _client.connection_id)
    var values = Gs2NetworkRpc.decode(handler[1], args, offset, count, info)
    if values == null:
        push_warning("Dropped RPC %d on %s: %s" % [method, _display_name(), Gs2NetworkRpc.last_error])
        return Callable()
    return _invoke_rpc.bind(handler, values)


func _invoke_rpc(handler: Array, values: Array) -> void:
    # The entity may have been despawned or detached by an earlier call in the same packet.
    if _object == null or not is_instance_valid(handler[0]):
        return
    handler[0].callv(handler[1].method_name, values)


# ---- Ownership, groups, despawn ----

func _require_owned_player_object(action: String) -> bool:
    if not _bound():
        _misuse(_NOT_BOUND)
        return false
    if not _object.owned_by_me():
        _misuse("Only the owner of a player or simulated object can %s; shared objects change through Gs2SharedObject.interact or a lease" % action)
        return false
    return true


## Hands a player object to another member, like PUN's TransferOwnership. Only the owner may,
## unless the prefab has "ownership":"takeover" in the object catalog. Takes effect when the
## room confirms (ownership_changed).
func transfer_ownership(connection_id: int) -> bool:
    last_error = ""
    if not _bound():
        _misuse(_NOT_BOUND)
        return false
    if not _object.kind().transferable:
        _misuse("Ownership transfers player objects; shared objects use leases, simulated objects stay with their owner")
        return false
    if connection_id <= 0:
        _misuse("Ownership transfers to a member (a connection ID, not 0)")
        return false
    if _client.transfer(_object.id, connection_id):
        return true
    last_error = _client.last_error
    return false


## Asks for ownership of a player object for this client, like PUN's RequestOwnership; see
## transfer_ownership.
func request_ownership() -> bool:
    return transfer_ownership(_client.connection_id if _client != null else 0)


func _on_owner_changed() -> void:
    _refresh_control()
    ownership_changed.emit(self)


## Moves the object to an interest group (see group). Only the owner of a player or simulated
## object may.
func set_group(new_group: int) -> bool:
    last_error = ""
    if not _require_owned_player_object("change its group"):
        return false
    if _client.set_group(_object.id, new_group):
        return true
    last_error = _client.last_error
    return false


## Despawns a player object owned by this connection, in call order with its RPCs (on an
## unconfirmed instantiate, once the room confirms it). Simulated objects are removed by the
## room rules (Room.despawn) or when the owner leaves, never by the owner. Returns false when
## the outbox refused the despawn (call again; last_error empty) or for a misuse.
func destroy() -> bool:
    last_error = ""
    if _phase != _Phase.PLACEHOLDER and not _require_owned_player_object("destroy it"):
        return false
    if _bound() and not _object.kind().holder_despawns: # a simulated object
        _misuse("Simulated objects are removed by the room rules (Room.despawn) or when their owner leaves")
        return false
    if _destroying:
        return not _bound() or _send_queued() # taken: sent, or sent again now
    if _bound() and _pending_rpcs.is_empty():
        if not _send_despawn():
            return false # not taken: call again
        _destroying = true
        return true
    # Before the confirmation, or behind calls still waiting: taken, and sent after them.
    _destroying = true
    if _bound():
        _send_queued()
    return true


# Sends the despawn once; false while the outbox refuses it.
func _send_despawn() -> bool:
    if not _despawn_sent:
        _despawn_sent = _client.destroy(_object.id)
    return _despawn_sent


# Sends what waits since before the room confirmed this instantiate, in order: the calls, then
# the despawn. It stops at the first one the outbox refuses, which is tried again (next update,
# or the next send_rpc / destroy); true once all are sent.
func _send_queued() -> bool:
    var sent := 0
    while sent < _pending_rpcs.size():
        var call: Array = _pending_rpcs[sent]
        if not _client.send_rpc_target(_object.id, call[0], call[1], call[2], call[3], call[3].size()):
            break
        sent += 1
    _pending_rpcs = _pending_rpcs.slice(sent)
    return _pending_rpcs.is_empty() and (not _destroying or _send_despawn())


# ---- Binding (the world calls these) ----

## For the world: an instantiate the room has not confirmed (owned locally, its calls queued).
func begin_placeholder() -> bool:
    if _phase != _Phase.UNBOUND:
        _misuse("Only an unbound entity becomes a placeholder")
        return false
    _phase = _Phase.PLACEHOLDER
    _refresh_control()
    return true


## For the world: binds the room's object; false with last_error when it cannot (the entity is
## unbound again then).
func bind(network_world: Gs2NetworkWorld, sync_client: Gs2SyncClient, state: Gs2NetworkObject) -> bool:
    last_error = ""
    if _phase == _Phase.BOUND:
        _misuse("%s is already bound to object %d" % [_display_name(), _object.id])
        return false
    # A confirmed placeholder goes straight to BOUND: its queued calls (and a queued destroy)
    # stay for _send_queued, and its control does not flicker off and on.
    var confirming := _phase == _Phase.PLACEHOLDER
    binding_placeholder = confirming
    _world = network_world
    _client = sync_client
    _object = state
    _phase = _Phase.BOUND
    _bindings.clear()
    _ticks.clear()
    _observables.clear()
    for node in scope_nodes():
        if node.has_method(&"_network_bind"):
            _bindings.append(node)
        if node.has_method(&"_network_tick"):
            _ticks.append(node)
        if node.has_method(&"_network_write") or node.has_method(&"_network_read"):
            _observables.append(node)
    var ok := _bind_properties()
    if ok:
        for node in _bindings:
            var accepted = node._network_bind(self)
            if typeof(accepted) == TYPE_BOOL and not accepted:
                var reason = node.get(&"last_error")
                ok = _fail(reason if typeof(reason) == TYPE_STRING and reason != "" else "%s refused the object" % node.name)
                break
    if ok:
        state.changed.connect(_on_changed)
        _on_changed(state.fields)
        _control = _Control.create(self, state)
        ok = _refresh_control()
    if ok and confirming and not _send_queued():
        push_warning("Calls or the despawn of %s wait: the outbox is full; they are sent on the next update" % _display_name())
    binding_placeholder = false
    if not ok:
        var reason := last_error
        unbind()
        last_error = reason
    return ok


## Detaches from the room's object: releases a held lease, drops queued calls, disables the
## controlled nodes and unbinds the _network_bind nodes.
func unbind() -> void:
    _control.detach()
    _control = _NoControl.new()
    if _object != null and _object.changed.is_connected(_on_changed):
        _object.changed.disconnect(_on_changed)
    _observables.clear()
    _property_fields.clear()
    _rpc_by_id = null
    _rpc_by_name = null
    _pending_rpcs.clear()
    _destroying = false
    _despawn_sent = false
    _client = null
    _object = null
    _world = null
    _phase = _Phase.UNBOUND
    if not _deleting:
        _refresh_control()
    var bound := _bindings.duplicate()
    _bindings.clear()
    _ticks.clear()
    for node in bound:
        if is_instance_valid(node) and node.has_method(&"_network_unbind"):
            node._network_unbind(self)


## For the world: each world update while attached, also for inactive entities (so a delayed
## grant can be released).
func service() -> void:
    # Calls or a despawn taken before the room confirmed this instantiate that the outbox
    # refused then.
    if _bound() and (not _pending_rpcs.is_empty() or _destroying):
        _send_queued()
    _service_control()
    for node in _ticks:
        if is_instance_valid(node):
            node._network_tick(self)


# ---- Control ----

# This client drives the object and wants to: a leased object only while the game requested
# control (request_control). Driving a simulated object means sending inputs, so its input
# nodes are enabled although the rules write its fields (can_write is false).
func _controlling() -> bool:
    return _held_here() and _control.wants()


func _refresh_control() -> bool:
    var next := is_active() and (_phase == _Phase.PLACEHOLDER or _controlling())
    for path in controlled_nodes:
        var node := get_node_or_null(path)
        if node == null:
            continue
        if node is Gs2NetworkEntity or node is Gs2NetworkWorld or node.has_method(&"_network_bind"):
            return _fail("Control only gameplay nodes, not network nodes")
        node.process_mode = PROCESS_MODE_INHERIT if next else PROCESS_MODE_DISABLED
    if next != _has_control:
        _has_control = next
        if next:
            _control.gained()
        control_changed.emit(next)
    return true


## Asks for the object (a leased object's lease, renewed while held with auto_renew). Safe
## from signals and receive callbacks: the request goes out on the next world update. The
## controlled nodes are enabled once this client has control (has_control, control_changed).
func request_control() -> void:
    _control.request()
    _refresh_control()


## request_control that can be waited for (await request.wait(), on_completed): SUCCEEDED once
## this client has control; REFUSED with the room's reason (LEASE_BUSY: another player holds it;
## FORBIDDEN: an object this client cannot control, such as a server object or another player's
## object); ABANDONED when the request is withdrawn (release_control, the entity disabled or
## unbound). Gs2SharedObject.acquire is the manual lease, without control nodes or renewal.
func acquire_control() -> Gs2ControlRequest:
    var request := Gs2ControlRequest.new()
    request_control()
    if _has_control:
        request.complete(Gs2SyncTypes.RequestStatus.SUCCEEDED, Gs2SyncTypes.CommandResult.SUCCESS)
    elif not _bound():
        request.complete(Gs2SyncTypes.RequestStatus.ABANDONED, 0)
    else:
        _control.await_control(request)
    return request


# Completes a request outside network callbacks (it may send).
func _settle(request: Gs2ControlRequest, status: int, result: int) -> void:
    if _world != null:
        # A lambda holds the request (a bound Callable would not keep it alive).
        _world.defer(func() -> void: request.complete(status, result))
    else:
        request.complete(status, result)


## Withdraws request_control: a held lease is given back on a later world update and waiting
## acquire_control requests complete as ABANDONED. Owned objects stay controlled.
func release_control() -> void:
    _control.release()
    if not _deleting:
        _refresh_control()


func _service_control() -> void:
    _refresh_control()
    if _bound() and _client.room_ready:
        _control.service()


static func _now() -> float:
    return Time.get_ticks_usec() / 1000000.0


# How this client comes to drive the bound object. Owned objects (player, simulated) are driven
# by their owner; a leased object by whoever holds its lease, which this client acquires, renews
# and releases as the game asks; server objects by nobody.
class _Control:
    extends RefCounted

    static func create(entity: Gs2NetworkEntity, state: Gs2NetworkObject) -> _Control:
        if state.kind().owned:
            return _OwnedControl.new(entity, state)
        if state.kind().leased:
            return _LeaseControl.new(entity, state)
        return _NoControl.new()

    # Wanted once held: an owned object always, a leased one while requested.
    func wants() -> bool:
        return false

    func is_requesting() -> bool:
        return false

    func request() -> void:
        pass

    # An acquire_control that this client does not have control for yet: only a lease can be
    # acquired; other objects refuse it.
    func await_control(waiting: Gs2ControlRequest) -> void:
        waiting.complete(Gs2SyncTypes.RequestStatus.REFUSED, Gs2SyncTypes.CommandResult.FORBIDDEN)

    # This client gained control (_refresh_control).
    func gained() -> void:
        pass

    func release() -> void:
        pass

    # Each world update while bound and the room's state is applied.
    func service() -> void:
        pass

    # Unbinding: let go of the object and its notifications.
    func detach() -> void:
        pass


class _NoControl:
    extends _Control


class _OwnedControl:
    extends _Control
    var entity: Gs2NetworkEntity
    var state: Gs2NetworkObject

    func _init(owner_entity: Gs2NetworkEntity, o: Gs2NetworkObject) -> void:
        entity = owner_entity
        state = o
        state.authority_changed.connect(entity._on_owner_changed)

    func wants() -> bool:
        return true

    func detach() -> void:
        if state.authority_changed.is_connected(entity._on_owner_changed):
            state.authority_changed.disconnect(entity._on_owner_changed)


class _LeaseControl:
    extends _Control
    # What the game wants of the lease (request_control / release_control).
    const NONE = 0
    const HOLD = 1 # acquire it, and renew it while held (auto_renew)
    const RELEASE = 2 # give it back

    var entity: Gs2NetworkEntity
    var state: Gs2NetworkObject
    # acquire_control requests waiting for control.
    var waiting: Array[Gs2ControlRequest] = []
    var intent := NONE
    var awaiting_result := false
    var lease_request := 0
    var renew_at := 0.0
    var retry_at := 0.0

    func _init(owner_entity: Gs2NetworkEntity, o: Gs2NetworkObject) -> void:
        entity = owner_entity
        state = o
        intent = HOLD if entity.acquire_on_enable and entity.is_active() else NONE
        state.authority_changed.connect(_on_holder_changed)
        state.command_completed.connect(_on_result)
        _schedule_renew()

    func wants() -> bool:
        return intent == HOLD

    func is_requesting() -> bool:
        return awaiting_result

    func request() -> void:
        intent = HOLD
        retry_at = 0.0

    func release() -> void:
        intent = RELEASE
        retry_at = 0.0
        _settle_all(Gs2SyncTypes.RequestStatus.ABANDONED, 0)

    func await_control(request: Gs2ControlRequest) -> void:
        waiting.append(request)

    func gained() -> void:
        _settle_all(Gs2SyncTypes.RequestStatus.SUCCEEDED, Gs2SyncTypes.CommandResult.SUCCESS)

    func _settle_all(status: int, result: int) -> void:
        var settled := waiting.duplicate()
        waiting.clear()
        for request in settled:
            entity._settle(request, status, result)

    func service() -> void:
        if not entity.is_active():
            intent = RELEASE # an inactive entity gives its lease back
            _settle_all(Gs2SyncTypes.RequestStatus.ABANDONED, 0)
        var now := Gs2NetworkEntity._now()
        if awaiting_result or now < retry_at:
            return
        var action := _next_action(entity._held_here(), now)
        if action == 0:
            return
        lease_request = entity._client.lease(state.id, action)
        retry_at = now + 0.25
        if lease_request != 0:
            awaiting_result = true
            if action == Gs2SyncTypes.LeaseAction.RELEASE:
                intent = NONE
            _schedule_renew()

    func detach() -> void:
        if entity._lease_held_here():
            entity._client.lease(state.id, Gs2SyncTypes.LeaseAction.RELEASE)
        if state.authority_changed.is_connected(_on_holder_changed):
            state.authority_changed.disconnect(_on_holder_changed)
        if state.command_completed.is_connected(_on_result):
            state.command_completed.disconnect(_on_result)
        _settle_all(Gs2SyncTypes.RequestStatus.ABANDONED, 0)

    # The lease request the intent calls for, given whether the lease is held; 0 for none.
    func _next_action(held: bool, now: float) -> int:
        var renew_due := entity.auto_renew and now >= renew_at
        if intent == RELEASE and held:
            return Gs2SyncTypes.LeaseAction.RELEASE
        if intent == HOLD and not held:
            return Gs2SyncTypes.LeaseAction.ACQUIRE
        if intent == HOLD and renew_due:
            return Gs2SyncTypes.LeaseAction.RENEW
        return 0

    func _schedule_renew() -> void:
        renew_at = Gs2NetworkEntity._now() + maxf(0.05, minf(2.0, state.lease_milliseconds / 3000.0))

    # The lease changed hands (acquired, released, expired or taken).
    func _on_holder_changed() -> void:
        var lost_it := entity._has_control and not state.is_mine()
        if lost_it and intent == HOLD:
            intent = NONE
        entity._refresh_control()
        _schedule_renew()

    func _on_result(request_id: int, result: int) -> void:
        if request_id != lease_request:
            return
        awaiting_result = false
        entity.last_result = result
        var accepted := result == Gs2SyncTypes.CommandResult.SUCCESS or result == Gs2SyncTypes.CommandResult.ALREADY_APPLIED
        if not accepted and intent == HOLD:
            intent = NONE
            _settle_all(Gs2SyncTypes.RequestStatus.REFUSED, result)
        _schedule_renew() # a renewal updates the remaining lease
        entity.command_completed.emit(result)


func _fail(message: String) -> bool:
    last_error = message
    return false


func _misuse(message: String) -> void:
    last_error = message
    push_error(message)
