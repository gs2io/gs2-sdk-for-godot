# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Details of a received RPC or room event (Unity's NetworkRpcInfo): declare a last parameter of
# this type on a net_rpc_* / net_event_* method to receive it.
class_name Gs2NetworkRpcInfo
extends RefCounted


## The entity the RPC was called on (null for room events).
var entity: Gs2NetworkEntity = null
## The RPC method ID or event code.
var method := 0
## The sender's connection ID, set by the server; clients cannot forge it.
var sender := 0
## True when this client sent it.
var is_local := false


func _init(called: Gs2NetworkEntity = null, method_id: int = 0, sender_id: int = 0, local: bool = false) -> void:
    entity = called
    method = method_id
    sender = sender_id
    is_local = local
