# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Imports the room schemas the realtime authoring compiler generates (godot/*.realtimeschema) as
# Gs2NetworkSchema resources, to assign to Gs2NetworkEntity.schema (Unity's
# NetworkSchemaImporter). Gs2NetworkSchema.from_json holds the logic.
@tool
extends EditorImportPlugin


func _get_importer_name() -> String:
    return "gs2.realtime.schema"


func _get_visible_name() -> String:
    return "GS2 Realtime Schema"


func _get_recognized_extensions() -> PackedStringArray:
    return PackedStringArray(["realtimeschema"])


func _get_save_extension() -> String:
    return "res"


func _get_resource_type() -> String:
    return "Resource"


func _get_priority() -> float:
    return 1.0


func _get_import_order() -> int:
    return 0


func _get_preset_count() -> int:
    return 1


func _get_preset_name(_preset_index: int) -> String:
    return "Default"


func _get_import_options(_path: String, _preset_index: int) -> Array[Dictionary]:
    return []


func _get_option_visibility(_path: String, _option_name: StringName, _options: Dictionary) -> bool:
    return true


func _import(source_file: String, save_path: String, _options: Dictionary, _platform_variants: Array[String], _gen_files: Array[String]) -> Error:
    var schema := Gs2NetworkSchema.load_json(source_file)
    if schema == null:
        push_error("%s: invalid realtime schema" % source_file)
        return ERR_PARSE_ERROR
    return ResourceSaver.save(schema, "%s.%s" % [save_path, _get_save_extension()])
