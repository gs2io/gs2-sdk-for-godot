# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Shows below a Gs2NetworkEntity its RPC methods with their IDs (what the object catalog lists),
# and below a Gs2NetworkPrefabCatalog its problems (repeated IDs, missing scenes or entities,
# schemas of other prefabs).
@tool
extends EditorInspectorPlugin


func _can_handle(object: Object) -> bool:
    return object is Gs2NetworkEntity or object is Gs2NetworkPrefabCatalog


func _parse_end(object: Object) -> void:
    var label := RichTextLabel.new()
    label.fit_content = true
    label.selection_enabled = true
    label.bbcode_enabled = false
    label.text = describe(object)
    add_custom_control(label)


## The text shown for an entity or a catalog.
static func describe(object: Object) -> String:
    if object is Gs2NetworkPrefabCatalog:
        var problems: Array[String] = (object as Gs2NetworkPrefabCatalog).problems()
        return "Catalog: no problems" if problems.is_empty() else "Catalog problems:\n- " + "\n- ".join(problems)
    var entity := object as Gs2NetworkEntity
    var lines: Array[String] = []
    for rpc in entity.describe_rpcs():
        lines.append("%d  %s(%s)%s" % [rpc.id, rpc.name, ", ".join(rpc.parameters), "  (any caller)" if rpc.any_caller else ""])
    return "RPC methods (ID  name): none" if lines.is_empty() else "RPC methods (ID  name):\n" + "\n".join(lines)
