# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# The player-object entries of the room's object catalog (the namespace's
# syncSetting.objectCatalog) from a prefab catalog, so field masks and RPC IDs never have to be
# copied by hand (Unity's NetworkCatalogExport). Prefabs the room rules define (shared objects,
# and prefabs whose schema says the rules define them) are left out: the room refuses a catalog
# that defines them again. Plain logic, used by the editor plugin and the tests.
class_name Gs2ObjectCatalogExport
extends RefCounted


## Why the last to_json failed ("" when it did not).
static var last_error := ""


## The catalog's JSON, or "" with last_error.
static func to_json(catalog: Gs2NetworkPrefabCatalog) -> String:
    last_error = ""
    if catalog == null:
        return _fail("No prefab catalog")
    var entries := {}
    for entry in catalog.prefabs:
        if entry == null or not entry.is_complete():
            return _fail("Catalog entry without a prefab or ID")
        var root := entry.scene.instantiate()
        if root == null:
            return _fail("Prefab %d does not instantiate" % entry.id)
        var json := _entry(root)
        root.free()
        if last_error != "":
            return ""
        if json != "":
            entries[entry.id] = json
    var ids := entries.keys()
    ids.sort()
    var parts: Array[String] = []
    for id in ids:
        parts.append("\"%d\":%s" % [id, entries[id]])
    return "{" + ",".join(parts) + "}"


# One prefab's entry ("" when the rules define it).
static func _entry(root: Node) -> String:
    var entity := Gs2NetworkPrefabEntry.entity_of(root)
    if _defined_by_rules(root, entity):
        return ""
    if entity == null:
        _fail(String(root.name) + " needs a Gs2NetworkEntity as a child of its root")
        return ""
    var fields := _fields(root, entity)
    if fields == 0:
        _fail(String(root.name) + " synchronizes no fields; add a Gs2NetworkTransform2D / 3D or assign a schema")
        return ""
    var owner_ids: Array[String] = []
    var public_ids: Array[String] = []
    for rpc in entity.describe_rpcs():
        (public_ids if rpc.any_caller else owner_ids).append(str(rpc.id))
    var json := "{\"fields\":%d,\"mode\":\"player\"" % fields
    if not owner_ids.is_empty():
        json += ",\"methods\":[" + ",".join(owner_ids) + "]"
    if not public_ids.is_empty():
        json += ",\"publicMethods\":[" + ",".join(public_ids) + "]"
    return json + "}"


static func _defined_by_rules(root: Node, entity: Gs2NetworkEntity) -> bool:
    for child in root.get_children():
        if child is Gs2SharedObject:
            return true
    return entity != null and entity.schema != null and entity.schema.rule_defined


# The schema's mask, or the standard fields the prefab's transform node synchronizes.
static func _fields(root: Node, entity: Gs2NetworkEntity) -> int:
    if entity.schema != null:
        var mask := entity.schema.validate()
        if mask < 0:
            _fail(String(root.name) + "'s schema is invalid: " + entity.schema.last_error)
            return 0
        return mask
    var mask := 0
    for child in root.get_children():
        if child.has_method("network_field_mask"):
            mask |= int(child.call("network_field_mask"))
    return mask


static func _fail(message: String) -> String:
    last_error = message
    return ""
