# Handwritten Realtime synchronization support. This file is intentionally not generated by SDK-GEN.
#
# Builds the project's GDScript room rules with the GS2 realtime authoring compiler
# (gs2-realtime-compiler, distributed apart from the addon). A project has one rule set (the
# project settings gs2/realtime/rules_directory, generated_directory and package_directory) or
# any number of them (gs2/realtime/rule_sets, which wins when not empty), each a directory with
# one rule script:
# its package to register with GS2-StateMachine (package.zip with main.gsl) goes outside
# res://, and its generated classes (schemas, input / action / error constants, the
# prediction) into the project, keeping the .uid of the files that stay so that scenes keep
# their references. class_name is global, so a set whose generated classes would reuse a name
# of another set's or of the project's other scripts is not written. Plain logic: the editor
# plugin runs build() on a thread and reports the result.
class_name Gs2RealtimeRulesBuild
extends RefCounted


## The editor setting holding the compiler's path (per machine).
const COMPILER_SETTING = "gs2/realtime/compiler_path"
## The project settings of a project with one rule set: the rules' directory (one .gd rule
## script), where its generated classes go, and where its package goes (outside res:// is best:
## it is not part of the game).
const RULES_SETTING = "gs2/realtime/rules_directory"
const GENERATED_SETTING = "gs2/realtime/generated_directory"
const PACKAGE_SETTING = "gs2/realtime/package_directory"
## The project setting listing several rule sets as {rules, generated, package} dictionaries.
## When it is not empty, the three settings above are not used.
const RULE_SETS_SETTING = "gs2/realtime/rule_sets"
const DEFAULT_RULES = "res://rules"
const DEFAULT_GENERATED = "res://generated/realtime"
const DEFAULT_PACKAGE = "res://../build/realtime"

## The files a build generates for the game.
const GENERATED_EXTENSIONS = ["gd", "realtimeschema"]


## What a build did: ok, the compiler's output, the errors with res:// positions
## ("res://rules/tick_room.gd:12:3: message"), the generated files it wrote or removed, and the
## packages of the sets it built.
class Result:
    extends RefCounted

    var ok := false
    var output := ""
    var errors: Array[String] = []
    var written: Array[String] = []
    var removed: Array[String] = []
    var packages: Array[String] = []


## A rule set: {rules, generated, package} (paths may be res://).
static func rule_set(rules: String, generated: String, package: String) -> Dictionary:
    return {rules = rules, generated = generated, package = package}


## The project's rule sets: those gs2/realtime/rule_sets lists, or else the one set of the
## rules / generated / package directory settings (with their defaults).
static func rule_sets() -> Array:
    var sets: Array = ProjectSettings.get_setting(RULE_SETS_SETTING, [])
    if not sets.is_empty():
        return sets
    return [rule_set(rules_directory(), generated_directory(), package_directory())]


## The one rule set's settings, with their defaults.
static func rules_directory() -> String:
    return ProjectSettings.get_setting(RULES_SETTING, DEFAULT_RULES)


static func generated_directory() -> String:
    return ProjectSettings.get_setting(GENERATED_SETTING, DEFAULT_GENERATED)


static func package_directory() -> String:
    return ProjectSettings.get_setting(PACKAGE_SETTING, DEFAULT_PACKAGE)


## Builds each rule set with compiler: its package into package (a directory the compiler
## owns) and its generated classes into generated. known: the project's global classes
## (ProjectSettings.get_global_class_list()), which the generated class names must not reuse
## (those already in a built set's generated directory are its own and get replaced). A set
## that fails or clashes is not written; the others are.
static func build(compiler: String, sets: Array, known: Array = []) -> Result:
    var result := Result.new()
    var executable := ProjectSettings.globalize_path(compiler)
    if executable == "" or not FileAccess.file_exists(executable):
        result.errors.append("Set the GS2 realtime compiler's path in Editor Settings (%s): %s" % [COMPILER_SETTING, compiler])
        return result
    if sets.is_empty():
        result.errors.append("No rule sets (%s)" % RULE_SETS_SETTING)
        return result
    prepare(executable)
    var built: Array[Dictionary] = []
    var targets := {}
    var outputs: Array[String] = []
    for entry in sets:
        var rule := _set_of(entry, result)
        if rule.is_empty():
            continue
        if targets.has(rule.target):
            result.errors.append("Two rule sets generate into %s (%s)" % [rule.generated, RULE_SETS_SETTING])
            continue
        targets[rule.target] = true
        if _compile(executable, rule, result, outputs):
            rule.classes = _classes_of(rule.from)
            built.append(rule)
    result.output = "\n".join(outputs)
    # The project's classes stay taken, except those in a built set's generated directory.
    var owned := {}
    for rule in built:
        owned[rule.target] = true
    var taken := {}
    for entry in known:
        var path := ProjectSettings.globalize_path(str(entry.get("path", ""))).simplify_path()
        if not owned.has(path.get_base_dir()):
            taken[str(entry.get("class", "")).to_lower()] = str(entry.get("path", ""))
    var claimed := {}
    var clean: Array[Dictionary] = []
    for rule in built:
        var clashes: Array[String] = []
        for name: String in rule.classes:
            var file: String = rule.generated.path_join(rule.classes[name])
            var key := name.to_lower()
            if taken.has(key):
                clashes.append("%s would declare class_name %s, which %s already declares (class_name is global, compared ignoring case); rename the enum or rule it comes from" % [file, name, taken[key]])
            elif claimed.has(key):
                clashes.append("%s would declare class_name %s, as %s does (class_name is global, compared ignoring case); rename the enum or rule it comes from in one of the rule sets" % [file, name, claimed[key]])
        for name: String in rule.classes:
            if not claimed.has(name.to_lower()):
                claimed[name.to_lower()] = rule.generated.path_join(rule.classes[name])
        if clashes.is_empty():
            clean.append(rule)
        else:
            result.errors.append_array(clashes)
    for rule in clean:
        if _sync(rule.from, rule.generated, result):
            result.packages.append(rule.output.path_join("package.zip"))
    result.ok = result.errors.is_empty()
    return result


## Makes a downloaded compiler runnable: the executable bit (lost by some ZIP tools) and, on
## macOS, the quarantine of downloaded files.
static func prepare(executable: String) -> void:
    if OS.get_name() == "Windows":
        return
    OS.execute("chmod", ["+x", executable])
    if OS.get_name() == "macOS":
        OS.execute("xattr", ["-d", "com.apple.quarantine", executable])


## The compiler's errors ("tick_room.gd(12,3): error GSL1001: message", relative to the rules'
## directory) with res:// positions, as the editor names script lines.
static func errors_of(text: String, rules: String) -> Array[String]:
    var errors: Array[String] = []
    var pattern := RegEx.create_from_string("^(.+?)\\((\\d+),(\\d+)\\): error \\w+: (.*)$")
    for line in text.split("\n"):
        var match := pattern.search(line.strip_edges())
        if match == null:
            if line.strip_edges() != "":
                errors.append(line.strip_edges())
            continue
        errors.append("%s:%s:%s: %s" % [rules.path_join(match.get_string(1)), match.get_string(2), match.get_string(3), match.get_string(4)])
    return errors


# A rule set's paths, checked: rules, generated, package as given, source / target / output
# as absolute paths and from (the compiler's generated files). Empty when unusable.
static func _set_of(entry: Variant, result: Result) -> Dictionary:
    if typeof(entry) != TYPE_DICTIONARY or str(entry.get("rules", "")) == "" or str(entry.get("generated", "")) == "" or str(entry.get("package", "")) == "":
        result.errors.append("A rule set needs rules, generated and package (%s): %s" % [RULE_SETS_SETTING, str(entry)])
        return {}
    var rule := {rules = str(entry.rules), generated = str(entry.generated), package = str(entry.package)}
    rule.source = ProjectSettings.globalize_path(rule.rules).simplify_path()
    rule.target = ProjectSettings.globalize_path(rule.generated).simplify_path()
    rule.output = ProjectSettings.globalize_path(rule.package).simplify_path()
    rule.from = rule.output.path_join("godot")
    if not DirAccess.dir_exists_absolute(rule.source):
        result.errors.append("The rules directory does not exist (%s): %s" % [RULE_SETS_SETTING, rule.rules])
        return {}
    return rule


static func _compile(executable: String, rule: Dictionary, result: Result, outputs: Array[String]) -> bool:
    var lines := []
    var code := OS.execute(executable, ["--build", rule.source, "--output", rule.output], lines, true)
    var text := "\n".join(lines).strip_edges()
    if text != "":
        outputs.append(text)
    if code == 0:
        return true
    var errors := errors_of(text, rule.rules)
    if errors.is_empty():
        errors.append("The compiler failed for %s (exit %d): %s" % [rule.rules, code, text])
    result.errors.append_array(errors)
    return false


# The class_name each generated script declares: name -> file.
static func _classes_of(from: String) -> Dictionary:
    var classes := {}
    var pattern := RegEx.create_from_string("(?m)^class_name\\s+(\\w+)")
    for file in DirAccess.get_files_at(from):
        if file.get_extension() != "gd":
            continue
        var match := pattern.search(FileAccess.get_file_as_string(from.path_join(file)))
        if match != null:
            classes[match.get_string(1)] = file
    return classes


# Copies the generated files into the project: changed files are rewritten, files no longer
# generated are removed with their .uid / .import, and every other .uid stays.
static func _sync(from: String, to: String, result: Result) -> bool:
    var target := ProjectSettings.globalize_path(to)
    if DirAccess.make_dir_recursive_absolute(target) != OK:
        result.errors.append("Cannot create " + to)
        return false
    var fresh := {}
    for file in DirAccess.get_files_at(from):
        if not GENERATED_EXTENSIONS.has(file.get_extension()):
            continue
        fresh[file] = true
        var text := FileAccess.get_file_as_string(from.path_join(file))
        var path := target.path_join(file)
        if FileAccess.file_exists(path) and FileAccess.get_file_as_string(path) == text:
            continue
        var out := FileAccess.open(path, FileAccess.WRITE)
        if out == null:
            result.errors.append("Cannot write " + to.path_join(file))
            return false
        out.store_string(text)
        out.close()
        result.written.append(to.path_join(file))
    for file in DirAccess.get_files_at(target):
        if GENERATED_EXTENSIONS.has(file.get_extension()) and not fresh.has(file):
            for stale in [file, file + ".uid", file + ".import"]:
                if FileAccess.file_exists(target.path_join(stale)):
                    DirAccess.remove_absolute(target.path_join(stale))
            result.removed.append(to.path_join(file))
    return true
