# Handwritten room rule authoring contract. This file is intentionally not generated by SDK-GEN.
#
# What a handler returns: where the rules continue (C#'s Step<TState, TResult, TError>).
# Handlers are named by the method itself (wait_for(on_tick, state)).
class_name Gs2Step
extends RefCounted


## Wait in a new task for the handler's event.
static func wait_for(_handler: Callable, _state: Gs2Record) -> Gs2Step:
    return Gs2Step.new()


## Continue at once with the handler, in the same event.
static func next(_handler: Callable, _state: Gs2Record) -> Gs2Step:
    return Gs2Step.new()


## Stay in the current task with a new state.
static func stay(_state: Gs2Record) -> Gs2Step:
    return Gs2Step.new()


## End the rules with a result (and optionally a last state).
static func end(_result: Gs2Record, _state: Gs2Record = null) -> Gs2Step:
    return Gs2Step.new()


## Refuse the event with a code of the rules' error enum; nothing it did is kept.
static func ignore(_code: int) -> Gs2Step:
    return Gs2Step.new()


## Also wait for another handler's event (only after wait_for).
func or_wait_for(_handler: Callable) -> Gs2Step:
    return self
