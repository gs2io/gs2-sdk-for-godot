# Handwritten room rule authoring contract. This file is intentionally not generated by SDK-GEN.
#
# Constants of room rules: standard field groups (RoomSync), standard field slots
# (RoomFields / StandardField) and the room's own command results (RoomResults).
class_name Gs2RoomSync
extends RefCounted


## Field masks of the standard groups.
const POSITION = 7
const ROTATION = 56
const TRANSFORM = POSITION | ROTATION

## The standard fields' slots.
const POSITION_X = 0
const POSITION_Y = 1
const POSITION_Z = 2
const ROTATION_X = 3
const ROTATION_Y = 4
const ROTATION_Z = 5

## A standard field of a schema (StandardField), for Gs2Room.set_standard / get_standard.
enum StandardField { POSITION_X, POSITION_Y, POSITION_Z, ROTATION_X, ROTATION_Y, ROTATION_Z }

## The room's own command results; the rules' own codes start at FIRST_RULES_CODE.
const MISSING_OBJECT = 1
const FORBIDDEN = 2
const LEASE_BUSY = 3
const STALE_EPOCH = 4
const INVALID_OPERATION = 5
const ALREADY_APPLIED = 6
const STALE_REQUEST = 7
const LIMIT_REACHED = 8
const METHOD_NOT_ALLOWED = 9
const FIRST_RULES_CODE = 100
