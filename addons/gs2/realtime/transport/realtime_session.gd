# Handwritten Realtime WebSocket transport. This file is intentionally not generated by SDK-GEN.
class_name Gs2RealtimeSession
extends RefCounted


signal message_received(data)
signal message_received_with_metadata(data, metadata)
signal join_player(player)
signal join_player_with_metadata(player, metadata)
signal leave_player(player)
signal leave_player_with_metadata(player, metadata)
signal update_profile_received(player)
signal update_profile_received_with_metadata(player, metadata)
signal error_received(error)
signal error_received_with_metadata(error, metadata)
signal general_error(error)
signal closed

const CONNECT_TIMEOUT_MSEC = 60 * 1000
const HELLO_TIMEOUT_MSEC = 30 * 1000

var connected = false
var my_connection_id = 0
var profile = PackedByteArray()

var _access_token = null
var _ip_address = null
var _port = 0
var _messenger = null
var _socket = null
var _pumping = false
var _dispatching = false
var _hello_done = false
var _hello_error = null
var _events: Array = []


func _init(
    access_token: String,
    ip_address: String,
    port: int,
    encryption_key: String,
    initial_profile: PackedByteArray = PackedByteArray()
):
    _access_token = access_token
    _ip_address = ip_address
    _port = port
    _messenger = Gs2RealtimeMessenger.new(encryption_key)
    profile = initial_profile


func connect_session() -> Gs2AsyncResult:
    if connected:
        return Gs2AsyncResult.new(true, null)
    _hello_done = false
    _hello_error = null
    _socket = WebSocketPeer.new()
    var connect_error = _socket.connect_to_url("ws://%s:%d/" % [_ip_address, _port])
    if connect_error != OK:
        _socket = null
        return Gs2AsyncResult.new(null, _transport_error("realtime.connect.failed"))
    var connect_deadline = Time.get_ticks_msec() + CONNECT_TIMEOUT_MSEC
    while (
        _socket != null
        and _socket.get_ready_state() == WebSocketPeer.STATE_CONNECTING
        and Time.get_ticks_msec() < connect_deadline
    ):
        _socket.poll()
        await Engine.get_main_loop().process_frame
    if _socket == null or _socket.get_ready_state() != WebSocketPeer.STATE_OPEN:
        _socket = null
        return Gs2AsyncResult.new(null, _transport_error("realtime.connect.failed"))
    _start_pump()
    var send_error = _send_container(
        Gs2RealtimeWireModels.HELLO_REQUEST,
        Gs2RealtimeWireModels.encode_hello_request(_access_token, profile)
    )
    if send_error != OK:
        await close()
        return Gs2AsyncResult.new(null, _transport_error("realtime.hello.send.failed"))
    var hello_deadline = Time.get_ticks_msec() + HELLO_TIMEOUT_MSEC
    while not _hello_done and Time.get_ticks_msec() < hello_deadline:
        await Engine.get_main_loop().process_frame
    if not _hello_done or _hello_error != null or not connected:
        var error = _hello_error
        if error == null:
            error = _transport_error("realtime.hello.timeout")
        await close()
        return Gs2AsyncResult.new(null, error)
    return Gs2AsyncResult.new(true, null)


func dispatch() -> void:
    if _dispatching:
        return
    _dispatching = true
    while _dispatching:
        if _events.is_empty():
            await Engine.get_main_loop().process_frame
            continue
        var event = _events.pop_front()
        _emit_event(event)


func update_profile(value: PackedByteArray) -> Gs2AsyncResult:
    if not connected:
        return Gs2AsyncResult.new(null, _transport_error("realtime.update_profile.disconnected"))
    var send_error = _send_container(
        Gs2RealtimeWireModels.UPDATE_PROFILE_REQUEST,
        Gs2RealtimeWireModels.encode_update_profile(value)
    )
    if send_error != OK:
        return Gs2AsyncResult.new(null, _transport_error("realtime.update_profile.failed"))
    profile = value
    return Gs2AsyncResult.new(true, null)


func send_message(value: PackedByteArray) -> Gs2AsyncResult:
    if not connected:
        return Gs2AsyncResult.new(null, _transport_error("realtime.send.disconnected"))
    var send_error = _send_container(
        Gs2RealtimeWireModels.BINARY_MESSAGE,
        Gs2RealtimeWireModels.encode_binary_message(value)
    )
    if send_error != OK:
        return Gs2AsyncResult.new(null, _transport_error("realtime.send.failed"))
    return Gs2AsyncResult.new(true, null)


func close() -> void:
    _dispatching = false
    if _socket == null:
        connected = false
        return
    _socket.close()
    var deadline = Time.get_ticks_msec() + 30 * 1000
    while (
        _socket != null
        and _socket.get_ready_state() != WebSocketPeer.STATE_CLOSED
        and Time.get_ticks_msec() < deadline
    ):
        _socket.poll()
        await Engine.get_main_loop().process_frame
    _socket = null
    connected = false


func dispose() -> void:
    await close()


func _start_pump() -> void:
    if _pumping:
        return
    _pumping = true
    _pump()


func _pump() -> void:
    while _socket != null and _socket.get_ready_state() != WebSocketPeer.STATE_CLOSED:
        _socket.poll()
        while _socket != null and _socket.get_available_packet_count() > 0:
            _handle_packet(_socket.get_packet())
        await Engine.get_main_loop().process_frame
    var was_connected = connected
    connected = false
    _pumping = false
    if was_connected:
        _events.append({"type": "closed"})


func _send_container(message_type: int, payload: PackedByteArray) -> Error:
    if _socket == null or _socket.get_ready_state() != WebSocketPeer.STATE_OPEN:
        return ERR_CONNECTION_ERROR
    return _socket.send(
        _messenger.pack(message_type, payload), WebSocketPeer.WRITE_MODE_BINARY
    )


func _handle_packet(packet: PackedByteArray) -> void:
    var container = _messenger.unpack(packet)
    if container == null:
        _events.append({"type": "general_error", "value": _transport_error("realtime.invalid_packet")})
        return
    var metadata = Gs2RealtimeMessageMetadata.new()
    metadata.sequence_number = container.sequence_number
    metadata.life_time_milli_seconds = container.life_time_milli_seconds
    match container.message_type:
        Gs2RealtimeWireModels.HELLO_RESULT:
            var hello = Gs2RealtimeWireModels.decode_hello_result(container.payload)
            my_connection_id = hello.my_profile.connection_id
            for player in hello.players:
                _events.append({"type": "join", "value": player, "metadata": metadata})
            connected = true
            _hello_done = true
        Gs2RealtimeWireModels.JOIN_NOTIFICATION:
            _events.append({
                "type": "join",
                "value": Gs2RealtimeWireModels.decode_player_notification(container.payload),
                "metadata": metadata,
            })
        Gs2RealtimeWireModels.LEAVE_NOTIFICATION:
            _events.append({
                "type": "leave",
                "value": Gs2RealtimeWireModels.decode_player_notification(container.payload),
                "metadata": metadata,
            })
        Gs2RealtimeWireModels.UPDATE_PROFILE_NOTIFICATION:
            _events.append({
                "type": "update_profile",
                "value": Gs2RealtimeWireModels.decode_player_notification(container.payload),
                "metadata": metadata,
            })
        Gs2RealtimeWireModels.BINARY_MESSAGE:
            _handle_binary_message(
                Gs2RealtimeWireModels.decode_binary_message(container.payload), metadata
            )
        Gs2RealtimeWireModels.ERROR:
            var error = Gs2RealtimeWireModels.decode_error(container.payload)
            _events.append({"type": "error", "value": error, "metadata": metadata})
            if not _hello_done:
                _hello_error = _transport_error(error.message, error.status_code)
                _hello_done = true


func _handle_binary_message(data: PackedByteArray, metadata: Gs2RealtimeMessageMetadata) -> void:
    _events.append({"type": "message", "value": data, "metadata": metadata})


func _emit_event(event: Dictionary) -> void:
    match event.type:
        "message":
            message_received.emit(event.value)
            message_received_with_metadata.emit(event.value, event.metadata)
        "join":
            join_player.emit(event.value)
            join_player_with_metadata.emit(event.value, event.metadata)
        "leave":
            leave_player.emit(event.value)
            leave_player_with_metadata.emit(event.value, event.metadata)
        "update_profile":
            update_profile_received.emit(event.value)
            update_profile_received_with_metadata.emit(event.value, event.metadata)
        "error":
            error_received.emit(event.value)
            error_received_with_metadata.emit(event.value, event.metadata)
        "general_error":
            general_error.emit(event.value)
        "closed":
            closed.emit()


func _transport_error(message, status_code: int = 0):
    return Gs2Exception.extract_error(str(message), status_code)
