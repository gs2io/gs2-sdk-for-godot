# Handwritten Realtime wire messenger. This file is intentionally not generated by SDK-GEN.
class_name Gs2RealtimeMessenger
extends RefCounted


## An upper bound on what pack adds to a payload (message type, Any wrapper, HMAC and their
## length prefixes) plus the WebSocket frame header, for Gs2RealtimeSession.can_send.
const OVERHEAD_BYTES = 128

var _key = PackedByteArray()


func _init(encryption_key: String):
    _key = encryption_key.to_ascii_buffer()


func pack(message_type: int, payload: PackedByteArray) -> PackedByteArray:
    var any = Gs2RealtimeProtobuf.concat([
        Gs2RealtimeProtobuf.field_string(1, "type.googleapis.com"),
        Gs2RealtimeProtobuf.field_bytes(2, payload),
    ])
    return Gs2RealtimeProtobuf.concat([
        Gs2RealtimeProtobuf.field_varint(1, message_type),
        Gs2RealtimeProtobuf.field_bytes(2, any),
        Gs2RealtimeProtobuf.field_bytes(3, _hmac(payload)),
    ])


func unpack(data: PackedByteArray):
    var fields = Gs2RealtimeProtobuf.decode_fields(data)
    if not fields.has(2):
        return null
    var any_fields = Gs2RealtimeProtobuf.decode_fields(
        Gs2RealtimeProtobuf.first_bytes(fields, 2)
    )
    var payload = Gs2RealtimeProtobuf.first_bytes(any_fields, 2)
    var signature = Gs2RealtimeProtobuf.first_bytes(fields, 3)
    if not signature.is_empty() and not _constant_time_equal(signature, _hmac(payload)):
        return null
    return {
        "message_type": Gs2RealtimeProtobuf.first_varint(fields, 1),
        "payload": payload,
        "sequence_number": Gs2RealtimeProtobuf.first_varint(fields, 4),
        "life_time_milli_seconds": Gs2RealtimeProtobuf.first_varint(fields, 5),
    }


func _hmac(data: PackedByteArray) -> PackedByteArray:
    var context = HMACContext.new()
    if context.start(HashingContext.HASH_SHA256, _key) != OK:
        return PackedByteArray()
    # HMACContext.update refuses empty input; the HMAC of an empty message is just finish().
    if not data.is_empty() and context.update(data) != OK:
        return PackedByteArray()
    return context.finish()


func _constant_time_equal(left: PackedByteArray, right: PackedByteArray) -> bool:
    if left.size() != right.size():
        return false
    var difference = 0
    for index in range(left.size()):
        difference |= left[index] ^ right[index]
    return difference == 0
