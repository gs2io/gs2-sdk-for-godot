# Handwritten Realtime clock utility. This file is intentionally not generated by SDK-GEN.
class_name Gs2DateTime
extends RefCounted


var _epoch_milliseconds = 0
var _offset_milliseconds = 0

var current_milliseconds:
    get:
        return _epoch_milliseconds + Time.get_ticks_msec()

var offset_milliseconds:
    get:
        return _offset_milliseconds
    set(value):
        _epoch_milliseconds = _epoch_milliseconds - _offset_milliseconds + value
        _offset_milliseconds = value


func _init(milliseconds_from_unix_epoch: int):
    _epoch_milliseconds = milliseconds_from_unix_epoch - Time.get_ticks_msec()


static func from_milliseconds(milliseconds_from_unix_epoch: int):
    return load("res://addons/gs2/realtime/transport/gs2_date_time.gd").new(
        milliseconds_from_unix_epoch
    )


static func from_seconds(seconds_from_unix_epoch: int):
    return load("res://addons/gs2/realtime/transport/gs2_date_time.gd").new(
        seconds_from_unix_epoch * 1000
    )
