# Handwritten Realtime UDP side channel. This file is intentionally not generated by SDK-GEN.
#
# The UDP side channel of a synchronized room, for the room's periodic state updates, which
# may be lost or reordered (Unity's RealtimeUdpChannel). Create it after the session connects:
# it registers with the session's udp_secret. Web exports have no UDP and keep everything on
# WebSocket.
#
# Call poll every frame. Use try_send (for example as the sync client's unreliable sender)
# only while is_active().
class_name Gs2RealtimeUdpChannel
extends RefCounted


## Keepalive interval once the room answered, registration retry interval before that, and
## how long after the last datagram the channel counts as active (seconds). The room drops a
## registration after 15 s of silence; these stay well inside it.
const KEEP_ALIVE_SECONDS = 2.0
const RETRY_SECONDS = 0.5
const ACTIVE_SECONDS = 10.0

## Why the channel cannot be used (empty when it can).
var last_error := ""

var _udp: PacketPeerUDP = null
var _messenger: Gs2RealtimeMessenger = null
var _connection_id := 0
var _secret := 0
var _packet_number := 0
var _last_sequence := 0
var _has_sequence := false
var _acknowledged := false
var _last_sent := -INF
var _last_heard := -INF


## Whether this platform has UDP (not on the Web).
static func is_supported() -> bool:
    return not OS.has_feature("web")


## A channel to the session's room. Check is_valid(): a room without UDP (udp_secret 0), a
## session that is not connected or a Web export give an unusable channel.
static func for_session(session: Gs2RealtimeSession) -> Gs2RealtimeUdpChannel:
    return Gs2RealtimeUdpChannel.new(
        session.ip_address,
        session.port,
        session.my_connection_id,
        session.udp_secret,
        session.encryption_key
    )


func _init(host: String, port: int, connection_id: int, secret: int, encryption_key: String):
    if not is_supported():
        last_error = "UDP is not available on this platform"
        return
    if connection_id == 0 or secret == 0:
        last_error = "The room offers no UDP side channel (connect first; a zero secret means WebSocket only)"
        return
    _connection_id = connection_id
    _secret = secret
    _messenger = Gs2RealtimeMessenger.new(encryption_key)
    _udp = PacketPeerUDP.new()
    var error = _udp.connect_to_host(host, port)
    if error != OK:
        last_error = "Cannot open UDP to %s:%d (%s)" % [host, port, error_string(error)]
        _udp = null


## Whether the channel was created (is_active may still be false).
func is_valid() -> bool:
    return _udp != null


## True when the room answered within ACTIVE_SECONDS, so datagrams get through both ways.
func is_active() -> bool:
    return _udp != null and _acknowledged and _now() - _last_heard < ACTIVE_SECONDS


## Sends the first count bytes of data (all of it when count is negative) as one datagram.
## Returns false, without sending, when not active or the socket refused it.
func try_send(data: PackedByteArray, count: int = -1) -> bool:
    if not is_active():
        return false
    return _send(data if count < 0 or count >= data.size() else data.slice(0, count)) == OK


## Sends registration or keepalive datagrams when due and calls received(payload:
## PackedByteArray, life_time_milli_seconds: int) for each newly received state update.
## Datagrams older than the latest one received are dropped. Call every frame.
func poll(received: Callable) -> void:
    if _udp == null:
        return
    var now = _now()
    if now - _last_sent >= (KEEP_ALIVE_SECONDS if _acknowledged else RETRY_SECONDS):
        _send(PackedByteArray())
    while _udp.get_available_packet_count() > 0:
        var bytes = _udp.get_packet()
        if _udp.get_packet_error() != OK:
            # ICMP unreachable or similar: the channel stays inactive and WebSocket carries
            # everything.
            continue
        var datagram = Gs2RealtimeWireModels.decode_rudp_receive(bytes)
        if datagram == null:
            continue
        _acknowledged = true
        _last_heard = _now()
        if not datagram.has_container:
            continue
        var container = _messenger.unpack(datagram.container)
        if container == null or container.message_type != Gs2RealtimeWireModels.BINARY_MESSAGE:
            continue
        # Older datagrams arriving late would move state backwards.
        var sequence: int = container.sequence_number
        if _has_sequence and _serial_diff(sequence, _last_sequence) <= 0:
            continue
        _last_sequence = sequence
        _has_sequence = true
        received.call(
            Gs2RealtimeWireModels.decode_binary_message(container.payload),
            container.life_time_milli_seconds
        )


## Closes the socket.
func close() -> void:
    if _udp != null:
        _udp.close()
        _udp = null


func _send(data: PackedByteArray) -> Error:
    _packet_number = (_packet_number + 1) & 0xFFFFFFFF
    var container = _messenger.pack(
        Gs2RealtimeWireModels.BINARY_MESSAGE, Gs2RealtimeWireModels.encode_binary_message(data)
    )
    var error = _udp.put_packet(
        Gs2RealtimeWireModels.encode_rudp_send(_connection_id, _secret, _packet_number, container)
    )
    if error == OK:
        _last_sent = _now()
    return error


# (int)(a - b) of two uint32 serial numbers.
static func _serial_diff(a: int, b: int) -> int:
    var difference = (a - b) & 0xFFFFFFFF
    return difference - 0x100000000 if difference >= 0x80000000 else difference


func _now() -> float:
    return Time.get_ticks_usec() / 1000000.0
